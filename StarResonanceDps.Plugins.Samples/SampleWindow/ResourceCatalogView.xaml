<UserControl x:Class="SampleWindow.ResourceCatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,20,0,8" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="BrushSample" TargetType="{x:Type Border}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        </Style>

        <Style x:Key="IconSample" TargetType="{x:Type Border}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
        </Style>
    </UserControl.Resources>

    <!-- Every key used here is listed in PluginResourceKeys. Use DynamicResource for brushes so that the plugin follows the app's theme. -->
    <ScrollViewer Style="{StaticResource ScrollViewer.WidgetList}" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,0,24,24"
                    TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
                    TextElement.FontFamily="{StaticResource Font.ProjectDefault}">

            <TextBlock Style="{StaticResource SectionTitle}" Text="Brushes" />
            <WrapPanel>
                <Border Style="{StaticResource BrushSample}" Background="{DynamicResource Brush.WindowSurface}"><TextBlock Margin="8" Text="Brush.WindowSurface" /></Border>
                <Border Style="{StaticResource BrushSample}" Background="{DynamicResource Brush.PanelBackground}"><TextBlock Margin="8" Text="Brush.PanelBackground" /></Border>
                <Border Style="{StaticResource BrushSample}" Background="{DynamicResource Brush.Border}"><TextBlock Margin="8" Text="Brush.Border" /></Border>
                <Border Style="{StaticResource BrushSample}" Background="{DynamicResource Brush.BorderSoft}"><TextBlock Margin="8" Text="Brush.BorderSoft" /></Border>
                <Border Style="{StaticResource BrushSample}" Background="{DynamicResource Brush.ControlBackground}"><TextBlock Margin="8" Text="Brush.ControlBackground" /></Border>
                <Border Style="{StaticResource BrushSample}" Background="{DynamicResource Brush.ControlActiveBackground}"><TextBlock Margin="8" Text="Brush.ControlActiveBackground" /></Border>
                <Border Style="{StaticResource BrushSample}" Background="{DynamicResource Brush.InputBackground}"><TextBlock Margin="8" Text="Brush.InputBackground" /></Border>
                <Border Style="{StaticResource BrushSample}" Background="{DynamicResource Brush.InputHoverBackground}"><TextBlock Margin="8" Text="Brush.InputHoverBackground" /></Border>
                <Border Style="{StaticResource BrushSample}"><TextBlock Margin="8" Foreground="{DynamicResource Brush.TextPrimary}" Text="Brush.TextPrimary" /></Border>
                <Border Style="{StaticResource BrushSample}"><TextBlock Margin="8" Foreground="{DynamicResource Brush.TextSecondary}" Text="Brush.TextSecondary" /></Border>
                <Border Style="{StaticResource BrushSample}"><TextBlock Margin="8" Foreground="{DynamicResource Brush.TextMuted}" Text="Brush.TextMuted" /></Border>
                <Border Style="{StaticResource BrushSample}"><TextBlock Margin="8" Foreground="{DynamicResource Brush.Success}" Text="Brush.Success" /></Border>
            </WrapPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Text" />
            <Border Padding="12" Background="#B0000000">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.WidgetWindow}" Text="Text.WidgetWindow" />
                    <TextBlock Style="{StaticResource Text.WidgetWindowSubtitle}" Text="Text.WidgetWindowSubtitle" />
                    <TextBlock Foreground="White" Effect="{StaticResource Effect.WidgetWindowTextShadow}" Text="Effect.WidgetWindowTextShadow" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Buttons and links" />
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Text}" Width="120" Content="Button.Text" />
                <Button Style="{StaticResource Button.Icon}">
                    <Path Style="{StaticResource Icon.Stroke}" Data="{DynamicResource Icon.Add}" />
                </Button>
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center">
                    <Hyperlink Style="{StaticResource Hyperlink.Base}">Hyperlink.Base</Hyperlink>
                </TextBlock>
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center">
                    <Hyperlink Style="{StaticResource Hyperlink.Inline}">Hyperlink.Inline</Hyperlink>
                </TextBlock>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Inputs" />
            <StackPanel>
                <TextBox Style="{StaticResource Input.SearchBox}" Width="280" HorizontalAlignment="Left" Text="Input.SearchBox" />
                <TextBox Style="{StaticResource Input.PathBox}" Width="280" Margin="0,8,0,0" HorizontalAlignment="Left" Tag="Input.PathBox (Tag is the hint)" />
                <TextBox Style="{StaticResource Input.MultilineTextBox}" Width="280" Height="72" Margin="0,8,0,0" HorizontalAlignment="Left" Text="Input.MultilineTextBox" />
                <ComboBox Style="{StaticResource Input.SelectBox}" Width="280" Margin="0,8,0,0" HorizontalAlignment="Left" SelectedIndex="0">
                    <sys:String>Input.SelectBox</sys:String>
                    <sys:String>Second item</sys:String>
                </ComboBox>
                <ComboBox Style="{StaticResource Input.SettingsComboBox}"
                          ItemContainerStyle="{StaticResource Input.SettingsComboBoxItem}"
                          Width="280"
                          Margin="0,8,0,0"
                          HorizontalAlignment="Left"
                          SelectedIndex="0">
                    <sys:String>Input.SettingsComboBox</sys:String>
                    <sys:String>Second item</sys:String>
                </ComboBox>
                <ToggleButton Style="{StaticResource Input.Switch}" Margin="0,8,0,0" HorizontalAlignment="Left" IsChecked="True" />
                <Slider Style="{StaticResource Input.ValueSlider}" Width="280" Margin="0,8,0,0" HorizontalAlignment="Left" Minimum="0" Maximum="100" Value="40" />
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Panels" />
            <StackPanel>
                <ContentControl Style="{StaticResource Surface.RoundedOutline}"
                                Background="{DynamicResource Brush.WindowSurface}"
                                BorderBrush="{DynamicResource Brush.BorderSoft}">
                    <TextBlock Margin="12" Text="Surface.RoundedOutline" />
                </ContentControl>
                <ContentControl Style="{StaticResource Surface.RoundedButtonOutline}"
                                Margin="0,8,0,0"
                                Background="{DynamicResource Brush.WindowSurface}"
                                BorderBrush="{DynamicResource Brush.BorderSoft}">
                    <TextBlock Margin="12" Text="Surface.RoundedButtonOutline" />
                </ContentControl>
                <ContentControl Style="{StaticResource Panel.Root}" Margin="0,8,0,0">
                    <TextBlock Margin="12" Text="Panel.Root" />
                </ContentControl>
                <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,8,0,0">
                    <StackPanel>
                        <Border Style="{StaticResource Panel.SettingField}">
                            <TextBlock VerticalAlignment="Center" Text="Panel.SettingSection and Panel.SettingField" />
                        </Border>
                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                            <TextBlock VerticalAlignment="Center" Text="Panel.SettingFieldLast" />
                        </Border>
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Tooltips" />
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="ClickCountText"
                           Style="{StaticResource ToolTipOwner.Default}"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           Text="ToolTipOwner.Default"
                           MouseLeftButtonUp="ClickCountText_MouseLeftButtonUp">
                    <TextBlock.ToolTip>
                        <ToolTip Style="{StaticResource ToolTip.Info}" Content="Clicking closes this tooltip, because the click does something (it counts the clicks)." />
                    </TextBlock.ToolTip>
                </TextBlock>
                <TextBlock Style="{StaticResource ToolTipOwner.KeepsOnClick}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           Text="ToolTipOwner.KeepsOnClick">
                    <TextBlock.ToolTip>
                        <ToolTip Style="{StaticResource ToolTip.Info}" Content="Clicking keeps this tooltip open, because the click does nothing." />
                    </TextBlock.ToolTip>
                </TextBlock>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Sizes" />
            <StackPanel Orientation="Horizontal">
                <Border CornerRadius="{StaticResource Radius.Default}"
                        Padding="{StaticResource Padding.Card}"
                        Background="{DynamicResource Brush.WindowSurface}">
                    <TextBlock Margin="0,10" Text="Radius.Default, Padding.Card" />
                </Border>
                <Border CornerRadius="{StaticResource Radius.Button}"
                        Margin="8,0,0,0"
                        Padding="{StaticResource Padding.Card}"
                        Background="{DynamicResource Brush.WindowSurface}">
                    <TextBlock Margin="0,10" Text="Radius.Button" />
                </Border>
            </StackPanel>

            <TextBlock Style="{StaticResource SectionTitle}" Text="Icons" />
            <WrapPanel>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Stroke}" Data="{DynamicResource Icon.Search}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Stroke}" Data="{DynamicResource Icon.Add}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Stroke}" Data="{DynamicResource Icon.ChevronDown}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Stroke}" Data="{DynamicResource Icon.ChevronRight}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Stroke}" Data="{DynamicResource Icon.Copy}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Stroke}" Data="{DynamicResource Icon.Filter}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Stroke}" Data="{DynamicResource Icon.Sort}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Stroke}" Data="{DynamicResource Icon.EyeOff}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Stroke}" Data="{DynamicResource Icon.MoreVertical}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Fill}" Data="{DynamicResource Icon.Settings}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Fill}" Data="{DynamicResource Icon.Help}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Fill}" Data="{DynamicResource Icon.Wrench}" /></Border>
                <Border Style="{StaticResource IconSample}"><Path Style="{StaticResource Icon.Fill}" Data="{DynamicResource Icon.Sliders}" /></Border>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
