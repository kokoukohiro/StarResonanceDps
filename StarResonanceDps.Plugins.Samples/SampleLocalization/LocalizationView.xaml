<UserControl x:Class="SampleLocalization.LocalizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <StackPanel Margin="24,8,24,24"
                TextElement.Foreground="{DynamicResource Brush.TextPrimary}"
                TextElement.FontFamily="{StaticResource Font.ProjectDefault}">
        <!-- Texts follows the app's language: the indexer raises a change when the language changes. -->
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Texts[Greeting]}" />
        <TextBlock x:Name="SavedCountText" Margin="0,16,0,0" />
        <TextBlock x:Name="SettingsFolderText"
                   Margin="0,4,0,0"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   TextTrimming="CharacterEllipsis" />
        <StackPanel Margin="0,16,0,0" Orientation="Horizontal">
            <Button Style="{StaticResource Button.Text}"
                    Width="Auto"
                    Padding="16,0"
                    Click="CountUp_Click"
                    Content="{Binding Texts[CountUp]}" />
            <Button Style="{StaticResource Button.Text}"
                    Width="Auto"
                    Margin="8,0,0,0"
                    Padding="16,0"
                    Click="ShowMessage_Click"
                    Content="{Binding Texts[ShowMessage]}" />
        </StackPanel>
    </StackPanel>
</UserControl>
