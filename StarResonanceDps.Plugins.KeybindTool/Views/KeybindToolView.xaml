<UserControl x:Class="StarResonanceDps.Plugins.KeybindTool.Views.KeybindToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="Keybind.SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Keybind.FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Keybind.ActionField"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource Panel.SettingField}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEditable}" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLastInSection}" Value="True">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Keybind.InputModeOption" TargetType="{x:Type RadioButton}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <ContentControl x:Name="Root"
                                        Style="{StaticResource Surface.RoundedButtonOutline}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </ContentControl>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputHoverBackground}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputHoverBackground}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Keybind.IndependentCheckBoxField"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource Panel.SettingField}">
            <!-- The checkbox owns the complete field surface, including the horizontal padding. -->
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="Keybind.IndependentCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="RowRoot"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter Grid.Column="0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  RecognizesAccessKey="True"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"
                                                  TextElement.FontSize="{TemplateBinding FontSize}"
                                                  TextElement.FontWeight="{TemplateBinding FontWeight}" />

                                <Border x:Name="CheckBoxFrame"
                                        Grid.Column="1"
                                        Width="16"
                                        Height="16"
                                        Margin="16,0,0,0"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource Brush.BorderSoft}"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        SnapsToDevicePixels="True">
                                    <Path x:Name="CheckMark"
                                          Width="10"
                                          Height="8"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M 0 3 L 3 6 L 10 0"
                                          Stretch="Fill"
                                          Stroke="{DynamicResource Brush.TextPrimary}"
                                          StrokeEndLineCap="Square"
                                          StrokeStartLineCap="Square"
                                          StrokeThickness="1.8"
                                          Visibility="Collapsed" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowRoot" Property="Background" Value="{DynamicResource Brush.InputHoverBackground}" />
                                <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBoxFrame" Property="Background" Value="{DynamicResource Brush.ControlBackground}" />
                                <Setter TargetName="CheckBoxFrame" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="Keybind.InputVisual">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                <Image Width="18"
                       Height="18"
                       Stretch="Uniform"
                       SnapsToDevicePixels="True"
                       Source="{Binding IconUri}"
                       Visibility="{Binding HasIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <TextBlock Text="{Binding Text}"
                           FontFamily="Consolas"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Margin" Value="0" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasIcon}" Value="True">
                                    <Setter Property="Margin" Value="6,0,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasText}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Keybind.InputOptionVisual">
            <ContentControl Content="{Binding Visual}"
                            ContentTemplate="{StaticResource Keybind.InputVisual}" />
        </DataTemplate>

        <DataTemplate x:Key="Keybind.PresetOptionVisual">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center"
                        SnapsToDevicePixels="True">
                <ContentControl Content="{Binding ConfirmVisual}"
                                ContentTemplate="{StaticResource Keybind.InputVisual}" />

                <TextBlock Text="/"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextSecondary}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCancelVisual}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ContentControl Content="{Binding CancelVisual}"
                                ContentTemplate="{StaticResource Keybind.InputVisual}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="Keybind.ControllerActionList">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Keybind.ActionField}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding DisplayName}"
                                           Style="{StaticResource Keybind.FieldLabel}"
                                           Margin="0,0,16,0" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ComboBox Width="120"
                                              Style="{StaticResource Input.SettingsComboBox}"
                                              ItemsSource="{Binding HelperOptions}"
                                              ItemTemplate="{StaticResource Keybind.InputOptionVisual}"
                                              SelectedItem="{Binding SelectedHelper, Mode=TwoWay}"
                                              IsEnabled="{Binding IsEditable}"
                                              Visibility="{Binding UsesHelper, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Text="+"
                                               Margin="10,0"
                                               Style="{StaticResource Keybind.FieldLabel}"
                                               Visibility="{Binding UsesHelper, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ComboBox Width="120"
                                              Style="{StaticResource Input.SettingsComboBox}"
                                              ItemsSource="{Binding ButtonOptions}"
                                              ItemTemplate="{StaticResource Keybind.InputOptionVisual}"
                                              SelectedItem="{Binding SelectedButton, Mode=TwoWay}"
                                              IsEnabled="{Binding IsEditable}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="Keybind.KeyMouseActionList">
            <ItemsControl ItemsSource="{Binding}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Keybind.ActionField}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding DisplayName}"
                                           Style="{StaticResource Keybind.FieldLabel}"
                                           Margin="0,0,16,0" />

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LControlPrefixDisplay}"
                                               Style="{StaticResource Keybind.FieldLabel}"
                                               Margin="0,0,10,0"
                                               Visibility="{Binding UsesLControlPrefix, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <ComboBox Width="120"
                                              Style="{StaticResource Input.SettingsComboBox}"
                                              ItemsSource="{Binding KeyOptions}"
                                              ItemTemplate="{StaticResource Keybind.InputOptionVisual}"
                                              SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                                              IsEnabled="{Binding IsEditable}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8,1,0,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="ContentExternalScrollBarColumn" Width="16" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0" Style="{StaticResource Panel.Root}">
                <Grid Margin="16,16,8,16">
                    <ScrollViewer x:Name="ContentScrollViewer"
                                  Style="{StaticResource ScrollViewer.WidgetList}"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="ContentScrollViewer_ScrollChanged"
                                  SizeChanged="ContentScrollViewer_SizeChanged">
                        <StackPanel x:Name="ContentStackPanel"
                                    Margin="0,0,10,6"
                                    SizeChanged="ContentStackPanel_SizeChanged">
                    <TextBlock Text="{Binding Texts[Keybind.Section.SelectSaveFile]}"
                               Style="{StaticResource Keybind.SectionTitle}" />
                    <ContentControl Style="{StaticResource Panel.SettingSection}"
                                    Padding="20,12,20,12"
                                    Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Width="Auto"
                                          HorizontalAlignment="Stretch"
                                          Style="{StaticResource Input.SettingsComboBox}"
                                          ItemsSource="{Binding DetectedSaveFiles}"
                                          SelectedItem="{Binding SelectedDetectedSave, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName" />
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource Button.Text}"
                                        Command="{Binding RescanCommand}"
                                        Content="{Binding Texts[Keybind.Button.Rescan]}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Height="32"
                                         Style="{StaticResource Input.PathBox}"
                                         Text="{Binding SelectedSaveFilePath, Mode=OneWay}"
                                         IsReadOnly="True" />
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource Button.Text}"
                                        Command="{Binding SelectFileCommand}"
                                        Content="{Binding Texts[Keybind.Button.ManualSelect]}" />
                                <Button Grid.Column="2"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource Button.Text}"
                                        Command="{Binding OpenSelectedFileLocationCommand}"
                                        Content="{Binding Texts[Keybind.Button.OpenLocation]}" />
                            </Grid>

                            <!--
                                本体の TextBlock と同じく属性を直書きする。
                                **共有リソースのキーに依存しない** — 本体側で「未使用」と判定されて
                                消されると、プラグインが開けなくなる。
                            -->
                            <TextBlock Margin="0,12,0,0"
                                       MinWidth="600"
                                       HorizontalAlignment="Stretch"
                                       TextAlignment="Left"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="13"
                                       TextOptions.TextFormattingMode="Display"
                                       Text="{Binding Texts[Keybind.Hint.SaveFileLocation]}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ContentControl>

                    <TextBlock Text="{Binding Texts[Keybind.Section.Preset]}"
                               Style="{StaticResource Keybind.SectionTitle}" />
                    <ContentControl Style="{StaticResource Panel.SettingSection}"
                                    Margin="0,0,0,10">
                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding LayoutFilePath}"
                                           Style="{StaticResource Keybind.FieldLabel}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,16,0" />
                                <Button Grid.Column="1"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource Button.Text}"
                                        Command="{Binding LoadLayoutCommand}"
                                        Content="{Binding Texts[Keybind.Button.Load]}" />
                                <Button Grid.Column="2"
                                        Margin="12,0,0,0"
                                        Style="{StaticResource Button.Text}"
                                        Command="{Binding OpenLayoutFileLocationCommand}"
                                        Content="{Binding Texts[Keybind.Button.OpenLocation]}" />
                            </Grid>
                        </Border>
                    </ContentControl>

                    <TextBlock Text="{Binding Texts[Keybind.Section.InputDevice]}"
                               Style="{StaticResource Keybind.SectionTitle}" />
                    <ContentControl Style="{StaticResource Panel.SettingSection}"
                                    Padding="20,12,20,12"
                                    Margin="0,0,0,10">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0"
                                             Margin="0,0,6,0"
                                             Content="{Binding Texts[Keybind.InputDevice.Controller]}"
                                             GroupName="InputDevice"
                                             Style="{StaticResource Keybind.InputModeOption}"
                                             IsChecked="{Binding IsControllerMode, Mode=TwoWay}" />
                                <RadioButton Grid.Column="1"
                                             Margin="6,0,0,0"
                                             Content="{Binding Texts[Keybind.InputDevice.KeyMouse]}"
                                             GroupName="InputDevice"
                                             Style="{StaticResource Keybind.InputModeOption}"
                                             IsChecked="{Binding IsKeyMouseMode, Mode=TwoWay}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Texts[Keybind.Label.Controller]}"
                                               Style="{StaticResource Keybind.FieldLabel}" />
                                    <ComboBox Grid.Column="1"
                                              Width="Auto"
                                              Margin="6,0,0,0"
                                              HorizontalAlignment="Stretch"
                                              Style="{StaticResource Input.SettingsComboBox}"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding SelectedControllerType, Mode=TwoWay}">
                                        <ComboBoxItem Tag="PlayStation" Content="PlayStation" />
                                        <ComboBoxItem Tag="Nintendo" Content="Nintendo" />
                                        <ComboBoxItem Tag="Xbox" Content="Xbox" />
                                    </ComboBox>
                                </Grid>

                                <Grid Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Texts[Keybind.Label.KeyboardLayout]}"
                                               Style="{StaticResource Keybind.FieldLabel}" />
                                    <ComboBox Grid.Column="1"
                                              Width="Auto"
                                              Margin="6,0,0,0"
                                              HorizontalAlignment="Stretch"
                                              Style="{StaticResource Input.SettingsComboBox}"
                                              SelectedValuePath="Tag"
                                              SelectedValue="{Binding SelectedKeyboardLayout, Mode=TwoWay}">
                                        <ComboBoxItem Tag="English"
                                                      Content="{Binding Texts[Keybind.KeyboardLayout.English]}" />
                                        <ComboBoxItem Tag="Japanese"
                                                      Content="{Binding Texts[Keybind.KeyboardLayout.Japanese]}" />
                                    </ComboBox>
                                </Grid>
                            </Grid>
                        </StackPanel>
                    </ContentControl>

                    <TextBlock Text="{Binding Texts[Keybind.Section.HelperKeys]}"
                               Style="{StaticResource Keybind.SectionTitle}"
                               Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ContentControl Style="{StaticResource Panel.SettingSection}"
                                    Margin="0,0,0,10"
                                    Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Border Style="{StaticResource Panel.SettingField}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Texts[Keybind.Label.Helper1]}" Style="{StaticResource Keybind.FieldLabel}" />
                                    <ComboBox Grid.Column="1"
                                              Width="120"
                                              Style="{StaticResource Input.SettingsComboBox}"
                                              ItemsSource="{Binding HelperOptions}"
                                              ItemTemplate="{StaticResource Keybind.InputOptionVisual}"
                                              SelectedItem="{Binding SelectedHelper1, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Panel.SettingField}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Texts[Keybind.Label.Helper2]}" Style="{StaticResource Keybind.FieldLabel}" />
                                    <ComboBox Grid.Column="1"
                                              Width="120"
                                              Style="{StaticResource Input.SettingsComboBox}"
                                              ItemsSource="{Binding HelperOptions}"
                                              ItemTemplate="{StaticResource Keybind.InputOptionVisual}"
                                              SelectedItem="{Binding SelectedHelper2, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Panel.SettingFieldLast}"
                                    IsEnabled="{Binding IsPresetSupported}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Texts[Keybind.Label.ConfirmCancel]}" Style="{StaticResource Keybind.FieldLabel}" />
                                    <ComboBox Grid.Column="1"
                                              Width="120"
                                              Style="{StaticResource Input.SettingsComboBox}"
                                              ItemsSource="{Binding PresetOptions}"
                                              ItemTemplate="{StaticResource Keybind.PresetOptionVisual}"
                                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                              IsEnabled="{Binding IsPresetSupported}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ContentControl>

                    <TextBlock Text="{Binding Texts[Keybind.Section.MainKeySettings]}" Style="{StaticResource Keybind.SectionTitle}" />
                    <ContentControl Style="{StaticResource Panel.SettingSection}"
                                    Margin="0,0,0,10">
                        <Grid>
                            <ContentControl Content="{Binding ControllerMainActions}"
                                            ContentTemplate="{StaticResource Keybind.ControllerActionList}"
                                            Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ContentControl Content="{Binding KeyMouseMainActions}"
                                            ContentTemplate="{StaticResource Keybind.KeyMouseActionList}"
                                            Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </ContentControl>

                    <TextBlock Text="{Binding Texts[Keybind.Section.QuickWheelKeySettings]}" Style="{StaticResource Keybind.SectionTitle}" />
                    <ContentControl Style="{StaticResource Panel.SettingSection}"
                                    Margin="0,0,0,10">
                        <StackPanel>
                            <Border Style="{StaticResource Keybind.IndependentCheckBoxField}">
                                <Grid>
                                    <CheckBox Content="{Binding Texts[Keybind.CheckBox.QuickWheelIndependent]}"
                                              Style="{StaticResource Keybind.IndependentCheckBox}"
                                              IsChecked="{Binding ControllerQuickWheelIndependent, Mode=TwoWay}"
                                              Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox Content="{Binding Texts[Keybind.CheckBox.QuickWheelIndependent]}"
                                              Style="{StaticResource Keybind.IndependentCheckBox}"
                                              IsChecked="{Binding KeyMouseQuickWheelIndependent, Mode=TwoWay}"
                                              Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <Grid>
                                <ContentControl Content="{Binding ControllerQuickWheelActions}"
                                                ContentTemplate="{StaticResource Keybind.ControllerActionList}"
                                                Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ContentControl Content="{Binding KeyMouseQuickWheelActions}"
                                                ContentTemplate="{StaticResource Keybind.KeyMouseActionList}"
                                                Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>
                    </ContentControl>

                    <TextBlock Text="{Binding Texts[Keybind.Section.PhotoModeKeySettings]}" Style="{StaticResource Keybind.SectionTitle}" />
                    <ContentControl Style="{StaticResource Panel.SettingSection}"
                                    Margin="0,0,0,10">
                        <StackPanel>
                            <Border Style="{StaticResource Keybind.IndependentCheckBoxField}">
                                <Grid>
                                    <CheckBox Content="{Binding Texts[Keybind.CheckBox.PhotoIndependent]}"
                                              Style="{StaticResource Keybind.IndependentCheckBox}"
                                              IsChecked="{Binding ControllerPhotoModeIndependent, Mode=TwoWay}"
                                              Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox Content="{Binding Texts[Keybind.CheckBox.PhotoIndependent]}"
                                              Style="{StaticResource Keybind.IndependentCheckBox}"
                                              IsChecked="{Binding KeyMousePhotoModeIndependent, Mode=TwoWay}"
                                              Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <Grid>
                                <ContentControl Content="{Binding ControllerPhotoActions}"
                                                ContentTemplate="{StaticResource Keybind.ControllerActionList}"
                                                Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ContentControl Content="{Binding KeyMousePhotoActions}"
                                                ContentTemplate="{StaticResource Keybind.KeyMouseActionList}"
                                                Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>
                    </ContentControl>

                    <TextBlock Text="{Binding Texts[Keybind.Section.FishingModeKeySettings]}" Style="{StaticResource Keybind.SectionTitle}" />
                    <ContentControl Style="{StaticResource Panel.SettingSection}"
                                    Margin="0,0,0,12">
                        <StackPanel>
                            <Border Style="{StaticResource Keybind.IndependentCheckBoxField}">
                                <Grid>
                                    <CheckBox Content="{Binding Texts[Keybind.CheckBox.FishingIndependent]}"
                                              Style="{StaticResource Keybind.IndependentCheckBox}"
                                              IsChecked="{Binding ControllerFishingModeIndependent, Mode=TwoWay}"
                                              Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <CheckBox Content="{Binding Texts[Keybind.CheckBox.FishingIndependent]}"
                                              Style="{StaticResource Keybind.IndependentCheckBox}"
                                              IsChecked="{Binding KeyMouseFishingModeIndependent, Mode=TwoWay}"
                                              Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Border>
                            <Grid>
                                <ContentControl Content="{Binding ControllerFishingActions}"
                                                ContentTemplate="{StaticResource Keybind.ControllerActionList}"
                                                Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <ContentControl Content="{Binding KeyMouseFishingActions}"
                                                ContentTemplate="{StaticResource Keybind.KeyMouseActionList}"
                                                Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </Grid>
                        </StackPanel>
                    </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </ContentControl>

            <ScrollBar x:Name="ContentExternalScrollBar"
                       Grid.Column="1"
                       Margin="5,0,5,0"
                       Orientation="Vertical"
                       Style="{StaticResource ScrollBar.WidgetList}"
                       ValueChanged="ContentExternalScrollBar_ValueChanged" />
        </Grid>

        <Grid Grid.Row="1" Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       FontSize="13"
                       Text="{Binding StatusText}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       Margin="4,0,16,0" />
            <Button Grid.Column="1"
                    Style="{StaticResource Button.Text}"
                    Command="{Binding ResetCommand}"
                    Content="{Binding Texts[Keybind.Button.Reset]}" />
            <Button Grid.Column="2"
                    Margin="12,0,0,0"
                    Style="{StaticResource Button.Text}"
                    Command="{Binding SaveCommand}"
                    Content="{Binding Texts[Keybind.Button.Save]}" />
        </Grid>
    </Grid>
</UserControl>
