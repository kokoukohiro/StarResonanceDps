<UserControl x:Class="StarResonanceDps.Plugins.KeybindTool.Views.KeybindToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <Style x:Key="Keybind.Section" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="14" />
            <Setter Property="Background" Value="{DynamicResource Brush.WindowSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="Keybind.SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="Keybind.FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Keybind.Button" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.ControlBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root"
                                        Property="Background"
                                        Value="{DynamicResource Brush.ControlActiveBackground}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Keybind.PrimaryButton"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource Keybind.Button}">
            <Setter Property="Background" Value="{DynamicResource Brush.ControlActiveBackground}" />
        </Style>

        <Style x:Key="Keybind.ComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="132" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="Keybind.PathTextBox" TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="Keybind.DataGrid" TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="CanUserResizeRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Brush.BorderSoft}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource Brush.BorderSoft}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
        </Style>

        <Style x:Key="Keybind.DataGridCell" TargetType="{x:Type DataGridCell}">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        </Style>

        <Style x:Key="Keybind.DataGridHeader" TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="Background" Value="{DynamicResource Brush.ControlBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <DataTemplate x:Key="Keybind.ControllerActionGrid">
            <DataGrid Style="{StaticResource Keybind.DataGrid}"
                      CellStyle="{StaticResource Keybind.DataGridCell}"
                      ColumnHeaderStyle="{StaticResource Keybind.DataGridHeader}"
                      MaxHeight="440"
                      ItemsSource="{Binding}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="アクション"
                                        Binding="{Binding DisplayName}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTemplateColumn Header="補助キー" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource Keybind.ComboBox}"
                                          MinWidth="110"
                                          ItemsSource="{Binding HelperOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedHelper, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEditable}"
                                          Visibility="{Binding UsesHelper, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="ボタン" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource Keybind.ComboBox}"
                                          MinWidth="110"
                                          ItemsSource="{Binding ButtonOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedButton, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEditable}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>

        <DataTemplate x:Key="Keybind.KeyMouseActionGrid">
            <DataGrid Style="{StaticResource Keybind.DataGrid}"
                      CellStyle="{StaticResource Keybind.DataGridCell}"
                      ColumnHeaderStyle="{StaticResource Keybind.DataGridHeader}"
                      MaxHeight="440"
                      ItemsSource="{Binding}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="アクション"
                                        Binding="{Binding DisplayName}"
                                        IsReadOnly="True"
                                        Width="*" />
                    <DataGridTextColumn Header="固定"
                                        Binding="{Binding LControlPrefixDisplay}"
                                        IsReadOnly="True"
                                        Width="80" />
                    <DataGridTemplateColumn Header="キー" Width="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Style="{StaticResource Keybind.ComboBox}"
                                          MinWidth="140"
                                          ItemsSource="{Binding KeyOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                                          IsEnabled="{Binding IsEditable}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="16">
            <StackPanel>
                <Border Style="{StaticResource Keybind.Section}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                   Text="設定ファイルを選択"
                                   Style="{StaticResource Keybind.SectionTitle}" />

                        <ComboBox Grid.Row="1" Grid.Column="0"
                                  Margin="0,0,8,0"
                                  Style="{StaticResource Keybind.ComboBox}"
                                  ItemsSource="{Binding DetectedSaveFiles}"
                                  SelectedItem="{Binding SelectedDetectedSave, Mode=TwoWay}"
                                  DisplayMemberPath="DisplayName" />
                        <Button Grid.Row="1" Grid.Column="1"
                                Margin="0,0,8,0"
                                Style="{StaticResource Keybind.Button}"
                                Command="{Binding RescanCommand}"
                                Content="再スキャン" />

                        <TextBox Grid.Row="2" Grid.Column="0"
                                 Margin="0,8,8,0"
                                 Style="{StaticResource Keybind.PathTextBox}"
                                 Text="{Binding SelectedSaveFilePath, Mode=OneWay}" />
                        <Button Grid.Row="2" Grid.Column="1"
                                Margin="0,8,8,0"
                                Style="{StaticResource Keybind.Button}"
                                Command="{Binding SelectFileCommand}"
                                Content="手動選択" />
                        <Button Grid.Row="2" Grid.Column="2"
                                Margin="0,8,0,0"
                                Style="{StaticResource Keybind.Button}"
                                Command="{Binding OpenSelectedFileLocationCommand}"
                                Content="場所を開く" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Keybind.Section}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="キー設定プリセット"
                                       Style="{StaticResource Keybind.SectionTitle}" />
                            <TextBlock Text="{Binding LayoutFilePath}"
                                       Foreground="{DynamicResource Brush.TextMuted}"
                                       FontSize="12"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Keybind.Button}"
                                Command="{Binding LoadLayoutCommand}"
                                Content="読み込み" />
                        <Button Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource Keybind.Button}"
                                Command="{Binding OpenLayoutFileLocationCommand}"
                                Content="場所を開く" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Keybind.Section}">
                    <StackPanel>
                        <TextBlock Text="入力デバイスを選択"
                                   Style="{StaticResource Keybind.SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="ゲームパッド"
                                         Margin="0,0,20,0"
                                         GroupName="InputDevice"
                                         Foreground="{DynamicResource Brush.TextPrimary}"
                                         IsChecked="{Binding IsControllerMode, Mode=TwoWay}" />
                            <RadioButton Content="キーボード/マウス"
                                         GroupName="InputDevice"
                                         Foreground="{DynamicResource Brush.TextPrimary}"
                                         IsChecked="{Binding IsKeyMouseMode, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Keybind.Section}"
                        Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                                   Text="補助キー設定"
                                   Style="{StaticResource Keybind.SectionTitle}" />
                        <TextBlock Grid.Row="1" Text="コントローラ"
                                   Style="{StaticResource Keybind.FieldLabel}" />
                        <ComboBox Grid.Row="1" Grid.Column="1"
                                  Style="{StaticResource Keybind.ComboBox}"
                                  ItemsSource="{Binding ControllerTypes}"
                                  SelectedItem="{Binding SelectedControllerType, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Margin="0,10,0,0" Text="補助キー1"
                                   Style="{StaticResource Keybind.FieldLabel}" />
                        <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"
                                  Style="{StaticResource Keybind.ComboBox}"
                                  ItemsSource="{Binding HelperOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedHelper1, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" Margin="0,10,0,0" Text="補助キー2"
                                   Style="{StaticResource Keybind.FieldLabel}" />
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,10,0,0"
                                  Style="{StaticResource Keybind.ComboBox}"
                                  ItemsSource="{Binding HelperOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedHelper2, Mode=TwoWay}" />
                        <TextBlock Grid.Row="4" Margin="0,10,0,0" Text="確認/キャンセル"
                                   Style="{StaticResource Keybind.FieldLabel}" />
                        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,10,0,0"
                                  Style="{StaticResource Keybind.ComboBox}"
                                  ItemsSource="{Binding PresetOptions}"
                                  DisplayMemberPath="Label"
                                  SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                                  IsEnabled="{Binding IsPresetSupported}" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource Keybind.Section}">
                    <StackPanel>
                        <TextBlock Text="通常キー設定" Style="{StaticResource Keybind.SectionTitle}" />
                        <Grid>
                            <ContentControl Content="{Binding ControllerMainActions}"
                                            ContentTemplate="{StaticResource Keybind.ControllerActionGrid}"
                                            Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ContentControl Content="{Binding KeyMouseMainActions}"
                                            ContentTemplate="{StaticResource Keybind.KeyMouseActionGrid}"
                                            Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Keybind.Section}">
                    <StackPanel>
                        <TextBlock Text="クイックホイールのキー設定" Style="{StaticResource Keybind.SectionTitle}" />
                        <CheckBox Content="クイックホイールのアクションを単独で設定する"
                                  Margin="0,0,0,8"
                                  Foreground="{DynamicResource Brush.TextPrimary}"
                                  IsChecked="{Binding ControllerQuickWheelIndependent, Mode=TwoWay}"
                                  Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <CheckBox Content="クイックホイールのアクションを単独で設定する"
                                  Margin="0,0,0,8"
                                  Foreground="{DynamicResource Brush.TextPrimary}"
                                  IsChecked="{Binding KeyMouseQuickWheelIndependent, Mode=TwoWay}"
                                  Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Grid>
                            <ContentControl Content="{Binding ControllerQuickWheelActions}"
                                            ContentTemplate="{StaticResource Keybind.ControllerActionGrid}"
                                            Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ContentControl Content="{Binding KeyMouseQuickWheelActions}"
                                            ContentTemplate="{StaticResource Keybind.KeyMouseActionGrid}"
                                            Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Keybind.Section}">
                    <StackPanel>
                        <TextBlock Text="撮影モードのキー設定" Style="{StaticResource Keybind.SectionTitle}" />
                        <CheckBox Content="撮影モードのアクションを単独で設定する"
                                  Margin="0,0,0,8"
                                  Foreground="{DynamicResource Brush.TextPrimary}"
                                  IsChecked="{Binding ControllerPhotoModeIndependent, Mode=TwoWay}"
                                  Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <CheckBox Content="撮影モードのアクションを単独で設定する"
                                  Margin="0,0,0,8"
                                  Foreground="{DynamicResource Brush.TextPrimary}"
                                  IsChecked="{Binding KeyMousePhotoModeIndependent, Mode=TwoWay}"
                                  Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Grid>
                            <ContentControl Content="{Binding ControllerPhotoActions}"
                                            ContentTemplate="{StaticResource Keybind.ControllerActionGrid}"
                                            Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ContentControl Content="{Binding KeyMousePhotoActions}"
                                            ContentTemplate="{StaticResource Keybind.KeyMouseActionGrid}"
                                            Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Keybind.Section}">
                    <StackPanel>
                        <TextBlock Text="釣りモードのキー設定" Style="{StaticResource Keybind.SectionTitle}" />
                        <CheckBox Content="釣りモードのアクションを単独で設定する"
                                  Margin="0,0,0,8"
                                  Foreground="{DynamicResource Brush.TextPrimary}"
                                  IsChecked="{Binding KeyMouseFishingModeIndependent, Mode=TwoWay}"
                                  Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <Grid>
                            <ContentControl Content="{Binding ControllerFishingActions}"
                                            ContentTemplate="{StaticResource Keybind.ControllerActionGrid}"
                                            Visibility="{Binding IsControllerMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ContentControl Content="{Binding KeyMouseFishingActions}"
                                            ContentTemplate="{StaticResource Keybind.KeyMouseActionGrid}"
                                            Visibility="{Binding IsKeyMouseMode, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Keybind.Section}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding StatusText}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="1" Margin="8,0,0,0"
                                Style="{StaticResource Keybind.Button}"
                                Command="{Binding ResetCommand}"
                                Content="リセット" />
                        <Button Grid.Column="2" Margin="8,0,0,0"
                                Style="{StaticResource Keybind.PrimaryButton}"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding CanSave}"
                                Content="保存" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
