<UserControl x:Class="StarResonanceDps.App.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MouseDown="SearchBox_MouseDown">
    <Border Style="{StaticResource Input.SearchFrame}">
        <Grid Margin="14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Path Grid.Column="0"
                  Width="18"
                  Height="18"
                  Stretch="Uniform"
                  Fill="Transparent"
                  Stroke="{DynamicResource Brush.Icon}"
                  StrokeThickness="{DynamicResource Icon.StrokeThickness}"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round"
                  StrokeLineJoin="Round"
                  VerticalAlignment="Center"
                  Data="{DynamicResource Icon.Search}" />

            <Grid Grid.Column="1" Margin="12,0,0,0">
                <TextBox x:Name="PART_TextBox"
                         Style="{StaticResource Input.SearchInnerTextBox}"
                         Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{Binding Placeholder, ElementName=Root}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Text, ElementName=PART_TextBox}" Value="" />
                                        <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=PART_TextBox}" Value="False" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Grid>
    </Border>
</UserControl>
