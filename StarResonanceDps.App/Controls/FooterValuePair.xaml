<UserControl x:Class="StarResonanceDps.App.Controls.FooterValuePair"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             x:Name="Root"
             VerticalAlignment="Center"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="FooterValuePair.Text"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- 単位の幅を取っておくための見えない文字。取っておかない組では場所も取らない。 -->
        <Style x:Key="FooterValuePair.UnitReserve"
               TargetType="TextBlock"
               BasedOn="{StaticResource FooterValuePair.Text}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ReservesNumberUnitWidth, ElementName=Root}" Value="True">
                    <Setter Property="Visibility" Value="Hidden" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">
        <TextBlock Style="{StaticResource FooterValuePair.Text}"
                   Text="{Binding Label, ElementName=Root}" />
        <TextBlock Width="{Binding NumberWidth, ElementName=Root}"
                   Style="{StaticResource FooterValuePair.Text}"
                   Text="{Binding Value.Number, ElementName=Root}"
                   TextAlignment="Right"
                   TextTrimming="CharacterEllipsis" />
        <Grid>
            <TextBlock Style="{StaticResource FooterValuePair.UnitReserve}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NumberUnit_Kmbt_Thousand]}" />
            <TextBlock Style="{StaticResource FooterValuePair.UnitReserve}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NumberUnit_Kmbt_Million]}" />
            <TextBlock Style="{StaticResource FooterValuePair.UnitReserve}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NumberUnit_Kmbt_Billion]}" />
            <TextBlock Style="{StaticResource FooterValuePair.UnitReserve}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NumberUnit_Kmbt_Trillion]}" />
            <TextBlock Style="{StaticResource FooterValuePair.UnitReserve}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NumberUnit_Wan_TenThousand]}" />
            <TextBlock Style="{StaticResource FooterValuePair.UnitReserve}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NumberUnit_Wan_HundredMillion]}" />
            <TextBlock Style="{StaticResource FooterValuePair.UnitReserve}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NumberUnit_Wan_Trillion]}" />
            <TextBlock Style="{StaticResource FooterValuePair.Text}"
                       Text="{Binding Value.Unit, ElementName=Root}" />
        </Grid>
    </StackPanel>
</UserControl>
