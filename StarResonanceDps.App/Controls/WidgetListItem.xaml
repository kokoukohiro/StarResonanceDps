<UserControl x:Class="StarResonanceDps.App.Controls.WidgetListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:StarResonanceDps.App.Models.Widgets"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             Height="68"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <Style x:Key="WidgetItem.IconButton" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Background"
                    Value="{Binding DataContext.ThemePalette.ControlBackgroundBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush"
                    Value="{Binding DataContext.ThemePalette.BorderBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="OutlineLayer"
                                    Background="Transparent"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.Button}">
                                <Border x:Name="BackgroundLayer"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{DynamicResource Radius.ButtonInner}" />
                            </Border>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              IsHitTestVisible="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="{Binding DataContext.ThemePalette.ControlActiveBackgroundBrush, RelativeSource={RelativeSource Self}}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background"
                            Value="{Binding DataContext.ThemePalette.ControlActiveBackgroundBrush, RelativeSource={RelativeSource Self}}" />
                </Trigger>

                <DataTrigger Binding="{Binding DataContext.HasBackgroundImage, RelativeSource={RelativeSource Self}}"
                             Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.WidgetCardImageButtonBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.WidgetCardImageButtonBorder}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.HasBackgroundImage, RelativeSource={RelativeSource Self}}"
                                   Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.WidgetCardImageButtonActiveBackground}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding DataContext.HasBackgroundImage, RelativeSource={RelativeSource Self}}"
                                   Value="True" />
                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}"
                                   Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.WidgetCardImageButtonActiveBackground}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidgetItem.IconFill"
               TargetType="{x:Type Path}"
               BasedOn="{StaticResource Icon.Fill}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Fill"
                    Value="{Binding DataContext.ThemePalette.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                    <Setter Property="Fill" Value="{DynamicResource Brush.TextPrimary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidgetItem.IconStroke"
               TargetType="{x:Type Path}"
               BasedOn="{StaticResource Icon.Stroke}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Stroke"
                    Value="{Binding DataContext.ThemePalette.TextPrimaryBrush, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                    <Setter Property="Stroke" Value="{DynamicResource Brush.TextPrimary}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WidgetItem.IconStartFill"
               TargetType="{x:Type Path}"
               BasedOn="{StaticResource WidgetItem.IconFill}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="13.5" />
            <Setter Property="Height" Value="13.5" />
        </Style>

        <Style x:Key="WidgetItem.IconStopFill"
               TargetType="{x:Type Path}"
               BasedOn="{StaticResource WidgetItem.IconFill}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
        </Style>

        <Style x:Key="WidgetItem.IconClickThroughFill"
               TargetType="{x:Type Path}"
               BasedOn="{StaticResource WidgetItem.IconFill}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
        </Style>

        <!--
            選択リストの行。作りも色の引き方も Input.SelectComboBoxItem のまま(色はメイン画面と同じ鍵 Brush.* で引き、欄に付けた ThemePaletteScope がウィジェットの色にする)。
        -->
        <Style x:Key="WidgetItem.NameSelectBoxItem"
               TargetType="{x:Type ComboBoxItem}"
               BasedOn="{StaticResource Input.SelectComboBoxItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="4,0,12,0" />
        </Style>

        <!--
            選択リストのスクロール。ScrollViewer.ComboBoxDropDown と同じ作りで、スクロールバーの左に 4 の間を空ける
            (行の乗せた地とスクロールバーが接しないように。4 はスクロールバーとリストの縁の線の間と同じ)。スクロールバーが出ていないときは何も変わらない。
        -->
        <Style x:Key="WidgetItem.NameSelectBoxScrollViewer" TargetType="{x:Type ScrollViewer}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="CanContentScroll" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollViewer}">
                        <Grid SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    Grid.Column="0"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    CanHorizontallyScroll="False"
                                                    CanVerticallyScroll="False"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                    Cursor="{TemplateBinding Cursor}"
                                                    Margin="{TemplateBinding Padding}" />

                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Grid.Column="1"
                                       Margin="4,0,0,0"
                                       Style="{StaticResource ScrollBar.WidgetList}"
                                       AutomationProperties.AutomationId="VerticalScrollBar"
                                       Cursor="Arrow"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       Minimum="0"
                                       Orientation="Vertical"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       IsTabStop="False" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            複数開けるウィジェットの名前の欄。欄はウィジェット名と同じ字で、選んでいる項目で開く窓のタイトル(TargetSelectorText)と小さな下向きの印を出す。
            欄は、カードの状態の円・タイトル・下向きの印を1つに囲む枠で、見た目はお気に入りなどのボタン(WidgetItem.IconButton)と同じ。
            円は欄の外のもの(カードの左の円)を枠の上に重ねる。欄は左へ 6 はみ出して円を囲み、円とタイトルの位置は名前だけの表示と同じ(タイトルは枠の左端から 34)。
            欄の幅は 560 で、カードが狭くて入らなければ入るところまで縮む(幅を決めるのはカードの中の欄の置き場所)。開いたリストの幅は欄と同じ。
            開いたリストは共通の作り(行 Input.SelectComboBoxItem・スクロールバー ScrollBar.WidgetList)で、色はメイン画面と同じ鍵 Brush.* で引く。
            欄に ThemePaletteScope でウィジェットの色を書くのでウィジェットの色になり、背景画像のときは書かずメイン画面の色(カードの地も画像のときはメイン画面の色)。
            選択はカード(SelectedTargetOption)が持ち、選択リストは選んだら選択を戻す(コードの側)。項目は開いたときに作り直す。
            行が多い(街で100人前後)ので、リストは仮想化する。
        -->
        <Style x:Key="WidgetItem.NameSelectBox" TargetType="{x:Type ComboBox}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Height" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{Binding ThemePalette.ControlBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding ThemePalette.BorderBrush}" />
            <Setter Property="behaviors:ThemePaletteScope.Palette" Value="{Binding ThemePalette}" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource WidgetItem.NameSelectBoxItem}" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <!--
                行の文字は、その項目で開く窓のタイトル(WidgetTargetOption.Label)で、大きさはカードのタイトルと同じ。色は行の文字色(乗せると濃くなる)。
                左の円はカードの円と同じ位置・大きさ(枠 16・円 13・右の間 12)で、色はその項目の窓の状態(WindowStatusLevel、開いていなければ灰色)。
            -->
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate DataType="{x:Type models:WidgetTargetOption}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0"
                                  Width="16"
                                  Height="16"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center">
                                <Ellipse Width="13"
                                         Height="13"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         SnapsToDevicePixels="True">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Fill" Value="{DynamicResource Brush.Stopped}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding WindowStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Complete}">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WindowStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Partial}">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.DataStatusPartial}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding WindowStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Unavailable}">
                                                    <Setter Property="Fill" Value="{DynamicResource Brush.DataStatusUnavailable}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding Label}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetName}">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Foreground"
                                                Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ComboBoxItem}}}" />
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <!-- 枠はボタンと同じ角丸(外5・内4)の共通の枠。中身はタイトルが枠の左端から 34、下向きの印は枠の右端から 10。 -->
                            <ContentControl Style="{StaticResource Surface.RoundedButtonOutline}"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}" />

                            <Grid Margin="34,0,12,0" Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="FaceText"
                                           Grid.Column="0"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding TargetSelectorText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetName}">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Foreground" Value="{Binding ThemePalette.TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Path Grid.Column="1"
                                      Width="12"
                                      Height="12"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{DynamicResource Icon.Stroke}"
                                      Stroke="{Binding Foreground, ElementName=FaceText}"
                                      Data="{DynamicResource Icon.ChevronDown}" />
                            </Grid>

                            <ToggleButton Focusable="False"
                                          ClickMode="Press"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" SnapsToDevicePixels="True" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <!--
                                    地はカードの地、縁はボタンの縁と同じ色(欄に書いた色の範囲の中なので、ウィジェットの色か背景画像のときのメイン画面の色)。
                                    幅は欄の枠の幅と同じ(枠の左端から出るので、左右の端が枠とそろう)。
                                -->
                                <Grid Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="320"
                                      Margin="0,4,0,0">
                                    <ContentControl Style="{StaticResource Surface.RoundedOutline}"
                                                    Background="{DynamicResource Brush.WindowSurface}"
                                                    BorderBrush="{DynamicResource Brush.Border}"
                                                    Padding="4">
                                        <ScrollViewer Style="{StaticResource WidgetItem.NameSelectBoxScrollViewer}"
                                                      CanContentScroll="True">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </ContentControl>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <!-- 地と縁の切り替えはお気に入りなどのボタン(WidgetItem.IconButton)と同じ。ボタンの押した間の濃さは、欄では乗せた間に含まれる。 -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{Binding ThemePalette.ControlActiveBackgroundBrush}" />
                </Trigger>

                <!-- 背景画像のときはカードの地がメイン画面の色になるので、開いたリストもウィジェットの色を書かずメイン画面の色にする。 -->
                <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush.WidgetCardImageButtonBackground}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.WidgetCardImageButtonBorder}" />
                    <Setter Property="behaviors:ThemePaletteScope.Palette" Value="{x:Null}" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasBackgroundImage}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.WidgetCardImageButtonActiveBackground}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ContentControl Style="{StaticResource Panel.WidgetCard}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--
                状態の丸(13)と起動数バッジ(高さ16・幅は桁数で伸びる)が入れ替わる枠。
                **枠を16固定にして中の2つを中央揃えにする。** Auto にすると列幅が子で変わって
                右のウィジェット名が動き、Left 揃えだと左端を軸に伸びて中心もずれる。
                バッジが2桁になると左右へ数pxはみ出すが、中心対称なので名前の位置は動かない。
                色は開いている窓のうち一番悪い状態の印(CardDataStatusLevel)。窓が無ければ停止の灰色。
                複数開けるウィジェットの選択リストの欄(枠)はこの円を囲むので、円は欄の上に重ね(ZIndex)、押したのは欄に通す(IsHitTestVisible)。
            -->
            <Grid Grid.Column="0"
                  Width="16"
                  Height="16"
                  Margin="0,0,12,0"
                  VerticalAlignment="Center"
                  Panel.ZIndex="1"
                  IsHitTestVisible="False">
                <Ellipse Width="13"
                         Height="13"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         SnapsToDevicePixels="True">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Fill" Value="{DynamicResource Brush.Stopped}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CardDataStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Complete}">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CardDataStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Partial}">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.DataStatusPartial}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CardDataStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Unavailable}">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.DataStatusUnavailable}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowsPlayerWindowCountBadge}" Value="True" />
                                        <Condition Binding="{Binding HasOpenPlayerWindows}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>

                <Path x:Name="PlayerWindowCountBadgePath"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Stretch="None"
                      UseLayoutRounding="True"
                      SnapsToDevicePixels="True">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Fill" Value="{DynamicResource Brush.Stopped}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CardDataStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Complete}">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CardDataStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Partial}">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.DataStatusPartial}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CardDataStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Unavailable}">
                                    <Setter Property="Fill" Value="{DynamicResource Brush.DataStatusUnavailable}" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding ShowsPlayerWindowCountBadge}" Value="True" />
                                        <Condition Binding="{Binding HasOpenPlayerWindows}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>

            <TextBlock Grid.Column="1"
                       Grid.ColumnSpan="2"
                       Margin="0,0,168,0"
                       Text="{Binding DisplayName}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetName}">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Foreground" Value="{Binding ThemePalette.TextPrimaryBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </DataTrigger>
                            <!-- 複数開けるウィジェットで並べるものがあるときは、名前の欄を相手の選択リストにする(下の ComboBox)。 -->
                            <DataTrigger Binding="{Binding ShowsTargetSelector}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!--
                欄の枠は左の円を囲むので、円の列から始めて左へ 6 はみ出す(円とタイトルの位置は名前だけの表示と同じ)。右の端は名前だけの表示と同じ。
                幅は 560 で、入らなければ入るところまで縮む。列が1つの Grid で包むのは、MaxWidth が置き場所より小さい部品を
                Stretch にすると中央へ寄るため(上限で止めた列の中で広げれば、左に寄せたまま止まる)。
            -->
            <Grid Grid.Column="0"
                  Grid.ColumnSpan="3"
                  Margin="-6,0,168,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MaxWidth="560" />
                </Grid.ColumnDefinitions>

                <ComboBox Style="{StaticResource WidgetItem.NameSelectBox}"
                          ItemsSource="{Binding TargetOptions}"
                          Visibility="{Binding ShowsTargetSelector, Converter={StaticResource BooleanToVisibilityConverter}}"
                          DropDownOpened="TargetSelectBox_DropDownOpened"
                          SelectionChanged="TargetSelectBox_SelectionChanged"
                          DropDownClosed="TargetSelectBox_DropDownClosed" />
            </Grid>

            <StackPanel Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Height="34"
                        VerticalAlignment="Center">

                <Button Style="{StaticResource WidgetItem.IconButton}"
                        Command="{Binding ToggleFavoriteCommand}">
                    <Grid>
                        <Path Data="{DynamicResource Icon.Favorite}">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}" BasedOn="{StaticResource WidgetItem.IconStroke}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="{DynamicResource Icon.Favorite.Filled}">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}" BasedOn="{StaticResource WidgetItem.IconFill}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>

                <Button Style="{StaticResource WidgetItem.IconButton}"
                        Command="{Binding TogglePinCommand}">
                    <Grid>
                        <Path Data="{DynamicResource Icon.Pin.Unfixed}">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}" BasedOn="{StaticResource WidgetItem.IconFill}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="{DynamicResource Icon.Pin.Fixed}">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}" BasedOn="{StaticResource WidgetItem.IconFill}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>

                <Button Style="{StaticResource WidgetItem.IconButton}"
                        Command="{Binding ToggleClickThroughCommand}">
                    <Grid>
                        <Path Data="{DynamicResource Icon.ClickThrough.Off}">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}" BasedOn="{StaticResource WidgetItem.IconClickThroughFill}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClickThrough}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="{DynamicResource Icon.ClickThrough.On}">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}" BasedOn="{StaticResource WidgetItem.IconClickThroughFill}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsClickThrough}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>

                <Button Style="{StaticResource WidgetItem.IconButton}"
                        Click="SettingsButton_Click">
                    <Path Style="{StaticResource WidgetItem.IconFill}"
                          Data="{DynamicResource Icon.Settings}" />
                </Button>

                <Button Style="{StaticResource WidgetItem.IconButton}"
                        Command="{Binding ToggleRunningCommand}">
                    <Grid>
                        <!-- 停止の絵にするかはカードが決める(複数開けるウィジェットは選んでいる項目の窓が開いているか、ほかは起動中か)。 -->
                        <Path Data="{DynamicResource Icon.Start}">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}" BasedOn="{StaticResource WidgetItem.IconStartFill}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsStopIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>

                        <Path Data="{DynamicResource Icon.Stop}">
                            <Path.Style>
                                <Style TargetType="{x:Type Path}" BasedOn="{StaticResource WidgetItem.IconStopFill}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowsStopIcon}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </ContentControl>
</UserControl>
