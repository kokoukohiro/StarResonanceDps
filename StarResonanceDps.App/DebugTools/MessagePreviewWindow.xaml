<Window x:Class="StarResonanceDps.App.DebugTools.MessagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="370"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <ContentControl Style="{StaticResource Panel.WindowFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="Message preview" />

                <Button Grid.Column="1" Style="{StaticResource Button.WindowCaption}" Click="CloseButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                               FontSize="10"
                               Text="&#xE8BB;"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <ContentControl Grid.Row="1" Margin="8,1,8,8" Style="{StaticResource Panel.Root}">
                <Grid Margin="18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 本体の窓 -->
                    <StackPanel Grid.Column="0">
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Hotkey_HelperUnavailable" Click="HotkeyHelperUnavailable_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Hotkey_RegisterFailed" Click="HotkeyRegisterFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_NpcapMissing" Click="NpcapMissing_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_NpcapOutdated" Click="NpcapOutdated_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_DiscardUnsaved" Click="DiscardUnsaved_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_ResetSettings" Click="ResetSettings_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_ResetWidgetSettings" Click="ResetWidgetSettings_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PlayerInfo_SaveImageFailed" Click="SaveImageFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PlayerInfo_CopyImageFailed" Click="CopyImageFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Voicevox_ConnectFailed" Click="VoicevoxConnectFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Voicevox_BadResponse" Click="VoicevoxBadResponse_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Voicevox_Policy" Click="VoicevoxPolicy_Click" />
                        <Button Style="{StaticResource Button.Text}" Width="Auto" Content="WindowsVoice_Missing" Click="WindowsVoiceMissing_Click" />
                    </StackPanel>

                    <!-- キーバインドツールの窓 -->
                    <StackPanel Grid.Column="2">
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.DirectoryNotFound" Click="KeybindDirectoryNotFound_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.OpenDirectoryFailed" Click="KeybindOpenDirectoryFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.PresetUnavailableBody" Click="KeybindPresetUnavailable_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.LoadErrorBody" Click="KeybindLoadError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.LayoutFileMissing" Click="KeybindLayoutFileMissing_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.LayoutLoadedBody" Click="KeybindLayoutLoaded_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.LayoutLoadFailedBody" Click="KeybindLayoutLoadFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.SelectFileFirst" Click="KeybindSelectFileFirst_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.IncompleteSettings" Click="KeybindIncompleteSettings_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.PartialSaveIntro" Click="KeybindPartialSave_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.SaveCompletedBody" Click="KeybindSaveCompleted_Click" />
                        <Button Style="{StaticResource Button.Text}" Width="Auto" Content="Keybind.SaveErrorBody" Click="KeybindSaveError_Click" />
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Grid>
    </ContentControl>
</Window>
