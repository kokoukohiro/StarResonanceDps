<Window x:Class="StarResonanceDps.App.DebugTools.MessagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:StarResonanceDps.App.Services"
        MinWidth="370"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <ContentControl Style="{StaticResource Panel.WindowFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="Message preview" />

                <Button Grid.Column="1" Style="{StaticResource Button.WindowCaption}" Click="CloseButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                               FontSize="10"
                               Text="&#xE8BB;"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <ContentControl Grid.Row="1" Margin="8,1,8,8" Style="{StaticResource Panel.Root}">
                <Grid Margin="18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 更新の窓 -->
                    <StackPanel Grid.Column="4">
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Confirm" Click="UpdateConfirm_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Progress" Click="UpdateProgress_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Completed" Click="UpdateCompleted_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_CheckError" Click="UpdateCheckError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Error_Network" Tag="{x:Static services:AppUpdateFailure.Network}" Click="UpdateError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Error_Server" Tag="{x:Static services:AppUpdateFailure.Server}" Click="UpdateError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Error_RateLimit" Tag="{x:Static services:AppUpdateFailure.RateLimit}" Click="UpdateError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Error_InvalidRelease" Tag="{x:Static services:AppUpdateFailure.InvalidRelease}" Click="UpdateError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Error_NotFromZip" Tag="{x:Static services:AppUpdateFailure.NotFromZip}" Click="UpdateError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Error_Corrupt" Tag="{x:Static services:AppUpdateFailure.Corrupt}" Click="UpdateError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Error_Write" Tag="{x:Static services:AppUpdateFailure.Write}" Click="UpdateError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Error_Start" Tag="{x:Static services:AppUpdateFailure.Start}" Click="UpdateError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Error_Replace" Tag="{x:Static services:AppUpdateFailure.Replace}" Click="UpdateError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_Error_RestoreFailed" Tag="{x:Static services:AppUpdateFailure.RestoreFailed}" Click="UpdateError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_RestartFailed" Click="UpdateRestartFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Update_RestartFailedNotUpdated" Click="UpdateRestartFailedNotUpdated_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Feedback_Opened" Click="FeedbackOpened_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Feedback_OpenedMany" Click="FeedbackOpenedMany_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Feedback_AlreadyReported" Click="FeedbackAlreadyReported_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Feedback_CheckError_Network" Tag="{x:Static services:FeedbackIssueLookupFailure.Network}" Click="FeedbackCheckError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Feedback_CheckError_Server" Tag="{x:Static services:FeedbackIssueLookupFailure.Server}" Click="FeedbackCheckError_Click" />
                        <Button Style="{StaticResource Button.Text}" Width="Auto" Content="Feedback_CheckError_RateLimit" Tag="{x:Static services:FeedbackIssueLookupFailure.RateLimit}" Click="FeedbackCheckError_Click" />
                    </StackPanel>

                    <!-- 本体の窓 -->
                    <StackPanel Grid.Column="0">
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Startup_DataFolderNotWritable" Click="DataFolderNotWritable_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_NpcapInstall" Click="NpcapInstall_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Startup_InitializationFailed" Click="StartupInitializationFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Error_Unhandled" Click="UnhandledException_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="SettingsFile_LoadFailed" Click="SettingsLoadFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="StartupSettings_WindowsRegistrationFailed" Click="WindowsStartupRegistrationFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Hotkey_HelperUnavailable" Click="HotkeyHelperUnavailable_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Hotkey_RegisterFailed" Click="HotkeyRegisterFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_NpcapOutdated" Click="NpcapOutdated_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_DiscardUnsaved" Click="DiscardUnsaved_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_ResetSettings" Click="ResetSettings_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_ResetWidgetSettings" Click="ResetWidgetSettings_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PlayerInfo_SaveImageFailed" Click="SaveImageFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PlayerInfo_CopyImageFailed" Click="CopyImageFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="TextCopyFailed" Click="CopyTextFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Voicevox_ConnectFailed" Click="VoicevoxConnectFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Voicevox_LaunchFailed" Click="VoicevoxLaunchFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Voicevox_BadResponse" Click="VoicevoxBadResponse_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Voicevox_Policy" Click="VoicevoxPolicy_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="WindowsVoice_Missing" Click="WindowsVoiceMissing_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginAddFailed_InvalidFile" Click="PluginAddFailedInvalidFile_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginAddFailed_CannotPlace" Click="PluginAddFailedCannotPlace_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginAlreadyAdded" Click="PluginAlreadyAdded_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginAddFailed_MissingDependency" Click="PluginAddFailedMissingDependency_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginAddFailed_PendingDeletion" Click="PluginAddFailedPendingDeletion_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginUpdate" Click="PluginUpdate_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginUpdateFailed" Click="PluginUpdateFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Confirm_UninstallPlugin" Click="ConfirmUninstallPlugin_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginDeleteFailed" Click="PluginDeleteFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginLoadFailed" Click="PluginLoadFailed_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginStopped" Click="PluginStopped_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="PluginStopped_PacketBacklog" Click="PluginStoppedPacketBacklog_Click" />
                        <Button Style="{StaticResource Button.Text}" Width="Auto" Content="Aggregation_LoadFailed" Click="HistoryLoadFailed_Click" />
                    </StackPanel>

                    <!-- モジュールツールの窓 -->
                    <StackPanel Grid.Column="2">
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Module.SearchError" Click="ModuleSearchError_Click" />
                        <Button Margin="0,0,0,6" Style="{StaticResource Button.Text}" Width="Auto" Content="Module.SaveError" Click="ModuleSaveError_Click" />
                        <Button Style="{StaticResource Button.Text}" Width="Auto" Content="Module.SettingsLoadError" Click="ModuleSettingsLoadError_Click" />
                    </StackPanel>
                </Grid>
            </ContentControl>
        </Grid>
    </ContentControl>
</Window>
