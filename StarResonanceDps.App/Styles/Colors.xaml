<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Theme tokens. Later, theme switching can replace this dictionary or update these resources. -->
    <Color x:Key="Color.WindowBackground">#07111E</Color>
    <Color x:Key="Color.WindowSurface">#0B1624</Color>
    <Color x:Key="Color.SidebarBackground">#0A1422</Color>
    <Color x:Key="Color.PanelBackground">#101B2A</Color>
    <Color x:Key="Color.CardBackground">#132033</Color>
    <Color x:Key="Color.CardHoverBackground">#17283F</Color>
    <Color x:Key="Color.Border">#26384F</Color>
    <Color x:Key="Color.BorderSoft">#1E2C40</Color>
    <Color x:Key="Color.TextPrimary">#F4F8FC</Color>
    <Color x:Key="Color.TextSecondary">#9EADC0</Color>
    <Color x:Key="Color.TextMuted">#657589</Color>
    <Color x:Key="Color.Success">#43D978</Color>
    <Color x:Key="Color.Stopped">#7C8796</Color>
    <Color x:Key="Color.Danger">#F15D64</Color>

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.WindowBackground}" />
    <SolidColorBrush x:Key="Brush.WindowSurface" Color="{StaticResource Color.WindowSurface}" />
    <SolidColorBrush x:Key="Brush.SidebarBackground" Color="{StaticResource Color.SidebarBackground}" />
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="{StaticResource Color.PanelBackground}" />
    <SolidColorBrush x:Key="Brush.CardBackground" Color="{StaticResource Color.CardBackground}" />
    <SolidColorBrush x:Key="Brush.CardHoverBackground" Color="{StaticResource Color.CardHoverBackground}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.BorderSoft" Color="{StaticResource Color.BorderSoft}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Stopped" Color="{StaticResource Color.Stopped}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
</ResourceDictionary>
