<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ThemeManager updates the derived application theme brushes directly. -->
    <SolidColorBrush x:Key="Brush.WindowSurface" Color="#0B1624" />
    <SolidColorBrush x:Key="Brush.PanelBackground" Color="#121D2B" />
    <SolidColorBrush x:Key="Brush.Border" Color="#323B47" />
    <SolidColorBrush x:Key="Brush.BorderSoft" Color="#212B38" />
    <SolidColorBrush x:Key="Brush.ControlBackground" Color="#232D3A" />
    <SolidColorBrush x:Key="Brush.ControlActiveBackground" Color="#303945" />
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#101B28" />
    <SolidColorBrush x:Key="Brush.InputHoverBackground" Color="#1A2431" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#EDEEEF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A2A6AC" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#686F77" />
    <SolidColorBrush x:Key="Brush.Success" Color="#43D978" />
    <SolidColorBrush x:Key="Brush.Stopped" Color="#7C8796" />
</ResourceDictionary>
