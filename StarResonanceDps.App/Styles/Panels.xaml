<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Pure XAML rounded-outline surfaces.
        Using only built-in ContentControl avoids the WPF designer creating a temporary
        project to resolve a same-assembly custom control from this ResourceDictionary.
    -->
    <Style x:Key="Surface.RoundedOutline" TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border x:Name="OutlineLayer"
                            Background="{TemplateBinding BorderBrush}"
                            CornerRadius="{StaticResource Radius.Default}"
                            SnapsToDevicePixels="True">
                        <Border x:Name="SurfaceLayer"
                                Margin="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Button}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Surface.RoundedButtonOutline" TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border x:Name="OutlineLayer"
                            Background="{TemplateBinding BorderBrush}"
                            CornerRadius="{StaticResource Radius.Button}"
                            SnapsToDevicePixels="True">
                        <Border x:Name="SurfaceLayer"
                                Margin="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.ButtonInner}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The root surface is intentionally separate from Surface.RoundedOutline.
        WindowState.Maximized must flatten only the outer window frame; ordinary
        cards inside that window must keep their own rounded corners.
    -->
    <ControlTemplate x:Key="Panel.WindowFrameTemplate"
                     TargetType="{x:Type ContentControl}">
        <Border x:Name="OutlineLayer"
                Background="{TemplateBinding BorderBrush}"
                CornerRadius="{StaticResource Radius.Default}"
                SnapsToDevicePixels="True">
            <Border x:Name="SurfaceLayer"
                    Margin="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="{StaticResource Radius.Button}"
                    Padding="{TemplateBinding Padding}"
                    SnapsToDevicePixels="True">
                <ContentPresenter Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  SnapsToDevicePixels="True" />
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Value="{x:Static WindowState.Maximized}">
                <Setter Property="BorderThickness" Value="0" />
                <Setter TargetName="OutlineLayer" Property="CornerRadius" Value="0" />
                <Setter TargetName="SurfaceLayer" Property="CornerRadius" Value="0" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Panel.WindowFrame"
           TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="{DynamicResource Brush.WindowSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template" Value="{StaticResource Panel.WindowFrameTemplate}" />
    </Style>

    <Style x:Key="Panel.Root"
           TargetType="{x:Type ContentControl}"
           BasedOn="{StaticResource Surface.RoundedOutline}">
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
    </Style>

    <!--
        Per-widget floating non-text layer. The Border applies opacity once to its complete
        background/divider/body layer, preventing the divider from compositing twice over the surface.
    -->
    <Style x:Key="Panel.WidgetWindowFrame" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{Binding WidgetWindowPalette.WidgetWindowSurfaceBrush}" />
        <Setter Property="Opacity" Value="{Binding WidgetWindowPalette.NonTextOpacity}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Default}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Style.Triggers>
            <!--
                アクティブの間だけ不透明度を確保する。設定が最小近くのままだと
                スクロールバー・ヘッダー/フッターの分割線・ボタンの影が見えず操作できない。
                パレットを作り直さずトリガーで切り替えるのは、作り直すと一瞬消えて見えるため。
            -->
            <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                <Setter Property="Opacity" Value="{Binding WidgetWindowPalette.ActiveNonTextOpacity}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                <Setter Property="Background" Value="Transparent" />
            </DataTrigger>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                         Value="{x:Static WindowState.Maximized}">
                <Setter Property="CornerRadius" Value="0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Shared manager-list card structure. The widget list overrides colors from its
        per-widget palette; plugin items use the global defaults below.
    -->
    <Style x:Key="Panel.ManagerItemCard"
           TargetType="{x:Type ContentControl}"
           BasedOn="{StaticResource Surface.RoundedOutline}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Background" Value="{DynamicResource Brush.WindowSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    </Style>

    <Style x:Key="Panel.WidgetCard"
           TargetType="{x:Type ContentControl}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Background" Value="{Binding ThemePalette.WindowSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{Binding ThemePalette.BorderSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border x:Name="OutlineLayer"
                            Background="{TemplateBinding BorderBrush}"
                            CornerRadius="{StaticResource Radius.Default}"
                            SnapsToDevicePixels="True">
                        <Border x:Name="SurfaceLayer"
                                Margin="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Button}"
                                SnapsToDevicePixels="True">
                            <Grid ClipToBounds="True">
                                <Border x:Name="WidgetBackgroundImageLayer"
                                        Width="220"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="0,5,5,0"
                                        IsHitTestVisible="False">
                                    <Border.Background>
                                        <ImageBrush ImageSource="{Binding BackgroundImagePath}"
                                                    Stretch="UniformToFill"
                                                    AlignmentX="Right"
                                                    AlignmentY="Center" />
                                    </Border.Background>
                                </Border>

                                <Border x:Name="WidgetBackgroundFadeLayer"
                                        Width="220"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Stretch"
                                        CornerRadius="0,5,5,0"
                                        Background="{DynamicResource Brush.WindowSurface}"
                                        IsHitTestVisible="False">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Offset="0" Color="#FF000000" />
                                            <GradientStop Offset="0.25" Color="#D9000000" />
                                            <GradientStop Offset="1" Color="#00000000" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>

                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  SnapsToDevicePixels="True" />
                            </Grid>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasBackgroundImage}" Value="False">
                            <Setter TargetName="WidgetBackgroundImageLayer"
                                    Property="Visibility"
                                    Value="Collapsed" />
                            <Setter TargetName="WidgetBackgroundFadeLayer"
                                    Property="Visibility"
                                    Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                            <Setter TargetName="OutlineLayer"
                                    Property="Background"
                                    Value="{DynamicResource Brush.BorderSoft}" />
                            <Setter TargetName="SurfaceLayer"
                                    Property="Background"
                                    Value="{DynamicResource Brush.WindowSurface}" />
                            <Setter TargetName="WidgetBackgroundImageLayer"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter TargetName="WidgetBackgroundFadeLayer"
                                    Property="Visibility"
                                    Value="Visible" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Panel.SettingSection"
           TargetType="{x:Type ContentControl}"
           BasedOn="{StaticResource Surface.RoundedOutline}">
        <Setter Property="Background" Value="{DynamicResource Brush.WindowSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
    </Style>

    <Style x:Key="Panel.SettingFieldBase" TargetType="Border">
        <Setter Property="Height" Value="54" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Panel.SettingField" TargetType="Border" BasedOn="{StaticResource Panel.SettingFieldBase}">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="Panel.SettingFieldLast" TargetType="Border" BasedOn="{StaticResource Panel.SettingFieldBase}" />
</ResourceDictionary>
