<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Pure XAML rounded-outline surfaces.
        Using only built-in ContentControl avoids the WPF designer creating a temporary
        project to resolve a same-assembly custom control from this ResourceDictionary.
    -->
    <Style x:Key="Surface.RoundedOutline" TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border x:Name="OutlineLayer"
                            Background="{TemplateBinding BorderBrush}"
                            CornerRadius="{StaticResource Radius.Default}"
                            SnapsToDevicePixels="True">
                        <Border x:Name="SurfaceLayer"
                                Margin="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.Button}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Surface.RoundedButtonOutline" TargetType="{x:Type ContentControl}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Border x:Name="OutlineLayer"
                            Background="{TemplateBinding BorderBrush}"
                            CornerRadius="{StaticResource Radius.Button}"
                            SnapsToDevicePixels="True">
                        <Border x:Name="SurfaceLayer"
                                Margin="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{StaticResource Radius.ButtonInner}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              SnapsToDevicePixels="True" />
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Panel.WindowFrame"
           TargetType="{x:Type ContentControl}"
           BasedOn="{StaticResource Surface.RoundedOutline}">
        <Setter Property="Background" Value="{DynamicResource Brush.WindowSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    </Style>

    <Style x:Key="Panel.Root"
           TargetType="{x:Type ContentControl}"
           BasedOn="{StaticResource Surface.RoundedOutline}">
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
    </Style>

    <!--
        Per-widget floating non-text layer. The Border applies opacity once to its complete
        background/divider/body layer, preventing the divider from compositing twice over the surface.
    -->
    <Style x:Key="Panel.WidgetWindowFrame" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{Binding WidgetWindowPalette.WidgetWindowSurfaceBrush}" />
        <Setter Property="Opacity" Value="{Binding WidgetWindowPalette.NonTextOpacity}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Default}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
    </Style>

    <Style x:Key="Panel.WidgetCard"
           TargetType="{x:Type ContentControl}"
           BasedOn="{StaticResource Surface.RoundedOutline}">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Background" Value="{Binding ThemePalette.WindowSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{Binding ThemePalette.BorderSoftBrush}" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
    </Style>

    <Style x:Key="Panel.SettingSection"
           TargetType="{x:Type ContentControl}"
           BasedOn="{StaticResource Surface.RoundedOutline}">
        <Setter Property="Background" Value="{DynamicResource Brush.WindowSurface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
    </Style>

    <Style x:Key="Panel.SettingFieldBase" TargetType="Border">
        <Setter Property="Height" Value="54" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Panel.SettingField" TargetType="Border" BasedOn="{StaticResource Panel.SettingFieldBase}">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="Panel.SettingFieldLast" TargetType="Border" BasedOn="{StaticResource Panel.SettingFieldBase}" />
</ResourceDictionary>
