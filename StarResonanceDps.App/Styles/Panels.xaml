<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Panel.WindowFrame" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.WindowSurface}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Panel.Root" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.PanelBackground}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Panel.WidgetCard" TargetType="Border">
        <!-- Default card color. Per-widget settings can override this Background later. -->
        <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}" />
        <Setter Property="CornerRadius" Value="{StaticResource Radius.Default}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{StaticResource Padding.Card}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Panel.SettingSection" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Radius.Default}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Panel.SettingFieldBase" TargetType="Border">
        <Setter Property="Height" Value="54" />
        <Setter Property="Padding" Value="20,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Panel.SettingField" TargetType="Border" BasedOn="{StaticResource Panel.SettingFieldBase}">
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>

    <Style x:Key="Panel.SettingFieldLast" TargetType="Border" BasedOn="{StaticResource Panel.SettingFieldBase}" />

</ResourceDictionary>
