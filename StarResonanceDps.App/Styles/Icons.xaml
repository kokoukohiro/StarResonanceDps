    <Style x:Key="Icon.PlayerListSkillFrame" TargetType="{x:Type Image}">
        <Setter Property="Source" Value="{StaticResource Icon.RoleSkillFrame}" />
        <Setter Property="Stretch" Value="Fill" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsImagine}" Value="True">
                <Setter Property="Source" Value="{StaticResource Icon.ImagineSkillFrame}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Icon.PartyNumber" TargetType="{x:Type ContentControl}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="0,0,1,0" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="-1" Y="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ContentControl}">
                    <Grid>
                        <Image Source="{StaticResource Icon.PartyNumberFrame}"
                               Stretch="Fill"
                               RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="-1" ScaleY="1" />
                            </Image.RenderTransform>
                        </Image>
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="10"
                                   FontFamily="{StaticResource Font.NotoSansJP}"
                                   FontWeight="SemiBold"
                                   TextOptions.TextRenderingMode="Aliased"
                                   Foreground="#C0000000"
                                   Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                   TextAlignment="Center">
                            <TextBlock.RenderTransform>
                                <TranslateTransform Y="-3" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

