        大きさ・余白・出すか・ツールチップは使う画面が持つ(行の高さが画面ごとに違う)。
    -->
    <Style x:Key="Icon.CombatStateMask" TargetType="{x:Type Rectangle}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Fill" Value="{StaticResource Brush.CombatState}" />
        <Setter Property="OpacityMask">
