<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Common icon size -->
    <sys:Double x:Key="Icon.Size">18</sys:Double>

    <!-- Common stroke width for stroke-based icons -->
    <sys:Double x:Key="Icon.StrokeThickness">1.7</sys:Double>

    <!-- Icon brushes -->
    <SolidColorBrush x:Key="Brush.Icon" Color="#EAF4FF" />
    <SolidColorBrush x:Key="Brush.IconMuted" Color="#8FA6BF" />
    <SolidColorBrush x:Key="Brush.IconAccent" Color="#39C5FF" />

    <!-- Fill-based icon style -->
    <Style x:Key="Icon.Fill" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="{DynamicResource Icon.Size}" />
        <Setter Property="Height" Value="{DynamicResource Icon.Size}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource Brush.Icon}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Start icon style -->
    <Style x:Key="Icon.StartFill" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Fill}">
        <Setter Property="Width" Value="13.5" />
        <Setter Property="Height" Value="13.5" />
    </Style>

    <!-- Stop icon style -->
    <Style x:Key="Icon.StopFill" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Fill}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <!-- Stroke-based icon style -->
    <Style x:Key="Icon.Stroke" TargetType="{x:Type Path}">
        <Setter Property="Width" Value="{DynamicResource Icon.Size}" />
        <Setter Property="Height" Value="{DynamicResource Icon.Size}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource Brush.Icon}" />
        <Setter Property="StrokeThickness" Value="{DynamicResource Icon.StrokeThickness}" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Fill-based glow icon style -->
    <Style x:Key="Icon.FillGlow" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Fill}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="8"
                    ShadowDepth="0"
                    Opacity="0.55"
                    Color="#39C5FF" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stroke-based glow icon style -->
    <Style x:Key="Icon.StrokeGlow" TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.Stroke}">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="8"
                    ShadowDepth="0"
                    Opacity="0.55"
                    Color="#39C5FF" />
            </Setter.Value>
        </Setter>
    </Style>

