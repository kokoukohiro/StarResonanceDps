                <ImageBrush ImageSource="{StaticResource Icon.CombatState}" Stretch="Uniform" />
            </Setter.Value>
        </Setter>
        <Setter Property="Effect" Value="{StaticResource Effect.WidgetWindowTextShadow}" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

