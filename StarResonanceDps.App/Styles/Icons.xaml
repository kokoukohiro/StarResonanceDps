    <!-- PNG profession icons are alpha masks, colored by the current text theme. -->
    <Style x:Key="Icon.ProfessionMask" TargetType="{x:Type Rectangle}">
        <Setter Property="Width" Value="{DynamicResource Icon.Profession.Size}" />
        <Setter Property="Height" Value="{DynamicResource Icon.Profession.Size}" />
        <Setter Property="Fill" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
    </Style>

    <Style x:Key="Icon.ProfessionMask.ShieldKnight" TargetType="{x:Type Rectangle}" BasedOn="{StaticResource Icon.ProfessionMask}">
        <Setter Property="OpacityMask">
            <Setter.Value>
                <ImageBrush ImageSource="{StaticResource Icon.Profession.ShieldKnight}" Stretch="Uniform" />
            </Setter.Value>
        </Setter>
    </Style>

