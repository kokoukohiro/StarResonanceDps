        <Setter Property="Width" Value="{DynamicResource Icon.Size}" />
        <Setter Property="Height" Value="{DynamicResource Icon.Size}" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

