<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        ウィジェットの基底フォント。数字を等幅で出すために要る。

        既定フォントは OS の MessageFont(日本語環境では Yu Gothic UI)。その Semibold フェイスは
        数字がプロポーショナルなうえ tnum を持たないため、
        Typography.NumeralAlignment="Tabular" が黙って無視される。

        Segoe UI Semibold も既定の字幅は同じだが tnum を持つので Tabular が効く。
        **フォント指定と Tabular はセット。片方だけでは揃わない。**

        2つ目に和文フォントを直書きしないのは、zh-CN / ko-KR に日本語書体が当たるのを
        避けるため。合成フォント Global User Interface は言語ごとに割り当てを持っていて、
        ja なら Yu Gothic UI(いまと同じ書体)、zh-hans なら Microsoft YaHei UI、
        ko なら Malgun Gothic へ落ちる。その言語判定には FrameworkElement.Language が要る
        ので、LocalizationManager がカルチャから設定している。
    -->
    <FontFamily x:Key="Font.ProjectDefault">
        Segoe UI, Global User Interface
    </FontFamily>

    <FontFamily x:Key="Font.NotoSansJP">
        /StarResonanceDps;component/Assets/Fonts/#Noto Sans JP
    </FontFamily>

    <DropShadowEffect x:Key="Effect.WidgetWindowTextShadow"
                      Color="Black"
                      Opacity="1"
                      ShadowDepth="0"
                      BlurRadius="5" />

    <Style x:Key="Text.WidgetWindow" TargetType="TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Effect" Value="{StaticResource Effect.WidgetWindowTextShadow}" />
        <Setter Property="FontFamily" Value="{StaticResource Font.ProjectDefault}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="Text.WidgetWindowSubtitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource Text.WidgetWindow}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="Text.WidgetName" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontFamily" Value="{StaticResource Font.ProjectDefault}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>
    
</ResourceDictionary>
