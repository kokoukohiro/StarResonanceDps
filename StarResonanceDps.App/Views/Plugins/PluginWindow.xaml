<Window x:Class="StarResonanceDps.App.Views.Plugins.PluginWindow"
        x:Name="PluginHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
        xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
        Title="{Binding DisplayName}"
        Icon="/Assets/Images/ApplicationIcon.ico"
        behaviors:WindowWorkingAreaBehavior.ConstrainMaximizeToWorkingArea="True"
        Width="780"
        Height="640"
        MinWidth="740"
        MinHeight="480"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <ContentControl Style="{StaticResource Panel.WindowFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <controls:AppHeader Grid.Row="0" />

            <ContentPresenter Grid.Row="1"
                              Content="{Binding PluginContent, ElementName=PluginHostWindow}" />
        </Grid>
    </ContentControl>
</Window>
