<Window x:Class="StarResonanceDps.App.Views.Plugins.PluginWindow"
        x:Name="PluginHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DisplayName}"
        Width="520"
        Height="320"
        MinWidth="420"
        MinHeight="240"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <ContentControl Style="{StaticResource Panel.WindowFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Background="Transparent"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Text="{Binding DisplayName}" />

                <Button Grid.Column="1"
                        Style="{StaticResource Button.WindowCaption}"
                        Click="CloseButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                               FontSize="10"
                               Text="&#xE8BB;"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <!-- ConfirmWindow body with its footer removed. The bottom margin matches the main window's content spacing. -->
            <ContentControl Grid.Row="1"
                            Margin="8,1,8,8"
                            Style="{StaticResource Panel.Root}">
                <ContentPresenter Content="{Binding PluginContent, ElementName=PluginHostWindow}" />
            </ContentControl>
        </Grid>
    </ContentControl>
</Window>
