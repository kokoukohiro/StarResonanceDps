<Window x:Class="StarResonanceDps.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
        xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
        xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
        xmlns:viewModels="clr-namespace:StarResonanceDps.App.ViewModels"
        Title="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Window_Settings_Title]}"
        Icon="pack://application:,,,/Assets/Images/ApplicationIcon.ico"
        behaviors:WindowWorkingAreaBehavior.ConstrainMaximizeToWorkingArea="True"
        Width="760"
        Height="640"
        MinWidth="694"
        MinHeight="45"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.DataContext>
        <viewModels:SettingsViewModel />
    </Window.DataContext>

    <ContentControl Style="{StaticResource Panel.WindowFrame}">
        <Grid Background="Transparent"
              behaviors:FocusBehavior.ClearFocusOnBackgroundClick="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:AppHeader Grid.Row="0" />

            <Grid Grid.Row="1" Margin="8,1,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="166" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsExternalScrollBarColumn" Width="16" />
                </Grid.ColumnDefinitions>

                <ContentControl Grid.Column="0" Style="{StaticResource Panel.Root}">
                    <StackPanel Margin="10">
                        <Button x:Name="BasicNavButton"
                                Click="BasicNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.Wrench}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Basic_Title]}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="DisplayNavButton"
                                Click="DisplayNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.Sliders}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Display_Title]}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="AggregationNavButton"
                                Click="AggregationNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.AggregationSettings}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Aggregation_Title]}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="HotkeyNavButton"
                                Click="HotkeyNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.Hotkey}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Hotkeys_Title]}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="NotificationNavButton"
                                Click="NotificationNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.Notification}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Notification_Title]}" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ThemeNavButton"
                                Click="ThemeNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.Theme}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Theme_Title]}" />
                            </StackPanel>
                        </Button>


                        <Button x:Name="UpdateNavButton"
                                Click="UpdateNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.Update}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Update_Title]}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ContentControl>

                <ContentControl Grid.Column="2" Style="{StaticResource Panel.Root}">
                        <Grid Margin="26,22,18,18">
                            <ScrollViewer x:Name="ContentScrollViewer"
                                          Style="{StaticResource ScrollViewer.WidgetList}"
                                          VerticalScrollBarVisibility="Hidden"
                                          ScrollChanged="ContentScrollViewer_ScrollChanged"
                                          SizeChanged="ContentScrollViewer_SizeChanged">
                                <StackPanel Margin="0,0,10,6">
                                <TextBlock x:Name="BasicSection"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Basic_Title]}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_NetworkAdapter_Label]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Width="220"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          ItemsSource="{Binding AvailableNetworkAdapters}"
                                                          SelectedItem="{Binding SelectedNetworkAdapter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <!-- カスタムのときは下に実行ファイル名の行が続くので下線を引く。 -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Panel.SettingField}">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCustomGameCapturePreference}" Value="False">
                                                            <Setter Property="BorderThickness" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_GameCapturePreference_Label]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Width="220"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          ItemsSource="{Binding GameCapturePreferences}"
                                                          SelectedItem="{Binding SelectedGameCapturePreference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingFieldLast}"
                                                Visibility="{Binding IsCustomGameCapturePreference, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_GameCaptureCustomExeName_Label]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <TextBox x:Name="GameCaptureCustomExeNameTextBox"
                                                         Grid.Column="1"
                                                         Width="220"
                                                         Height="32"
                                                         Style="{StaticResource Input.PathBox}"
                                                         Text="{Binding GameCaptureCustomExeName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                         KeyDown="GameCaptureCustomExeNameTextBox_KeyDown"
                                                         VerticalContentAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ContentControl>

                                <TextBlock x:Name="DisplaySection"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Display_Title]}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Display_WidgetWindow]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="{Binding WidgetWindowTopmostModeIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[WidgetWindowTopmost_Always]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[WidgetWindowTopmost_PinnedOnly]}" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Language_Title]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Language_Auto]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Language_Japanese]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Language_Korean]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Language_Chinese]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Language_English]}" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Display_NumberMode]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="{Binding NumberDisplayFormatIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NumberDisplay_KMB]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NumberDisplay_Wan]}" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Display_PlayerName]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="{Binding PlayerNameDisplayModeIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerNameDisplay_Show]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerNameDisplay_Hide]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerNameDisplay_HideOthers]}" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Display_InternalId]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="{Binding InternalIdDisplayModeIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[InternalIdDisplay_Hidden]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[InternalIdDisplay_All]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[InternalIdDisplay_SkillOnly]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[InternalIdDisplay_BuffOnly]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[InternalIdDisplay_EntityOnly]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[InternalIdDisplay_MapOnly]}" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ContentControl>

                                <TextBlock x:Name="AggregationSection"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Aggregation_Title]}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <!-- 2行ぶんの高さ。既定54 + 注記の行(13px)と間隔4 で 75。 -->
                                        <Border Style="{StaticResource Panel.SettingField}" Height="75">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Aggregation_SplitOnPhases]}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />

                                                <!-- 注記の体裁はウィジェット設定「ロールスキル」の見出しに合わせてある。 -->
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="0"
                                                           Margin="0,4,0,0"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Aggregation_SplitOnPhases_Description]}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />

                                                <!-- スイッチは行0に置く。注記が折り返しても1行目に貼り付いたまま。 -->
                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="1"
                                                            Orientation="Horizontal"
                                                            VerticalAlignment="Center">
                                                    <ToggleButton Style="{StaticResource Input.Switch}"
                                                                  IsChecked="{Binding SplitEncountersOnNewPhases, Mode=TwoWay}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               MinWidth="28"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding SplitEncountersOnNewPhasesStateText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Aggregation_KeepPastResult]}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton Style="{StaticResource Input.Switch}"
                                                                  IsChecked="{Binding KeepPastEncounterInMeterUntilNextDamage, Mode=TwoWay}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               MinWidth="28"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding KeepPastEncounterInMeterUntilNextDamageStateText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Aggregation_ClearHistoryOnNextEvent]}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton Style="{StaticResource Input.Switch}"
                                                                  IsChecked="{Binding ClearHistorySelectionOnNextEvent, Mode=TwoWay}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               MinWidth="28"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding ClearHistorySelectionOnNextEventStateText}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Aggregation_MaxEncounterCount]}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />

                                                <!-- 選択肢はビューモデルが持つ。値は件数そのもので 0 が無限。 -->
                                                <!-- DisplayMemberPath は Input.SettingsComboBox では効かない。ItemTemplate を使うこと。 -->
                                                <ComboBox Grid.Column="1"
                                                          Width="220"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          ItemsSource="{Binding RetentionPolicyOptions}"
                                                          SelectedValuePath="Count"
                                                          SelectedValue="{Binding DatabaseMaxEncounterCount, Mode=TwoWay}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                    </StackPanel>
                                </ContentControl>

                                <TextBlock x:Name="HotkeySection"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Hotkeys_Title]}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
                                    <ItemsControl ItemsSource="{Binding HotkeyItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border>
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Panel.SettingField}">
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsLast}" Value="True">
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding Label}"
                                                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                                                   FontSize="14"
                                                                   FontWeight="SemiBold" />

                                                        <!--
                                                            クリックでキーの受付を始め、押したキーを割り当てる(SettingsWindow.xaml.cs)。
                                                            見た目は背景画像の欄と同じ Input.PathBox、幅は Button.Text と同じ 88。
                                                        -->
                                                        <TextBox Grid.Column="1"
                                                                 Width="88"
                                                                 Height="32"
                                                                 Style="{StaticResource Input.PathBox}"
                                                                 IsReadOnly="True"
                                                                 Cursor="Hand"
                                                                 InputMethod.IsInputMethodEnabled="False"
                                                                 VerticalContentAlignment="Center"
                                                                 Text="{Binding DisplayText, Mode=OneWay}"
                                                                 PreviewMouseLeftButtonDown="HotkeyBox_PreviewMouseLeftButtonDown"
                                                                 PreviewKeyDown="HotkeyBox_PreviewKeyDown"
                                                                 LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ContentControl>

                                <TextBlock x:Name="NotificationSection"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Notification_Title]}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />
                                <!-- 注記の体裁はウィジェット設定「ロールスキル」の見出しの注記に合わせてある。 -->
                                <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_WidgetNote]}"
                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,10" />
                                <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <!--
                                            下に通知音量の行が続くので常に下線を引く。
                                            Windows の通知のときは2行目に応答不可の注意書きを出す。折り返すことがあるので高さは中身に合わせる。
                                        -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Panel.SettingField}">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsWindowsNotificationSelected}" Value="True">
                                                            <Setter Property="Height" Value="Auto" />
                                                            <Setter Property="Padding" Value="20,11,20,11" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_Method]}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />

                                                <!-- 並びは AppConfigDefaults.NotificationMethod*Index の番号と同じ。 -->
                                                <ComboBox Grid.Row="0"
                                                          Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="{Binding NotificationMethodIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NotificationMethod_None]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NotificationMethod_Windows]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[NotificationMethod_Speech]}" />
                                                </ComboBox>

                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="0"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding IsWindowsNotificationSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_WindowsNote]}"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>

                                        <!-- 通知方式に関係なく出す。読み上げのときは下に読み上げ方式の行が続くので下線を引く。行の作りはウィジェット設定の不透明度のスライダーと同じ。 -->
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Panel.SettingField}">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSpeechSelected}" Value="False">
                                                            <Setter Property="BorderThickness" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_Volume]}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />

                                                <Grid Grid.Column="1" Width="260" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="10" />
                                                        <ColumnDefinition Width="35" />
                                                    </Grid.ColumnDefinitions>

                                                    <!-- 範囲は AppConfigDefaults.NotificationVolumeMin / Max と同じ(スタイルの既定は 0〜100)。 -->
                                                    <Slider Grid.Column="0"
                                                            Maximum="100"
                                                            IsSnapToTickEnabled="True"
                                                            TickFrequency="1"
                                                            Style="{StaticResource Input.ValueSlider}"
                                                            Value="{Binding NotificationVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                                    <TextBlock Grid.Column="2"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding NotificationVolume, StringFormat={}{0:0}%}" />
                                                </Grid>
                                            </Grid>
                                        </Border>

                                        <!-- 通知方式が読み上げのときだけ出す。VOICEVOX のときは下に行が続くので下線を引く。 -->
                                        <Border Visibility="{Binding IsSpeechSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Panel.SettingField}">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsVoicevoxSelected}" Value="False">
                                                            <Setter Property="BorderThickness" Value="0" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_Speech]}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />

                                                <!-- 並びは AppConfigDefaults.SpeechVoice*Index の番号と同じ。 -->
                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="{Binding SpeechVoiceIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[SpeechVoice_WindowsVoice]}" />
                                                    <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[SpeechVoice_Voicevox]}" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <!--
                                            VOICEVOX を選んだときだけ出す行(話者・スタイル)。注意書きの行は最後の行の2行目に置く。
                                            最後の行の高さは、既定54 + 注記の行(13px)と間隔4 で 75。
                                        -->
                                        <Border Visibility="{Binding IsVoicevoxSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Panel.SettingField}">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShowsVoicevoxStyle}" Value="False">
                                                            <Setter Property="BorderThickness" Value="0" />
                                                            <Setter Property="Height" Value="75" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_VoicevoxSpeaker]}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />

                                                <!-- 開くたびにエンジンへ問い合わせて選択肢を作り直す(SettingsWindow.xaml.cs)。DisplayMemberPath は効かないので ItemTemplate。 -->
                                                <ComboBox Grid.Row="0"
                                                          Grid.Column="1"
                                                          Width="220"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          ItemsSource="{Binding VoicevoxSpeakerOptions}"
                                                          SelectedItem="{Binding SelectedVoicevoxSpeaker, Mode=TwoWay}"
                                                          DropDownOpened="VoicevoxComboBox_DropDownOpened">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- 注意書きの行。スタイルの行があるときはそちらに出す(スタイルの行と同じ中身)。 -->
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="0"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowsVoicevoxStyle}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_VoicevoxNote], Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Hyperlink Style="{StaticResource Hyperlink.Inline}" Click="VoicevoxDownloadLink_Click">
                                                        <Run Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_VoicevoxDownload], Mode=OneWay}" />
                                                    </Hyperlink>
                                                    <Run Text="  " />
                                                    <Hyperlink Style="{StaticResource Hyperlink.Inline}" Click="VoicevoxPolicyLink_Click">
                                                        <Run Text="{Binding VoicevoxPolicyLinkText, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingFieldLast}"
                                                Height="75"
                                                Visibility="{Binding ShowsVoicevoxStyle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0"
                                                           Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_VoicevoxStyle]}"
                                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold" />

                                                <!-- 開いたときの作り直しは話者と同じ。 -->
                                                <ComboBox Grid.Row="0"
                                                          Grid.Column="1"
                                                          Width="220"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          ItemsSource="{Binding VoicevoxStyleOptions}"
                                                          SelectedItem="{Binding SelectedVoicevoxStyle, Mode=TwoWay}"
                                                          DropDownOpened="VoicevoxComboBox_DropDownOpened">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>

                                                <!-- 注意書きの行(話者の行と同じ中身)。 -->
                                                <TextBlock Grid.Row="1"
                                                           Grid.Column="0"
                                                           Grid.ColumnSpan="2"
                                                           Margin="0,4,0,0"
                                                           Foreground="{DynamicResource Brush.TextSecondary}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap">
                                                    <Run Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_VoicevoxNote], Mode=OneWay}" />
                                                    <Run Text="  " />
                                                    <Hyperlink Style="{StaticResource Hyperlink.Inline}" Click="VoicevoxDownloadLink_Click">
                                                        <Run Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_VoicevoxDownload], Mode=OneWay}" />
                                                    </Hyperlink>
                                                    <Run Text="  " />
                                                    <Hyperlink Style="{StaticResource Hyperlink.Inline}" Click="VoicevoxPolicyLink_Click">
                                                        <Run Text="{Binding VoicevoxPolicyLinkText, Mode=OneWay}" />
                                                    </Hyperlink>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ContentControl>

                                <TextBlock x:Name="ThemeSection"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Theme_Title]}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Theme_WindowColor]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ItemsControl ItemsSource="{Binding WindowColors.Colors}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <RadioButton GroupName="WindowColor"
                                                                             Tag="WindowColor"
                                                                             Background="{Binding Brush}"
                                                                             Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                             Click="ColorOptionRadioButton_Click" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>

                                                    <Button Grid.Column="2" Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}" Style="{StaticResource Button.Text}" Tag="WindowColor" Click="ColorPickerButton_Click" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                    </StackPanel>
                                </ContentControl>


                                <TextBlock x:Name="UpdateSection"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Update_Title]}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Update_Check_Label]}"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Update_Check_Button]}" Style="{StaticResource Button.Text}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ContentControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                </ContentControl>

                <ScrollBar x:Name="SettingsExternalScrollBar"
                           Grid.Column="3"
                           Margin="5,0,5,0"
                           Orientation="Vertical"
                           Style="{StaticResource ScrollBar.WidgetList}"
                           ValueChanged="SettingsExternalScrollBar_ValueChanged" />
            </Grid>

            <Grid Grid.Row="2" Margin="8,0,8,8">
                <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right">
                    <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Reset]}" Click="ResetButton_Click" Style="{StaticResource Button.Text}" />
                    <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Save]}" Margin="12,0,0,0" Click="SaveButton_Click" Style="{StaticResource Button.Text}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ContentControl>
</Window>
