<Window x:Class="StarResonanceDps.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
        xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
        xmlns:viewModels="clr-namespace:StarResonanceDps.App.ViewModels"
        Title="Star Resonance DPS Settings"
        Width="760"
        Height="640"
        MinWidth="640"
        MinHeight="45"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <converters:IndexToBooleanConverter x:Key="IndexToBooleanConverter" />
    </Window.Resources>

    <Window.DataContext>
        <viewModels:SettingsViewModel />
    </Window.DataContext>

    <Border Style="{StaticResource Panel.WindowFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:AppHeader Grid.Row="0" />

            <Grid Grid.Row="1" Margin="8,1,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="166" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsExternalScrollBarColumn" Width="16" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel.Root}">
                    <StackPanel Margin="10">
                        <Button x:Name="BasicNavButton"
                                Click="BasicNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.Sliders}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="基本設定" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="DisplayNavButton"
                                Click="DisplayNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.Window}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="表示設定" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ThemeNavButton"
                                Click="ThemeNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.Theme}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="テーマ" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="UpdateNavButton"
                                Click="UpdateNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.Update}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="アップデート" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Panel.Root}">
                        <Grid Margin="26,22,18,18">
                            <ScrollViewer x:Name="ContentScrollViewer"
                                          Style="{StaticResource ScrollViewer.WidgetList}"
                                          VerticalScrollBarVisibility="Hidden"
                                          ScrollChanged="ContentScrollViewer_ScrollChanged"
                                          SizeChanged="ContentScrollViewer_SizeChanged">
                                <StackPanel Margin="0,0,10,6">
                                <TextBlock x:Name="BasicSection"
                                           Text="基本設定"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Border Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,22">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="ネットワークアダプター"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                              Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="{Binding NetworkAdapterIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="Ethernet" />
                                                    <ComboBoxItem Content="Wi-Fi" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="DisplaySection"
                                           Text="表示設定"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Border Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,22">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="言語"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="システムと同じ" />
                                                    <ComboBoxItem Content="日本語" />
                                                    <ComboBoxItem Content="한국어" />
                                                    <ComboBoxItem Content="简体中文" />
                                                    <ComboBoxItem Content="English" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="数値表示形式"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="{Binding NumberDisplayFormatIndex, Mode=TwoWay}">
                                                    <ComboBoxItem Content="英語表記（KMBT）" />
                                                    <ComboBoxItem Content="日本語表記（万億兆）" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="ThemeSection"
                                           Text="テーマ"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Border Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,22">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="ウィンドウの色"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton GroupName="WindowColor"
                                                                 Background="#2297F4"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding WindowColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}" />
                                                    <RadioButton GroupName="WindowColor"
                                                                 Background="#7C5CFF"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding WindowColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1}" />
                                                    <RadioButton GroupName="WindowColor"
                                                                 Background="#9FD14A"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding WindowColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=2}" />
                                                    <RadioButton GroupName="WindowColor"
                                                                 Background="#FF9F2E"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding WindowColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=3}" />
                                                    <RadioButton GroupName="WindowColor"
                                                                 Background="#F05284"
                                                                 Margin="0,0,12,0"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding WindowColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=4}" />

                                                    <Button Grid.Column="2" Content="カスタマイズ" Style="{StaticResource Button.Text}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="文字の色"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <RadioButton GroupName="TextColor"
                                                                 Background="#2297F4"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding TextColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}" />
                                                    <RadioButton GroupName="TextColor"
                                                                 Background="#7C5CFF"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding TextColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1}" />
                                                    <RadioButton GroupName="TextColor"
                                                                 Background="#9FD14A"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding TextColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=2}" />
                                                    <RadioButton GroupName="TextColor"
                                                                 Background="#FF9F2E"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding TextColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=3}" />
                                                    <RadioButton GroupName="TextColor"
                                                                 Background="#F05284"
                                                                 Margin="0,0,12,0"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding TextColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=4}" />

                                                    <Button Grid.Column="2" Content="カスタマイズ" Style="{StaticResource Button.Text}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="UpdateSection"
                                           Text="アップデート"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Border Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="更新を確認"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="確認" Style="{StaticResource Button.Text}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                </Border>

                <ScrollBar x:Name="SettingsExternalScrollBar"
                           Grid.Column="3"
                           Margin="5,0,5,0"
                           Orientation="Vertical"
                           Style="{StaticResource ScrollBar.WidgetList}"
                           ValueChanged="SettingsExternalScrollBar_ValueChanged" />
            </Grid>

            <Grid Grid.Row="2" Margin="8,0,8,8">
                <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right">
                    <Button Content="初期化" Click="ResetButton_Click" Style="{StaticResource Button.Text}" />
                    <Button Content="保存" Margin="12,0,0,0" Click="SaveButton_Click" Style="{StaticResource Button.Text}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
