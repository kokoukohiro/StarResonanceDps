<Window x:Class="StarResonanceDps.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
        Title="Star Resonance DPS Settings"
        Width="920"
        Height="640"
        MinWidth="760"
        MinHeight="520"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStartupLocation="CenterOwner">
    <Border Style="{StaticResource Panel.WindowFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <controls:AppHeader Grid.Row="0" />

            <Grid Grid.Row="1" Margin="8,4,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="166" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="SettingsExternalScrollBarColumn" Width="16" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Panel.Root}">
                    <StackPanel Margin="10">
                        <Button x:Name="BasicNavButton"
                                Click="BasicNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Fill}" Data="{DynamicResource Icon.Settings}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="基本設定" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="DisplayNavButton"
                                Click="DisplayNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.Window}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="表示設定" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="ThemeNavButton"
                                Click="ThemeNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.Theme}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="テーマ" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="UpdateNavButton"
                                Click="UpdateNavButton_Click"
                                Style="{StaticResource Button.Sidebar}">
                            <StackPanel Orientation="Horizontal">
                                <Path Style="{DynamicResource Icon.Stroke}" Data="{DynamicResource Icon.Update}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="アップデート" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Panel.Root}">
                        <Grid Margin="26,22,18,18">
                            <ScrollViewer x:Name="ContentScrollViewer"
                                          Style="{StaticResource ScrollViewer.WidgetList}"
                                          VerticalScrollBarVisibility="Hidden"
                                          ScrollChanged="ContentScrollViewer_ScrollChanged"
                                          SizeChanged="ContentScrollViewer_SizeChanged">
                                <StackPanel Margin="0,0,10,6">
                                <TextBlock x:Name="BasicSection"
                                           Text="基本設定"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Border Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,22">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="ネットワークアダプター"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <ComboBox Grid.Column="0"
                                                              Style="{StaticResource Input.SettingsComboBox}"
                                                              SelectedIndex="0">
                                                        <ComboBoxItem Content="自動選択" />
                                                        <ComboBoxItem Content="Ethernet" />
                                                        <ComboBoxItem Content="Wi-Fi" />
                                                    </ComboBox>
                                                    <Button Grid.Column="2"
                                                            Content="自動選択"
                                                            Style="{StaticResource Button.Secondary}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="DisplaySection"
                                           Text="表示設定"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Border Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,22">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="言語"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="日本語" />
                                                    <ComboBoxItem Content="中文" />
                                                    <ComboBoxItem Content="English" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="数値表示形式"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <ComboBox Grid.Column="1"
                                                          Style="{StaticResource Input.SettingsComboBox}"
                                                          SelectedIndex="0">
                                                    <ComboBoxItem Content="標準" />
                                                    <ComboBoxItem Content="短縮表示" />
                                                    <ComboBoxItem Content="詳細表示" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="ThemeSection"
                                           Text="テーマ"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Border Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,22">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingField}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="テーマ色"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="24" Height="24" Margin="0,0,10,0" CornerRadius="12" Background="{DynamicResource Brush.Accent}" BorderBrush="White" BorderThickness="2" />
                                                    <Border Width="22" Height="22" Margin="0,0,10,0" CornerRadius="11" Background="#7C5CFF" />
                                                    <Border Width="22" Height="22" Margin="0,0,10,0" CornerRadius="11" Background="#2FC8C8" />
                                                    <Border Width="22" Height="22" Margin="0,0,10,0" CornerRadius="11" Background="#9FD14A" />
                                                    <Border Width="22" Height="22" Margin="0,0,10,0" CornerRadius="11" Background="#FF9F2E" />
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="#F05284" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="文字の色"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="8" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Border Grid.Column="0" Width="34" Height="28" CornerRadius="4" Background="{DynamicResource Brush.TextPrimary}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" />
                                                    <Button Grid.Column="2" Content="カスタマイズ" Style="{StaticResource Button.Secondary}" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="UpdateSection"
                                           Text="アップデート"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,10" />
                                <Border Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Border Style="{StaticResource Panel.SettingFieldLast}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="更新を確認"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold" />
                                                </StackPanel>

                                                <Button Grid.Column="1" Content="更新を確認" Style="{StaticResource Button.Primary}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                </Border>

                <ScrollBar x:Name="SettingsExternalScrollBar"
                           Grid.Column="3"
                           Margin="5,0,5,0"
                           Orientation="Vertical"
                           Style="{StaticResource ScrollBar.WidgetList}"
                           ValueChanged="SettingsExternalScrollBar_ValueChanged" />
            </Grid>

            <Grid Grid.Row="2" Margin="8,0,8,8">
                <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="18,10">
                    <Button Content="初期化" Style="{StaticResource Button.Secondary}" />
                    <Button Content="キャンセル" Margin="12,0,0,0" Click="CancelButton_Click" Style="{StaticResource Button.Secondary}" />
                    <Button Content="保存" Margin="12,0,0,0" Click="SaveButton_Click" Style="{StaticResource Button.Primary}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
