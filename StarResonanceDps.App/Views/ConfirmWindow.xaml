<Window x:Class="StarResonanceDps.App.Views.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="370"
        Height="176"
        MinWidth="370"
        MinHeight="176"
        MaxWidth="370"
        MaxHeight="176"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Border Style="{StaticResource Panel.WindowFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="HeaderText"
                           Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Button Grid.Column="1" Style="{StaticResource Button.WindowCaption}" Click="CloseButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                               FontSize="10"
                               Text="&#xE8BB;"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="8,1,8,7" Style="{StaticResource Panel.Root}">
                <StackPanel Margin="18,16">
                    <TextBlock x:Name="MessageText"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="DetailText"
                               Margin="0,10,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="13"
                               LineHeight="21"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="8,0,8,8">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button x:Name="YesButton"
                            Content="はい"
                            Style="{StaticResource Button.Text}"
                            Click="YesButton_Click" />
                    <Button x:Name="NoButton"
                            Content="いいえ"
                            Margin="12,0,0,0"
                            Style="{StaticResource Button.Text}"
                            Click="NoButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
