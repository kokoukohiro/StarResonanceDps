<UserControl x:Class="StarResonanceDps.App.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:services="clr-namespace:StarResonanceDps.App.Services"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!-- 上の欄の本文の文字(版の行と紹介文)。 -->
        <Style x:Key="Help.BodyText" TargetType="{x:Type TextBlock}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
            いちばん下の「ライセンス情報」。地も下線も無く、乗せると文字と右の印が明るくなる。
            地(透明)は、文字と印のあいだも押せるように置く。
        -->
        <Style x:Key="Help.LicenseLink" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="HelpScrollViewer"
                      Grid.Row="0"
                      Style="{StaticResource ScrollViewer.WidgetList}"
                      VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <!-- アプリの欄。名前は窓の題と同じ。 -->
                <ContentControl Margin="0"
                                Padding="20"
                                Style="{StaticResource Panel.ManagerItemCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0"
                                   Width="64"
                                   Height="64"
                                   Margin="0,0,16,0"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Source="{StaticResource Icon.Application}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Window_Manager_Title]}" />
                                <TextBlock Margin="0,4,0,0"
                                           Style="{StaticResource Help.BodyText}"
                                           Text="{Binding VersionText}" />
                            </StackPanel>

                            <Button Grid.Column="2"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Button.InputAction}"
                                    Command="{Binding CheckForUpdatesCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14"
                                          Height="14"
                                          Margin="0,0,8,0"
                                          Style="{StaticResource Icon.Fill}"
                                          Data="{DynamicResource Icon.Update}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Text="{Binding CheckForUpdatesText}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <TextBlock Margin="0,16,0,0"
                                   Style="{StaticResource Help.BodyText}"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_Intro_Summary]}" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource Help.BodyText}"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_Intro_Features]}" />
                        <TextBlock Margin="0,8,0,0"
                                   Style="{StaticResource Help.BodyText}"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_Intro_Notice]}" />
                    </StackPanel>
                </ContentControl>

                <!-- 見出しの文字と上の空き(16)は、通知タブの「プレビュー」と同じ。 -->
                <TextBlock Margin="0,16,0,10"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_Links_Title]}" />

                <!-- リンクの欄。2列×2段で、欄の間は縦横8(縦はButton.AggregationRowの下の余白)。 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource Button.LinkCard}"
                            Command="{Binding OpenLocalizedLinkCommand}"
                            CommandParameter="{x:Static services:LocalizedProjectPage.WikiHome}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,15,0"
                                  Style="{StaticResource Icon.Stroke}"
                                  Data="{DynamicResource Icon.Book}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.LinkCardTitle}"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_Usage_Title]}" />
                                <TextBlock Style="{StaticResource Text.LinkCardDescription}"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_Usage_Description]}" />
                            </StackPanel>

                            <Path Grid.Column="2" Style="{StaticResource Icon.LinkCardExternalMark}" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource Button.LinkCard}"
                            Command="{Binding OpenLocalizedLinkCommand}"
                            CommandParameter="{x:Static services:LocalizedProjectPage.PluginDevelopment}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,15,0"
                                  Style="{StaticResource Icon.Stroke}"
                                  Data="{DynamicResource Icon.Code}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.LinkCardTitle}"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_PluginDevelopment_Title]}" />
                                <TextBlock Style="{StaticResource Text.LinkCardDescription}"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_PluginDevelopment_Description]}" />
                            </StackPanel>

                            <Path Grid.Column="2" Style="{StaticResource Icon.LinkCardExternalMark}" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource Button.LinkCard}"
                            Command="{Binding OpenLinkCommand}"
                            CommandParameter="{x:Static services:ProjectLinks.ReleasesUrl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,15,0"
                                  Style="{StaticResource Icon.Stroke}"
                                  Data="{DynamicResource Icon.Document}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.LinkCardTitle}"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_ReleaseNotes_Title]}" />
                                <TextBlock Style="{StaticResource Text.LinkCardDescription}"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_ReleaseNotes_Description]}" />
                            </StackPanel>

                            <Path Grid.Column="2" Style="{StaticResource Icon.LinkCardExternalMark}" />
                        </Grid>
                    </Button>

                    <Button Grid.Row="1"
                            Grid.Column="2"
                            Style="{StaticResource Button.LinkCard}"
                            Command="{Binding OpenLinkCommand}"
                            CommandParameter="{x:Static services:ProjectLinks.SponsorsUrl}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0"
                                  Width="20"
                                  Height="20"
                                  Margin="0,0,15,0"
                                  Style="{StaticResource Icon.Fill}"
                                  Data="{DynamicResource Icon.Heart}" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Text.LinkCardTitle}"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_Sponsor_Title]}" />
                                <TextBlock Style="{StaticResource Text.LinkCardDescription}"
                                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_Sponsor_Description]}" />
                            </StackPanel>

                            <Path Grid.Column="2" Style="{StaticResource Icon.LinkCardExternalMark}" />
                        </Grid>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 著作権とライセンス。スクロールせず、いつも下に出す。 -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.TextSecondary}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_Copyright]}" />

            <Button Grid.Column="1"
                    Margin="16,0,0,0"
                    Style="{StaticResource Help.LicenseLink}"
                    Command="{Binding OpenLinkCommand}"
                    CommandParameter="{x:Static services:ProjectLinks.LicenseUrl}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="LicenseLinkText"
                               VerticalAlignment="Center"
                               Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Help_LicenseInformation]}" />
                    <Path Width="8"
                          Height="8"
                          Margin="4,1,0,0"
                          Style="{StaticResource Icon.Stroke}"
                          StrokeThickness="1"
                          Stroke="{Binding Foreground, ElementName=LicenseLinkText}"
                          Data="{DynamicResource Icon.ChevronRight}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
