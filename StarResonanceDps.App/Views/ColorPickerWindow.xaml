<Window x:Class="StarResonanceDps.App.Views.ColorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
        xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
        Width="477"
        Height="345"
        MinWidth="477"
        MinHeight="345"
        MaxWidth="477"
        MaxHeight="345"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewMouseDown="Window_PreviewMouseDown">
    <Window.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />

        <Style x:Key="ColorPicker.Control" TargetType="{x:Type controls:ColorPicker}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type controls:ColorPicker}">
                        <Grid Background="Transparent"
                              SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="219" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="PART_SV_InputArea"
                                    Grid.Column="0"
                                    Width="219"
                                    Height="219"
                                    ClipToBounds="True">
                                <Grid>
                                    <Rectangle x:Name="PART_SV_Canvas" Fill="Red" />

                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="White" Offset="0" />
                                                <GradientStop Color="Transparent" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="Transparent" Offset="0" />
                                                <GradientStop Color="Black" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>

                                    <Canvas>
                                        <Ellipse x:Name="PART_SV_Thumb"
                                                 Width="18"
                                                 Height="18"
                                                 Stroke="White"
                                                 StrokeThickness="3"
                                                 Fill="Transparent"
                                                 IsHitTestVisible="False"
                                                 SnapsToDevicePixels="True" />
                                    </Canvas>
                                </Grid>
                            </Border>

                            <Grid x:Name="PART_Hue_InputArea"
                                  Grid.Column="2"
                                  Width="24"
                                  Height="219"
                                  SnapsToDevicePixels="True">
                                <Border Width="20"
                                        Height="219"
                                        HorizontalAlignment="Center"
                                        ClipToBounds="True"
                                        SnapsToDevicePixels="True">
                                    <Canvas Width="20"
                                            Height="219"
                                            SnapsToDevicePixels="True">
                                        <Rectangle x:Name="PART_Hue_Bar"
                                                   Width="20"
                                                   Height="219"
                                                   SnapsToDevicePixels="True">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#FF0000" Offset="0.0" />
                                                    <GradientStop Color="#FF00FF" Offset="0.17" />
                                                    <GradientStop Color="#0000FF" Offset="0.33" />
                                                    <GradientStop Color="#00FFFF" Offset="0.5" />
                                                    <GradientStop Color="#00FF00" Offset="0.67" />
                                                    <GradientStop Color="#FFFF00" Offset="0.83" />
                                                    <GradientStop Color="#FF0000" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Canvas>
                                </Border>

                                <Canvas Width="24"
                                        Height="219"
                                        IsHitTestVisible="False"
                                        SnapsToDevicePixels="True">
                                    <Border x:Name="PART_Hue_Thumb"
                                            Width="24"
                                            Height="6"
                                            Canvas.Left="0"
                                            Background="White"
                                            BorderBrush="{DynamicResource Brush.Border}"
                                            BorderThickness="1"
                                            IsHitTestVisible="False" />
                                </Canvas>
                            </Grid>

                            <Grid Grid.Column="4"
                                  Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="16" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBox x:Name="PART_HexTextBox"
                                         FontSize="14"
                                         Style="{StaticResource Input.CopyableTextBox}" />

                                <StackPanel Grid.Row="2">
                                    <TextBlock Text="選択中の色"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <Ellipse Width="40"
                                             Height="40"
                                             HorizontalAlignment="Left"
                                             Fill="{Binding SelectedColor, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource ColorToBrushConverter}}"
                                             SnapsToDevicePixels="True" />
                                </StackPanel>

                                <StackPanel Grid.Row="4"
                                            Visibility="{Binding RecentColorsVisibility, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                    <TextBlock Text="最近使用した色"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding RecentColors.Colors, RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="5" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Width="32"
                                                    Height="32"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top">
                                                    <Button Width="22"
                                                        Height="22"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top"
                                                        Background="{Binding Brush}"
                                                        Style="{StaticResource Button.ColorSwatchButton}"
                                                        Click="RecentColorButton_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Panel.WindowFrame}">
        <Grid x:Name="KeyboardFocusSink"
              Focusable="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Margin="18,0,0,0"
                           VerticalAlignment="Center"
                           Text="カラーピッカー"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           FontSize="15"
                           FontWeight="SemiBold" />

                <Button Grid.Column="1" Style="{StaticResource Button.WindowCaption}" Click="CloseButton_Click">
                    <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                               FontSize="10"
                               Text="&#xE8BB;"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Margin="8,1,8,7" Style="{StaticResource Panel.Root}">
                <Grid Margin="16,16" Background="Transparent">
                    <controls:ColorPicker x:Name="ColorPicker"
                                          Style="{StaticResource ColorPicker.Control}" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="8,0,8,8">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="OkButton"
                            Content="OK"
                            Style="{StaticResource Button.Text}"
                            Click="OkButton_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
