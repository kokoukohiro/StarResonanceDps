<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.TakenDamageLogTextColorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        被ダメログのテキストカラー。行の作りはクラスカラー(TakenDamageLogClassColorSettingsView)と同じ。
        左の欄はダメージの属性の行が属性アイコン、それ以外の行が「Aa」。どちらもクラスアイコンと同じで、その行の選択色で染めて影を付ける。
    -->
    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />
        <!-- 最後の行は下の線を引かない(節の枠が閉じる)。 -->
        <Style x:Key="TakenDamageLogTextColorSettings.Field"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource Panel.SettingField}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding TextColorSectionTitle}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding TextColorItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource TakenDamageLogTextColorSettings.Field}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="27"
                                      Height="27"
                                      VerticalAlignment="Center">
                                    <Rectangle Width="25"
                                               Height="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsDamageProperty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                               Fill="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}"
                                               OpacityMask="{Binding IconMask}"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                        <Rectangle.Effect>
                                            <DropShadowEffect
                                                Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                Opacity="0.5"
                                                ShadowDepth="0"
                                                BlurRadius="5" />
                                        </Rectangle.Effect>
                                    </Rectangle>

                                    <!--
                                        属性以外の行の見本。言語に依らないので文言の表に入れない。太さは行の名前と同じで、
                                        大きさは字面の高さを名前(14)にそろえた 18(英字は同じ大きさの指定でも和文より字面が低い)。
                                    -->
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Text="Aa"
                                               Foreground="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}"
                                               FontSize="18"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDamageProperty}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                        <TextBlock.Effect>
                                            <DropShadowEffect
                                                Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                Opacity="0.5"
                                                ShadowDepth="0"
                                                BlurRadius="5" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>

                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding Colors.Colors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="{Binding DataContext.Key, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                             Background="{Binding Brush}"
                                                             Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Click="ColorOptionRadioButton_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}"
                                            Style="{StaticResource Button.Text}"
                                            Tag="{Binding Key}"
                                            Click="ColorPickerButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>
    </StackPanel>
</UserControl>
