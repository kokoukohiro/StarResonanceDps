                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">


                            <ItemsControl ItemsSource="{Binding ShieldKnightClassColors.Colors}">


                                <ItemsControl.ItemsPanel>


                                    <ItemsPanelTemplate>


                                        <StackPanel Orientation="Horizontal" />


                                    </ItemsPanelTemplate>


                                </ItemsControl.ItemsPanel>


                                <ItemsControl.ItemTemplate>


                                    <DataTemplate>


                                        <RadioButton GroupName="ShieldKnightClassColor"


                                                     Background="{Binding Brush}"


                                                     Style="{StaticResource Button.ColorSwatchRadioButton}"


                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"


                                                     Click="ColorOptionRadioButton_Click" />


                                    </DataTemplate>


                                </ItemsControl.ItemTemplate>


                            </ItemsControl>


                            <Button Content="色を選択"


                                    Style="{StaticResource Button.Text}"


                                    Tag="ShieldKnight"


                                    Click="ColorPickerButton_Click" />


                        </StackPanel>
                    </Grid>
