                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="SoulMusicianClassColor"
                                         Background="#1F9F0E"
                                         Style="{StaticResource Button.ColorSwatchRadioButton}"
                                         IsChecked="{Binding SoulMusicianClassColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}" />
                            <RadioButton GroupName="SoulMusicianClassColor"
                                         Background="#145F0A"
                                         Margin="0,0,12,0"
                                         Style="{StaticResource Button.ColorSwatchRadioButton}"
                                         IsChecked="{Binding SoulMusicianClassColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1}" />
                            <Button Content="カスタマイズ" Style="{StaticResource Button.Text}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="25"
                                   Height="25"
                                   Style="{StaticResource Icon.ProfessionImage.FlameBerserker}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Margin="10,0,0,0"
                                       Text="赤焔狂戦士"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
