                                         Style="{StaticResource Button.ColorSwatchRadioButton}"
                                         IsChecked="{Binding VerdantOracleClassColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}" />
                            <RadioButton GroupName="VerdantOracleClassColor"
