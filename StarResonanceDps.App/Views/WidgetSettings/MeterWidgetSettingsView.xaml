<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.MeterWidgetSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters">
    <UserControl.Resources>
        <converters:IndexToBooleanConverter x:Key="IndexToBooleanConverter" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="ClassColorsSection"
                   Text="クラスカラー"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,10,0,10" />

        <Border Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <StackPanel>
                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="25"
                                   Height="25"
                                   Style="{StaticResource Icon.ProfessionImage.ShieldKnight}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Margin="10,0,0,0"
                                       Text="神盾騎士"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="ShieldKnightClassColor"
                                         Background="#0F68B3"
                                         Style="{StaticResource Button.ColorSwatchRadioButton}"
                                         IsChecked="{Binding ShieldKnightClassColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}" />
                            <RadioButton GroupName="ShieldKnightClassColor"
                                         Background="#08406F"
                                         Margin="0,0,12,0"
                                         Style="{StaticResource Button.ColorSwatchRadioButton}"
                                         IsChecked="{Binding ShieldKnightClassColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1}" />
                            <Button Content="カスタマイズ" Style="{StaticResource Button.Text}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Width="25"
                                   Height="25"
                                   Style="{StaticResource Icon.ProfessionImage.HeavyGuardian}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Margin="10,0,0,0"
                                       Text="巨刃守護者"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <RadioButton GroupName="HeavyGuardianClassColor"
                                         Background="#08A0DC"
                                         Style="{StaticResource Button.ColorSwatchRadioButton}"
                                         IsChecked="{Binding HeavyGuardianClassColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=0}" />
                            <RadioButton GroupName="HeavyGuardianClassColor"
                                         Background="#056482"
                                         Margin="0,0,12,0"
                                         Style="{StaticResource Button.ColorSwatchRadioButton}"
                                         IsChecked="{Binding HeavyGuardianClassColorIndex, Mode=TwoWay, Converter={StaticResource IndexToBooleanConverter}, ConverterParameter=1}" />
                            <Button Content="カスタマイズ" Style="{StaticResource Button.Text}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}">
