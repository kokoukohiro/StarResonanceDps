<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.BuffCardNotificationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        バフ・デバフカードの通知テキスト。行の作りは表示設定の「バフ名」(BuffCardWidgetDisplaySettingsView)と同じで、
        行ごとに入力欄・プレビュー・差し込む項目を持つ。各行の DataContext は WidgetNotificationTextItemViewModel。
    -->
    <StackPanel>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_NotificationText_Title]}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Notification_BlankNote]}"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}"
                        Margin="0,0,0,12">
            <StackPanel>
                <Border DataContext="{Binding ExpiredNotification}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}"
                               BasedOn="{StaticResource Panel.SettingFieldBase}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Height" Value="Auto" />
                            <Setter Property="Padding" Value="20,11,20,11" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="134" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Label}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBox x:Name="ExpiredNotificationTextBox"
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 Height="32"
                                 Style="{StaticResource Input.PathBox}"
                                 Text="{Binding FormatString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Loaded="NotificationTextBox_Loaded"
                                 TextChanged="NotificationTextBox_TextChanged" />

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="4"
                              Margin="0,4,0,0"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="146" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_PlayerInfo_Preview]}" />

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding Preview}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Grid.Row="2"
                              Grid.ColumnSpan="4"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="146" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="1" x:Name="ExpiredNotificationFieldHost">
                                <ComboBox Width="{Binding ActualWidth, ElementName=ExpiredNotificationFieldHost}"
                                          MaxWidth="220"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding AvailableFormatFields}"
                                          SelectedItem="{Binding SelectedFormatField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource Input.SettingsComboBox}" />
                            </Grid>

                            <Button Grid.Column="3"
                                    Click="AddExpiredNotificationField_Click"
                                    Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Add]}"
                                    MinWidth="64"
                                    Style="{StaticResource Button.Text}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border DataContext="{Binding CuisinePotionLowNotification}">
                    <Border.Style>
                        <Style TargetType="{x:Type Border}"
                               BasedOn="{StaticResource Panel.SettingFieldBase}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Height" Value="Auto" />
                            <Setter Property="Padding" Value="20,11,20,11" />
                            <Setter Property="BorderThickness" Value="0" />
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="134" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Label}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />

                        <TextBox x:Name="CuisinePotionLowNotificationTextBox"
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 Height="32"
                                 Style="{StaticResource Input.PathBox}"
                                 Text="{Binding FormatString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Loaded="NotificationTextBox_Loaded"
                                 TextChanged="NotificationTextBox_TextChanged" />

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="4"
                              Margin="0,4,0,0"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="146" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_PlayerInfo_Preview]}" />

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding Preview}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Grid.Row="2"
                              Grid.ColumnSpan="4"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="146" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="1" x:Name="CuisinePotionLowNotificationFieldHost">
                                <ComboBox Width="{Binding ActualWidth, ElementName=CuisinePotionLowNotificationFieldHost}"
                                          MaxWidth="220"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding AvailableFormatFields}"
                                          SelectedItem="{Binding SelectedFormatField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource Input.SettingsComboBox}" />
                            </Grid>

                            <Button Grid.Column="3"
                                    Click="AddCuisinePotionLowNotificationField_Click"
                                    Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Add]}"
                                    MinWidth="64"
                                    Style="{StaticResource Button.Text}" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
