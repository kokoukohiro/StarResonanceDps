<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.PlayerStatusRowSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        ステータス詳細の行ごとのオン/オフ。行の作りは「他人のロールスキル」と同じ
        (左にアイコン、中央に項目名、右にスイッチ)。見出しの下の注意書きは「他人のロールスキル」の見出しの説明と同じ作り。
        行はスイッチ以外の所を掴んで並べ替えられる(RowReorderBehavior。写して薄くするのは行の中身 RowContent)。
    -->
    <StackPanel>
        <TextBlock Text="{Binding RowSectionTitle}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_RowReorderNote]}"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding Rows}"
                          behaviors:RowReorderBehavior.ContentElementName="RowContent">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.SettingField}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <!-- 並べ替えで写して薄くするのはこの Grid(アイコン・項目名・スイッチ)だけ。区切り線は Border が描くので写さず薄くしない。 -->
                            <Grid x:Name="RowContent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0"
                                           Width="35"
                                           Height="35"
                                           Margin="-4,0,0,0"
                                           Fill="{DynamicResource Brush.TextPrimary}"
                                           OpacityMask="{Binding IconMask}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                <TextBlock Grid.Column="1"
                                           Margin="8,0,12,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />

                                <StackPanel Grid.Column="2"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <ToggleButton Style="{StaticResource Input.Switch}"
                                                  IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               MinWidth="28"
                                               Text="{Binding StateText}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>
    </StackPanel>
</UserControl>
