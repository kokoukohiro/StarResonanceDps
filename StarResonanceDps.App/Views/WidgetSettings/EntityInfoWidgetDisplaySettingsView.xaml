<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.EntityInfoWidgetDisplaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        エンティティ情報の表示設定。書式の欄2つはバフ・デバフ一覧の「バフ名」と同じ作り、
        HP数値・戦闘状態・狙われるプレイヤー・ヘイト値はエンティティリストの行と同じ作り、
        同種バフの表示・付与者プレイヤー名の表示はバフ・デバフ一覧の行と同じ作り。
    -->
    <StackPanel>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Display_Title]}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}"
                        Margin="0,0,0,12">
            <StackPanel>
                <!-- エンティティ名の書式。 -->
                <Border>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}"
                               BasedOn="{StaticResource Panel.SettingFieldBase}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Height" Value="Auto" />
                            <Setter Property="Padding" Value="20,11,20,11" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="134" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_EntityInfo_Customization]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <TextBox x:Name="EntityInfoFormatTextBox"
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 Height="32"
                                 Style="{StaticResource Input.PathBox}"
                                 Text="{Binding EntityInfoFormatString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Loaded="EntityInfoFormatTextBox_Loaded"
                                 TextChanged="EntityInfoFormatTextBox_TextChanged" />

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="4"
                              Margin="0,4,0,0"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="146" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_PlayerInfo_Preview]}" />

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding EntityInfoFormatPreview}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Grid.Row="2"
                              Grid.ColumnSpan="4"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="146" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="1" x:Name="EntityInfoFormatFieldHost">
                                <ComboBox Width="{Binding ActualWidth, ElementName=EntityInfoFormatFieldHost}"
                                          MaxWidth="220"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding AvailableEntityInfoFormatFields}"
                                          SelectedItem="{Binding SelectedEntityInfoFormatField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource Input.SettingsComboBox}" />
                            </Grid>

                            <Button Grid.Column="3"
                                    Click="AddEntityInfoFormatField_Click"
                                    Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Insert]}"
                                    MinWidth="64"
                                    Style="{StaticResource Button.Text}" />
                        </Grid>
                    </Grid>
                </Border>

                <!-- バフ・デバフの枠の名前の書式。 -->
                <Border>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}"
                               BasedOn="{StaticResource Panel.SettingFieldBase}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Height" Value="Auto" />
                            <Setter Property="Padding" Value="20,11,20,11" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                        </Style>
                    </Border.Style>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="134" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_BuffInfo_Customization]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <TextBox x:Name="BuffInfoFormatTextBox"
                                 Grid.Row="0"
                                 Grid.Column="2"
                                 Height="32"
                                 Style="{StaticResource Input.PathBox}"
                                 Text="{Binding BuffInfoFormatString, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalContentAlignment="Center"
                                 Loaded="BuffInfoFormatTextBox_Loaded"
                                 TextChanged="BuffInfoFormatTextBox_TextChanged" />

                        <Grid Grid.Row="1"
                              Grid.ColumnSpan="4"
                              Margin="0,4,0,0"
                              VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="146" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_PlayerInfo_Preview]}" />

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Text="{Binding BuffInfoFormatPreview}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <Grid Grid.Row="2"
                              Grid.ColumnSpan="4"
                              Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="146" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="1" x:Name="BuffInfoFormatFieldHost">
                                <ComboBox Width="{Binding ActualWidth, ElementName=BuffInfoFormatFieldHost}"
                                          MaxWidth="220"
                                          HorizontalAlignment="Right"
                                          ItemsSource="{Binding AvailableBuffInfoFormatFields}"
                                          SelectedItem="{Binding SelectedBuffInfoFormatField, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource Input.SettingsComboBox}" />
                            </Grid>

                            <Button Grid.Column="3"
                                    Click="AddBuffInfoFormatField_Click"
                                    Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Insert]}"
                                    MinWidth="64"
                                    Style="{StaticResource Button.Text}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Display_HealthValue]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding HealthValueDisplayModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Input.SettingsComboBox}">
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[HealthValueDisplay_AddShield]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[HealthValueDisplay_SeparateShield]}" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Display_CombatState]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <!-- 並びは EntityInfoWidgetSettingsConfig.CombatStateDisplayModeIndex の添字と同じ。 -->
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding CombatStateDisplayModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Input.SettingsComboBox}">
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerNameDisplay_Show]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerNameDisplay_Hide]}" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Display_TargetedPlayer]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <!-- 並びは EntityInfoWidgetSettingsConfig.TargetedPlayerDisplayModeIndex の添字と同じ。 -->
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding TargetedPlayerDisplayModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Input.SettingsComboBox}">
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerNameDisplay_Show]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerNameDisplay_Hide]}" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Display_HateValue]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <!-- 並びは WidgetConfigDefaults.EntityInfoHateRankDisplayCounts の添字と同じ。 -->
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding HateRankDisplayModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Input.SettingsComboBox}">
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[HateRankDisplay_All]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[HateRankDisplay_Top5]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[HateRankDisplay_Top4]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[HateRankDisplay_Top3]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[HateRankDisplay_Top2]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[HateRankDisplay_FirstOnly]}" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Display_SameBuffs]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <!-- 並びは EntityInfoWidgetSettingsConfig.SameBuffGroupingIndex の添字と同じ。 -->
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding SameBuffGroupingIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Input.SettingsComboBox}">
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[SameBuffs_Ungrouped]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[SameBuffs_Grouped]}" />
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingFieldLast}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Display_CasterName]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <!-- 並びは EntityInfoWidgetSettingsConfig.CasterNameDisplayModeIndex の添字と同じ。 -->
                        <ComboBox Grid.Column="1"
                                  SelectedIndex="{Binding CasterNameDisplayModeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource Input.SettingsComboBox}">
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerNameDisplay_Show]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerNameDisplay_Hide]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[CasterNameDisplay_AppliedByOthers]}" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
