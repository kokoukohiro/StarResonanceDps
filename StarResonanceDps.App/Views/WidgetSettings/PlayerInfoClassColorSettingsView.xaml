<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.PlayerInfoClassColorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        プレイヤー情報のアイコンカラー。行の作りはプレイヤーリストのアイコンカラー(MeterWidgetClassColorSettingsView)と同じ。
        行の絵はクラス・不明(クラスアイコンの形)、シーズン心相晶(型の絵と無効)、シーズンの3種類。フィルターと不透明度は持たない。
    -->
    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />

        <Style x:Key="PlayerInfoClassColorSettings.ProfessionIconMask"
               TargetType="{x:Type Rectangle}"
               BasedOn="{StaticResource Icon.ProfessionMask}">
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="ShieldKnight">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.ShieldKnight}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="HeavyGuardian">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.HeavyGuardian}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="VerdantOracle">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.VerdantOracle}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="SoulMusician">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.SoulMusician}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="FlameBerserker">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.FlameBerserker}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Stormblade">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Stormblade}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="FrostMage">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.FrostMage}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="WindKnight">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.WindKnight}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Marksman">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Marksman}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Transformation">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Transformation}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Unknown">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 最後の行は下の線を引かない(節の枠が閉じる)。 -->
        <Style x:Key="PlayerInfoClassColorSettings.Field"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource Panel.SettingField}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding ClassColorSectionTitle}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding ClassColorItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PlayerInfoClassColorSettings.Field}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="27"
                                      Height="27"
                                      VerticalAlignment="Center">
                                    <!-- クラスと不明の行。シーズン心相晶とシーズンの行では出さない。 -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSeasonTalent}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSeason}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Rectangle Width="25"
                                                   Height="25"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource PlayerInfoClassColorSettings.ProfessionIconMask}"
                                                   Fill="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}">
                                            <Rectangle.Effect>
                                                <DropShadowEffect
                                                    Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                    Opacity="0.5"
                                                    ShadowDepth="0"
                                                    BlurRadius="5" />
                                            </Rectangle.Effect>
                                        </Rectangle>
                                    </Grid>
                                    <!-- シーズン心相晶の行(型の絵と無効)。 -->
                                    <Rectangle Width="27"
                                               Height="27"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Fill="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}"
                                               OpacityMask="{Binding SeasonTalentIconMask}"
                                               Visibility="{Binding IsSeasonTalent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Rectangle.Effect>
                                            <DropShadowEffect
                                                Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                Opacity="0.5"
                                                ShadowDepth="0"
                                                BlurRadius="5" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                    <!-- シーズンの行。 -->
                                    <Rectangle Width="27"
                                               Height="27"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Fill="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}"
                                               OpacityMask="{Binding SeasonIconMask}"
                                               Visibility="{Binding IsSeason, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Rectangle.Effect>
                                            <DropShadowEffect
                                                Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                Opacity="0.5"
                                                ShadowDepth="0"
                                                BlurRadius="5" />
                                        </Rectangle.Effect>
                                    </Rectangle>
                                </Grid>

                                <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding Colors.Colors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="{Binding DataContext.Key, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                             Background="{Binding Brush}"
                                                             Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Click="ColorOptionRadioButton_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}"
                                            Style="{StaticResource Button.Text}"
                                            Tag="{Binding Key}"
                                            Click="ColorPickerButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>
    </StackPanel>
</UserControl>
