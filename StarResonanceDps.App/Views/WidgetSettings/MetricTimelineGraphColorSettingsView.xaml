<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.MetricTimelineGraphColorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StarResonanceDps.App.Views.WidgetSettings"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        推移グラフのグラフカラー。行の作りはメーターのクラスカラー(MeterWidgetClassColorSettingsView)と同じで、不透明度は持たない。
        クラスアイコンの欄に折れ線の見本を出す(メーターのクラスアイコンと同じく、選んでいる色にフィルターを掛けた色で描いて影を付ける)。
        クラスの行の後にフィルターの行が必ず続くので、クラスの最後の行も下の線を引く。
    -->
    <UserControl.Resources>
        <converters:ClassColorFilterBrushConverter x:Key="ClassColorFilterBrushConverter" />
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding GraphColorSectionTitle}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding ClassColorItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Panel.SettingField}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 見本。2回折れる線(/＼/)で、上下の端をそろえて欄の中央に置く。グラフの線と同じく端と角を丸める。 -->
                                    <Polyline Grid.Column="0"
                                              Width="27"
                                              Height="27"
                                              VerticalAlignment="Center"
                                              Points="3,19 10,8 17,19 24,8"
                                              StrokeThickness="2"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round">
                                        <Polyline.Stroke>
                                            <MultiBinding Converter="{StaticResource ClassColorFilterBrushConverter}">
                                                <Binding Path="Colors.SelectedColor" />
                                                <Binding Path="DataContext.ClassColorFilterEnabled" RelativeSource="{RelativeSource AncestorType={x:Type local:MetricTimelineGraphColorSettingsView}}" />
                                                <Binding Path="DataContext.ClassColorFilterColors.SelectedColor" RelativeSource="{RelativeSource AncestorType={x:Type local:MetricTimelineGraphColorSettingsView}}" />
                                                <Binding Path="DataContext.ClassColorFilterStrength" RelativeSource="{RelativeSource AncestorType={x:Type local:MetricTimelineGraphColorSettingsView}}" />
                                            </MultiBinding>
                                        </Polyline.Stroke>
                                        <Polyline.Effect>
                                            <DropShadowEffect
                                                Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                Opacity="0.5"
                                                ShadowDepth="0"
                                                BlurRadius="5" />
                                        </Polyline.Effect>
                                    </Polyline>

                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Colors.Colors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton GroupName="{Binding DataContext.Key, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                 Background="{Binding Brush}"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                 Click="ColorOptionRadioButton_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}"
                                                Style="{StaticResource Button.Text}"
                                                Tag="{Binding Key}"
                                                Click="ColorPickerButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.SettingField}">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsClassColorFilterOptions}" Value="False">
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_GraphColors_Filter]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource Input.Switch}"
                                          IsChecked="{Binding ClassColorFilterEnabled, Mode=TwoWay}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       MinWidth="28"
                                       Text="{Binding ClassColorFilterStateText}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}"
                        Visibility="{Binding ShowsClassColorFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_ClassColors_FilterColor]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding ClassColorFilterColors.Colors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="GraphColorFilter"
                                                     Background="{Binding Brush}"
                                                     Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     Click="ColorOptionRadioButton_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}"
                                    Style="{StaticResource Button.Text}"
                                    Click="ClassColorFilterPickerButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingFieldLast}"
                        Visibility="{Binding ShowsClassColorFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_ClassColors_FilterStrength]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Style="{StaticResource Input.ValueSlider}"
                                    Value="{Binding ClassColorFilterStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding ClassColorFilterStrength, StringFormat={}{0:0}%}" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
