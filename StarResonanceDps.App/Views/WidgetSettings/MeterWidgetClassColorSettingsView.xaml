<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.MeterWidgetClassColorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StarResonanceDps.App.Views.WidgetSettings"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />

        <Style x:Key="MeterWidgetClassColorSettings.ProfessionIconMask"
               TargetType="{x:Type Rectangle}"
               BasedOn="{StaticResource Icon.ProfessionMask}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="25" />
            <Setter Property="Height" Value="25" />

            <Style.Triggers>
                <DataTrigger Binding="{Binding Key}" Value="ShieldKnight">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.ShieldKnight}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="HeavyGuardian">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.HeavyGuardian}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="VerdantOracle">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.VerdantOracle}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="SoulMusician">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.SoulMusician}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="FlameBerserker">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.FlameBerserker}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Stormblade">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Stormblade}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="FrostMage">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.FrostMage}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="WindKnight">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.WindKnight}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Marksman">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Marksman}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Transformation">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Transformation}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Monster">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Monster}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Elite">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Elite}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Boss">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Boss}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding Key}" Value="Unknown">
                    <Setter Property="OpacityMask">
                        <Setter.Value>
                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MeterWidgetClassColorSettings.FinalField"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource Panel.SettingField}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsLast}"
                                   Value="True" />
                        <Condition Binding="{Binding DataContext.HasClassColorOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:MeterWidgetClassColorSettingsView}}}"
                                   Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="BorderThickness" Value="0" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="MeterWidgetClassColorSettings.MeterProfessionIconBackground"
               TargetType="{x:Type Border}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="29" />
            <Setter Property="Height" Value="29" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.ButtonInner}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding ClassColorSectionTitle}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MeterWidgetClassColorSettings.FinalField}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" VerticalAlignment="Center">
                                        <Grid Width="27"
                                              Height="27"
                                              Visibility="{Binding DataContext.ShowsPlayerListProfessionIcons, RelativeSource={RelativeSource AncestorType={x:Type local:MeterWidgetClassColorSettingsView}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <!-- クラスの行。潜在心相晶の行では出さない。 -->
                                            <Grid>
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSeasonTalent}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <Rectangle Width="25"
                                                           Height="25"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource MeterWidgetClassColorSettings.ProfessionIconMask}"
                                                           Fill="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}">
                                                    <Rectangle.Effect>
                                                        <DropShadowEffect
                                                            Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                            Opacity="0.5"
                                                            ShadowDepth="0"
                                                            BlurRadius="5" />
                                                    </Rectangle.Effect>
                                                </Rectangle>
                                            </Grid>
                                            <!-- 潜在心相晶の行。 -->
                                            <Grid Visibility="{Binding IsSeasonTalent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Rectangle HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Fill="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}"
                                                           OpacityMask="{Binding SeasonTalentIconMask}">
                                                    <!-- 型の絵は欄いっぱい、不明の行だけクラスアイコンと同じ大きさ。 -->
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                            <Setter Property="Width" Value="27" />
                                                            <Setter Property="Height" Value="27" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Key}" Value="SeasonTalent.Unknown">
                                                                    <Setter Property="Width" Value="25" />
                                                                    <Setter Property="Height" Value="25" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                    <Rectangle.Effect>
                                                        <DropShadowEffect
                                                            Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                            Opacity="0.5"
                                                            ShadowDepth="0"
                                                            BlurRadius="5" />
                                                    </Rectangle.Effect>
                                                </Rectangle>
                                            </Grid>
                                        </Grid>
                                        <Border Style="{StaticResource MeterWidgetClassColorSettings.MeterProfessionIconBackground}"
                                                Background="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}"
                                                Visibility="{Binding DataContext.UsesMeterClassColorIconBackground, RelativeSource={RelativeSource AncestorType={x:Type local:MeterWidgetClassColorSettingsView}}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Rectangle Style="{StaticResource MeterWidgetClassColorSettings.ProfessionIconMask}"
                                                       Fill="White">
                                                <Rectangle.Effect>
                                                    <DropShadowEffect
                                                        Color="Black"
                                                        Opacity="0.5"
                                                        ShadowDepth="2"
                                                        BlurRadius="5" />
                                                </Rectangle.Effect>
                                            </Rectangle>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Colors.Colors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton GroupName="{Binding DataContext.Key, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                 Background="{Binding Brush}"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                 Click="ColorOptionRadioButton_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}"
                                                Style="{StaticResource Button.Text}"
                                                Tag="{Binding Key}"
                                                Click="ColorPickerButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Panel.SettingFieldLast}"
                        Visibility="{Binding HasClassColorOpacity, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_ClassColors_Opacity]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Style="{StaticResource Input.ValueSlider}"
                                    Value="{Binding ClassColorOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding ClassColorOpacity, StringFormat={}{0:0}%}" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
