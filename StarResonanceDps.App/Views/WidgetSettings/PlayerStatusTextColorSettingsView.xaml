<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.PlayerStatusTextColorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        ステータス詳細の行ごとのテキストカラー。行の作りはプレイヤーリストのクラスカラー
        (MeterWidgetClassColorSettingsView)と同じで、左のアイコンを選んだ色で塗る。
        項目と並びは「ステータス」の一覧と同じ。
    -->
    <UserControl.Resources>
        <converters:ColorToBrushConverter x:Key="ColorToBrushConverter" />

        <!-- 最後の行は下の線を引かない(節の枠が閉じる)。 -->
        <Style x:Key="PlayerStatusTextColorSettings.Field"
               TargetType="{x:Type Border}"
               BasedOn="{StaticResource Panel.SettingField}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding TextColorSectionTitle}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <ItemsControl ItemsSource="{Binding TextColors}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PlayerStatusTextColorSettings.Field}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0"
                                           Width="35"
                                           Height="35"
                                           Margin="-4,0,0,0"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="{Binding Colors.SelectedColor, Converter={StaticResource ColorToBrushConverter}}"
                                           OpacityMask="{Binding IconMask}"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                    <Rectangle.Effect>
                                        <DropShadowEffect
                                                Color="{Binding Color, Source={StaticResource Brush.TextPrimary}}"
                                                Opacity="0.5"
                                                ShadowDepth="0"
                                                BlurRadius="5" />
                                    </Rectangle.Effect>
                                </Rectangle>

                                <TextBlock Grid.Column="1"
                                           Margin="8,0,12,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ItemsControl ItemsSource="{Binding Colors.Colors}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <RadioButton GroupName="{Binding DataContext.Key, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                             Background="{Binding Brush}"
                                                             Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                             IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                             Click="ColorOptionRadioButton_Click" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}"
                                            Style="{StaticResource Button.Text}"
                                            Tag="{Binding Key}"
                                            Click="ColorPickerButton_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>
    </StackPanel>
</UserControl>
