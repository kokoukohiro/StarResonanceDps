<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.WidgetWindowSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:viewModels="clr-namespace:StarResonanceDps.App.ViewModels"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!-- スイッチ行の中身は3つとも同じ形なので、ヘッダー文字列だけ差し替えて使う。 -->
        <Style x:Key="WidgetWindowSettings.Label" TargetType="TextBlock">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="WidgetWindowSettings.StateText" TargetType="TextBlock">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Window_Title]}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <StackPanel>
                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource WidgetWindowSettings.Label}"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Window_HideHeaderWhenInactive]}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource Input.Switch}"
                                          IsChecked="{Binding HideHeaderWhenInactive, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource WidgetWindowSettings.StateText}"
                                       Text="{Binding HideHeaderWhenInactiveStateText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- フッターを持たないウィジェットでは出さない。 -->
                <Border Style="{StaticResource Panel.SettingField}"
                        Visibility="{Binding HasFooterSetting, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource WidgetWindowSettings.Label}"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Window_HideFooterWhenInactive]}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource Input.Switch}"
                                          IsChecked="{Binding HideFooterWhenInactive, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource WidgetWindowSettings.StateText}"
                                       Text="{Binding HideFooterWhenInactiveStateText}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 不透明度と拡大率が常に最後の2行。フッターの有無で変わらない。 -->
                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource WidgetWindowSettings.Label}"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Theme_WindowOpacity]}" />

                        <Grid Grid.Column="1" Width="260" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>

                            <Slider Grid.Column="0"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Style="{StaticResource Input.ValueSlider}"
                                    Value="{Binding WindowOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding WindowOpacity, StringFormat={}{0:0}%}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingFieldLast}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource WidgetWindowSettings.Label}"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Theme_WindowScale]}" />

                        <Grid Grid.Column="1" Width="260" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>

                            <!--
                                1刻みでドラッグのたびに窓の大きさを変えると重いので、値を渡すのはつまみを手放したときと、
                                ドラッグ以外の操作のときだけ(ReleaseCommitSliderBehavior)。右の数字はスライダーの値を出し、ドラッグ中もつまみに合わせて動く。
                            -->
                            <Slider x:Name="WindowScaleSlider"
                                    Grid.Column="0"
                                    Minimum="{x:Static viewModels:WidgetSettingsViewModel.WindowScaleSliderMinimum}"
                                    Maximum="{x:Static viewModels:WidgetSettingsViewModel.WindowScaleSliderMaximum}"
                                    TickFrequency="{x:Static viewModels:WidgetSettingsViewModel.WindowScaleSliderStep}"
                                    IsSnapToTickEnabled="True"
                                    Style="{StaticResource Input.ValueSlider}"
                                    Value="{Binding WindowScale, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                    behaviors:ReleaseCommitSliderBehavior.IsEnabled="True" />

                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding Value, ElementName=WindowScaleSlider, StringFormat={}{0:0}%}" />
                        </Grid>
                    </Grid>
                </Border>

            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
