<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.PlayerStatusWidgetDisplaySettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        ステータス詳細の表示設定。スイッチ行の作りはウィンドウの表示設定
        (WidgetWindowSettingsView)と同じ。
    -->
    <UserControl.Resources>
        <Style x:Key="PlayerStatusSettings.Label" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="PlayerStatusSettings.StateText" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_Section_Display_Title]}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <StackPanel>
                <Border Style="{StaticResource Panel.SettingFieldLast}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource PlayerStatusSettings.Label}"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_PlayerStatus_HideInactiveStatusEffects]}" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource Input.Switch}"
                                          IsChecked="{Binding HideInactiveStatusEffects, Mode=TwoWay}" />
                            <TextBlock Style="{StaticResource PlayerStatusSettings.StateText}"
                                       Text="{Binding HideInactiveStatusEffectsStateText}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
