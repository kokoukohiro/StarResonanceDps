<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.MetricElementColorSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StarResonanceDps.App.Views.WidgetSettings"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        スキル詳細の属性カラー。作りはメーターのクラスカラー(MeterWidgetClassColorSettingsView)と同じで、
        行が9属性になる。左のアイコンはバーカラーの背景に載せ、
        アイコンは白で染めて影を付ける(アイコンの実体は純粋な白ではないので、塗りで白にする)。
    -->
    <UserControl.Resources>
        <converters:ClassColorFilterBrushConverter x:Key="ClassColorFilterBrushConverter" />

        <Style x:Key="MetricElementColorSettings.IconBackground"
               TargetType="{x:Type Border}">
            <Setter Property="Width" Value="29" />
            <Setter Property="Height" Value="29" />
            <Setter Property="CornerRadius" Value="{DynamicResource Radius.ButtonInner}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="{Binding SectionTitle}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,12">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 色の行の後ろに4項目が続くので、行はどれも下の線を引く。 -->
                            <Border Style="{StaticResource Panel.SettingField}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource MetricElementColorSettings.IconBackground}">
                                        <Border.Background>
                                            <MultiBinding Converter="{StaticResource ClassColorFilterBrushConverter}">
                                                <Binding Path="Colors.SelectedColor" />
                                                <Binding Path="DataContext.FilterEnabled" RelativeSource="{RelativeSource AncestorType={x:Type local:MetricElementColorSettingsView}}" />
                                                <Binding Path="DataContext.FilterColors.SelectedColor" RelativeSource="{RelativeSource AncestorType={x:Type local:MetricElementColorSettingsView}}" />
                                                <Binding Path="DataContext.FilterStrength" RelativeSource="{RelativeSource AncestorType={x:Type local:MetricElementColorSettingsView}}" />
                                            </MultiBinding>
                                        </Border.Background>
                                        <Rectangle Width="25"
                                                   Height="25"
                                                   Fill="White"
                                                   OpacityMask="{Binding IconMask}"
                                                   Effect="{StaticResource Effect.ProfessionIconShadow}"
                                                   RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Border>

                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               Text="{Binding DisplayName}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="14"
                                               FontWeight="SemiBold" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding Colors.Colors}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <RadioButton GroupName="{Binding DataContext.Key, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                                 Background="{Binding Brush}"
                                                                 Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                                 IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                                 Click="ColorOptionRadioButton_Click" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}"
                                                Style="{StaticResource Button.Text}"
                                                Tag="{Binding Key}"
                                                Click="ColorPickerButton_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource Panel.SettingField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_ElementColors_Opacity]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Style="{StaticResource Input.ValueSlider}"
                                    Value="{Binding ColorOpacity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding ColorOpacity, StringFormat={}{0:0}%}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border>
                    <Border.Style>
                        <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.SettingField}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsFilterOptions}" Value="False">
                                    <Setter Property="BorderThickness" Value="0" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_ElementColors_Filter]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <ToggleButton Style="{StaticResource Input.Switch}"
                                          IsChecked="{Binding FilterEnabled, Mode=TwoWay}" />
                            <TextBlock Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       MinWidth="28"
                                       Text="{Binding FilterStateText}"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingField}"
                        Visibility="{Binding ShowsFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_ClassColors_FilterColor]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding FilterColors.Colors}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton GroupName="ElementColorFilter"
                                                     Background="{Binding Brush}"
                                                     Style="{StaticResource Button.ColorSwatchRadioButton}"
                                                     IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                     Click="ColorOptionRadioButton_Click" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_SelectColor]}"
                                    Style="{StaticResource Button.Text}"
                                    Click="FilterColorPickerButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Panel.SettingFieldLast}"
                        Visibility="{Binding ShowsFilterOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Settings_ClassColors_FilterStrength]}"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="14"
                                   FontWeight="SemiBold" />

                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="35" />
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0"
                                    IsSnapToTickEnabled="True"
                                    TickFrequency="1"
                                    Style="{StaticResource Input.ValueSlider}"
                                    Value="{Binding FilterStrength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Grid.Column="2"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Text="{Binding FilterStrength, StringFormat={}{0:0}%}" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ContentControl>
    </StackPanel>
</UserControl>
