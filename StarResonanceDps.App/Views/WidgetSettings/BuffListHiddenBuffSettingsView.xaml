<UserControl x:Class="StarResonanceDps.App.Views.WidgetSettings.BuffListHiddenBuffSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        一覧に出さないバフ。見出しと説明はいつも出し、枠は非表示のバフがあるときだけ出す。
        行は左にアイコンと名前、右に削除ボタン。
    -->
    <StackPanel>
        <TextBlock Text="{Binding HiddenBuffSectionTitle}"
                   Foreground="{DynamicResource Brush.TextPrimary}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBlock Text="{Binding HiddenBuffSectionDescription}"
                   Foreground="{DynamicResource Brush.TextSecondary}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10" />

        <ContentControl Style="{StaticResource Panel.SettingSection}"
                        Margin="0,0,0,12"
                        Visibility="{Binding HasHiddenBuffs, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ItemsControl ItemsSource="{Binding HiddenBuffItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Border.Style>
                                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.SettingField}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLast}" Value="True">
                                            <Setter Property="BorderThickness" Value="0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 枠は一覧の行と同じ 30×30。モジュール効果の絵だけ枠の中で小さく出す(一覧の行と同じ値)。 -->
                                <Grid Grid.Column="0"
                                      Width="30"
                                      Height="30"
                                      Margin="-1,0,0,0"
                                      VerticalAlignment="Center">
                                    <Image Source="{Binding IconPath, TargetNullValue={x:Null}}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsModuleEffectIcon}" Value="True">
                                                        <Setter Property="Width" Value="26" />
                                                        <Setter Property="Height" Value="26" />
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <TranslateTransform X="-1" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>

                                    <!-- 絵のパスはあるのにファイルが無いバフははてな(一覧の行と同じ作り)。大きさは絵の枠いっぱい。 -->
                                    <Rectangle Fill="White"
                                               Effect="{StaticResource Effect.ProfessionIconShadow}">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                                        </Rectangle.OpacityMask>
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowsUnknownIcon}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <!-- 絵が Icons.xaml の絵(装備効果)なら、白く塗った面をその絵で型抜きする(一覧の行と同じ作り、左へ 1 ずらすのも同じ)。 -->
                                    <Rectangle Fill="White"
                                               OpacityMask="{Binding IconMask}"
                                               Effect="{StaticResource Effect.ProfessionIconShadow}">
                                        <Rectangle.RenderTransform>
                                            <TranslateTransform X="-1" />
                                        </Rectangle.RenderTransform>
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconMask}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Margin="10,0,12,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding DisplayName}"
                                           Foreground="{DynamicResource Brush.TextPrimary}"
                                           FontSize="14"
                                           FontWeight="SemiBold" />

                                <Button Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Delete]}"
                                        Style="{StaticResource Button.Text}"
                                        Command="{Binding RemoveCommand}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ContentControl>
    </StackPanel>
</UserControl>
