<UserControl x:Class="StarResonanceDps.App.Views.ManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
             xmlns:views="clr-namespace:StarResonanceDps.App.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid Background="Transparent"
          behaviors:FocusBehavior.ClearFocusOnBackgroundClick="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="ManagerContentExternalScrollBarColumn" Width="16" />
        </Grid.ColumnDefinitions>

        <ContentControl Grid.Column="0" Margin="8,1,6,8" Style="{StaticResource Panel.Root}">
            <Grid Margin="10">
                <StackPanel>
                    <RadioButton x:Name="WidgetsNavigationButton"
                                 GroupName="ManagerNavigation"
                                 Style="{DynamicResource RadioButton.SidebarNavigation}"
                                 Checked="WidgetsNavigationButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Style="{DynamicResource Icon.Fill}"
                                Data="{DynamicResource Icon.Widget}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Navigation_Widgets]}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="PluginsNavigationButton"
                                 GroupName="ManagerNavigation"
                                 Style="{DynamicResource RadioButton.SidebarNavigation}"
                                 Checked="PluginsNavigationButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Style="{DynamicResource Icon.Stroke}"
                                Data="{DynamicResource Icon.Plugin}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Navigation_Plugins]}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="LogsNavigationButton"
                                 GroupName="ManagerNavigation"
                                 Style="{DynamicResource RadioButton.SidebarNavigation}"
                                 Checked="LogsNavigationButton_Checked">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Style="{DynamicResource Icon.Stroke}"
                                Data="{DynamicResource Icon.Log}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Navigation_Logs]}" />
                        </StackPanel>
                    </RadioButton>
                    <Button Style="{DynamicResource Button.Sidebar}"
                            Click="HelpButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <Path
                                Style="{DynamicResource Icon.Fill}"
                                Data="{DynamicResource Icon.Help}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Navigation_Help]}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Button VerticalAlignment="Bottom" Margin="0" Style="{DynamicResource Button.Sidebar}" Click="SettingsButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path
                            Style="{DynamicResource Icon.Fill}"
                            Data="{DynamicResource Icon.Settings}" />
                        <TextBlock
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Navigation_Settings]}" />
                    </StackPanel>
                </Button>
            </Grid>
        </ContentControl>

        <ContentControl Grid.Column="1" Margin="0,1,0,8" Style="{StaticResource Panel.Root}">
            <Grid>
                <Grid x:Name="WidgetContent" Margin="24,20,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="160" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <controls:SearchBox Grid.Column="0"
                                            Placeholder="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Manager_WidgetSearch_Placeholder]}"
                                            Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <ComboBox Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Width="140"
                                  Style="{StaticResource Input.SelectBox}"
                                  Tag="{DynamicResource Icon.Sort}"
                                  SelectedIndex="{Binding WidgetSortIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Manager_WidgetSort_Default]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Manager_WidgetSort_Name]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Manager_WidgetSort_Favorite]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Manager_WidgetSort_RunningState]}" />
                            <ComboBoxItem Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Manager_WidgetSort_Pinned]}" />
                        </ComboBox>

                        <ComboBox
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Style="{StaticResource Input.IconOnlySelectBox}"
                            Tag="{DynamicResource Icon.MoreVertical}"
                            SelectedIndex="{Binding BulkActionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                            <ComboBoxItem Style="{StaticResource Input.ActionComboBoxItem}" Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Manager_WidgetAction_StartAllFavorites]}" />
                            <ComboBoxItem Style="{StaticResource Input.ActionComboBoxItem}" Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Manager_WidgetAction_StopAll]}" />
                            <ComboBoxItem Style="{StaticResource Input.ActionComboBoxItem}" Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Manager_WidgetAction_PinAllRunning]}" />
                            <ComboBoxItem Style="{StaticResource Input.ActionComboBoxItem}" Content="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Manager_WidgetAction_UnpinAll]}" />
                        </ComboBox>
                    </Grid>

                    <ScrollViewer x:Name="WidgetListScrollViewer"
                                  Grid.Row="2"
                                  Style="{StaticResource ScrollViewer.WidgetList}"
                                  VerticalScrollBarVisibility="Hidden"
                                  ScrollChanged="WidgetListScrollViewer_ScrollChanged"
                                  SizeChanged="WidgetListScrollViewer_SizeChanged">
                        <ItemsControl x:Name="WidgetItemsControl"
                                      ItemsSource="{Binding Widgets}"
                                      SizeChanged="WidgetItemsControl_SizeChanged">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:WidgetListItem />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <views:PluginsView x:Name="PluginsContent" Visibility="Collapsed" />
                <views:LogsView x:Name="LogsContent" Visibility="Collapsed" />
            </Grid>
        </ContentControl>

        <ScrollBar x:Name="ManagerContentExternalScrollBar"
                   Grid.Column="2"
                   Margin="5,4,5,8"
                   Orientation="Vertical"
                   Style="{StaticResource ScrollBar.WidgetList}"
                   ValueChanged="ManagerContentExternalScrollBar_ValueChanged" />
    </Grid>
</UserControl>
