<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerEquipmentWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="PlayerEquipmentWidgetView_Loaded"
             SizeChanged="PlayerEquipmentWidgetView_SizeChanged"
             DataContextChanged="PlayerEquipmentWidgetView_DataContextChanged">
    <UserControl.Resources>
        <!--
            行内テキストの共通スタイル。作りはバフ一覧の行と同じで、左寄せ・収まらないぶんは省略記号で切る。
        -->
        <Style x:Key="EquipmentList.RowText" TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 装備レベル。作りはバフ一覧の残り時間と同じで、行の右端の列に右寄せで置く。 -->
        <Style x:Key="EquipmentList.LevelText" TargetType="TextBlock" BasedOn="{StaticResource EquipmentList.RowText}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!-- 装備の文字。品質の色がある行だけ色を替え、無い行(表に無い装備・装備なし・不明)はふつうの色のまま。 -->
        <Style x:Key="EquipmentList.NameText" TargetType="TextBlock" BasedOn="{StaticResource EquipmentList.RowText}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasTextBrush}" Value="True">
                    <Setter Property="Foreground" Value="{Binding TextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 余白はバフ一覧・メーターと同じ(左5・右0)。ホバーの枠が同じ位置で始まる。 -->
        <ScrollViewer x:Name="EquipmentScrollViewer"
                      Margin="5,5,0,5"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      CanContentScroll="False"
                      ScrollChanged="EquipmentScrollViewer_ScrollChanged">
            <ItemsControl ItemsSource="{Binding EquipmentSlots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                            行の高さとホバーの作りはバフ一覧の行と同じ。
                            TIPS はスキル詳細の行と同じで、押したときは開き直す
                            (WPF は押すと閉じ、カーソルを外へ出すまで出し直さない)。
                        -->
                        <Button Height="31"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Click="EquipmentRow_Click"
                                MouseLeave="EquipmentRow_MouseLeave"
                                ToolTipService.IsEnabled="{Binding HasToolTip}"
                                Tag="{Binding DataContext.PlayerWidget, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                            <!-- TIPS は行に1つ。基礎のステータスを全部、続けて進化のステータスを全部。 -->
                            <Button.ToolTip>
                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                         Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                    <ItemsControl ItemsSource="{Binding ToolTipLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <!--
                                                        ステータスのアイコン。ステータス詳細と同じ染め方と影で、塗りは行の文字と同じ色。
                                                        アイコンの無い行(一時属性・バフ)は欄だけ空けて、文字の位置をそろえる。
                                                    -->
                                                    <Rectangle Width="20"
                                                               Height="20"
                                                               Margin="0,0,4,0"
                                                               VerticalAlignment="Center"
                                                               Fill="{Binding Foreground, ElementName=LineText}"
                                                               OpacityMask="{Binding IconMask}"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Effect="{StaticResource Effect.ProfessionIconShadow}">
                                                        <Rectangle.Style>
                                                            <Style TargetType="Rectangle">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasIcon}" Value="False">
                                                                        <Setter Property="Visibility" Value="Hidden" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Rectangle.Style>
                                                    </Rectangle>

                                                    <TextBlock x:Name="LineText"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding Text}">
                                                        <TextBlock.Style>
                                                            <!-- 色がある行(無効のシーズン強度)だけ色を替える。 -->
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="FontSize" Value="12" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding HasTextBrush}" Value="True">
                                                                        <Setter Property="Foreground" Value="{Binding TextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ToolTip>
                            </Button.ToolTip>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid SnapsToDevicePixels="True">
                                                    <Border x:Name="InteractionBackground"
                                                            Background="{Binding DataContext.WidgetWindowPalette.WidgetWindowScrollThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            Visibility="Collapsed">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.NonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                                        <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.ActiveNonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>

                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 部位のアイコン。属性アイコンと同じ染め方で、塗りは白、影はクラスアイコンと同じ。 -->
                                <Rectangle Grid.Column="0"
                                           Width="30"
                                           Height="30"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Fill="White"
                                           OpacityMask="{Binding IconMask}"
                                           Effect="{StaticResource Effect.ProfessionIconShadow}"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                <TextBlock Grid.Column="1"
                                           Margin="6,0,6,0"
                                           Style="{StaticResource EquipmentList.NameText}"
                                           Text="{Binding Text}" />

                                <TextBlock Grid.Column="2"
                                           Margin="0,0,8,0"
                                           Style="{StaticResource EquipmentList.LevelText}"
                                           Text="{Binding LevelText}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
