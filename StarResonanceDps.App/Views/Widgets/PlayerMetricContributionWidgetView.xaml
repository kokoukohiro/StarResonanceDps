<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerMetricContributionWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:viewModels="clr-namespace:StarResonanceDps.App.ViewModels"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="PlayerMetricContributionWidgetView_Loaded"
             SizeChanged="PlayerMetricContributionWidgetView_SizeChanged">
    <UserControl.Resources>
        <!-- 文字の大きさと太さはメーターの行に合わせる(FontSize 12 / SemiBold)。 -->
        <Style x:Key="MetricSkillStatisticText"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--
            属性列のアイコン。大きさの違う画像を正方形の枠に中央寄せで入れる。
            クラスアイコンと同じ染め方で、塗りは白(行の色は下のバーが持つ)。影はクラスアイコンと同じ。
            TIPS は欄そのものに1つ付けるので、アイコンには持たせない。

            2種類以上の属性を含む行は、中央の縦線で枠を2等分し、
            1位を左、2位を右に切り抜いて重ねる。1種類だけの行は切り抜かない。
        -->
        <DataTemplate DataType="{x:Type viewModels:MetricElementIconSegment}">
            <Grid Width="25"
                  Height="25"
                  Margin="0,0,1,0"
                  Background="Transparent">
                <Rectangle Fill="White"
                           OpacityMask="{Binding PrimaryMask}"
                           Effect="{StaticResource Effect.ProfessionIconShadow}"
                           RenderOptions.BitmapScalingMode="HighQuality">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSecondary}" Value="True">
                                    <Setter Property="Clip" Value="M0,0 L12.5,0 L12.5,25 L0,25 Z" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
                <Rectangle Fill="White"
                           OpacityMask="{Binding SecondaryMask}"
                           Clip="M12.5,0 L25,0 L25,25 L12.5,25 Z"
                           Effect="{StaticResource Effect.ProfessionIconShadow}"
                           RenderOptions.BitmapScalingMode="HighQuality">
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSecondary}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid>
            <ScrollViewer x:Name="ContributionScrollViewer"
                          Margin="5,2,0,5"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          CanContentScroll="False"
                          ScrollChanged="ContributionScrollViewer_ScrollChanged">
                <ItemsControl ItemsSource="{Binding SkillEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                                行の高さとホバーの作りはメーターの行に合わせてある。
                                Button の ControlTemplate でないとホバーの背景を同じ形で出せない。
                                押したときは TIPS を開き直す(WPF は押すと閉じ、カーソルを外へ出すまで出し直さない)。
                            -->
                            <Button Height="31"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    IsTabStop="False"
                                    IsHitTestVisible="True"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    Click="SkillRow_Click"
                                    MouseLeave="SkillRow_MouseLeave"
                                    Tag="{Binding DataContext.PlayerWidget, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                                <!-- TIPS は行(ホバーの範囲)に1つ。属性の内訳とタイプの内訳を出す。 -->
                                <Button.ToolTip>
                                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                        <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                                   FontSize="12"
                                                   Text="{Binding RowToolTipText}" />
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid SnapsToDevicePixels="True">
                                                        <Border x:Name="InteractionBackground"
                                                                Background="{Binding DataContext.PlayerWidget.WidgetWindowPalette.WidgetWindowScrollThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                Visibility="Collapsed">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                    <Setter Property="Opacity" Value="{Binding DataContext.PlayerWidget.WidgetWindowPalette.NonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                                            <Setter Property="Opacity" Value="{Binding DataContext.PlayerWidget.WidgetWindowPalette.ActiveNonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                          Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>

                                <Grid SnapsToDevicePixels="True"
                                      UseLayoutRounding="True">
                                <!--
                                    行の下敷きのバー。作りはメーターと同じで、色は属性の割合で混ぜたもの。
                                    属性の内訳が無い行(内訳を溜める前の履歴)は色を作れないので出さない。
                                -->
                                <Grid x:Name="BarArea"
                                      Margin="1"
                                      ClipToBounds="True">
                                    <Border Height="29"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            Background="{Binding BarBrush}"
                                            Visibility="{Binding HasBar, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            behaviors:BarWidthAnimationBehavior.AreaWidth="{Binding ActualWidth, ElementName=BarArea}"
                                            behaviors:BarWidthAnimationBehavior.Ratio="{Binding BarRatio}" />
                                </Grid>

                                <Grid ClipToBounds="True">
                                    <!-- 番号・アイコン・名前の幅と余白はメーターの行と同じ。右の3つはメーターに無いので同じ書式で並べる。 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="18" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" MinWidth="30" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Text="{Binding NoText}" />
                                    <!-- 属性アイコン。1属性なら1枚、2種類以上なら上位2つを左右に切り抜いて重ねる。 -->
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               behaviors:TextSegmentsBehavior.Segments="{Binding ElementSegments}" />
                                    <TextBlock Grid.Column="3"
                                               Margin="5,0,6,0"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Text="{Binding SkillName}" />
                                    <!-- 値はメーターと同じ1つの欄「総量 (秒間値) 割合%」。 -->
                                    <TextBlock Grid.Column="4"
                                               Margin="4,0,5,0"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Text="{Binding ValueText}"
                                               TextAlignment="Right" />
                                </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>
</UserControl>
