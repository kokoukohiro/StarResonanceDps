<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerMetricContributionWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:viewModels="clr-namespace:StarResonanceDps.App.ViewModels"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="PlayerMetricContributionWidgetView_Loaded"
             SizeChanged="PlayerMetricContributionWidgetView_SizeChanged">
    <UserControl.Resources>
        <!-- 文字の大きさと太さはメーターの行に合わせる(FontSize 12 / SemiBold)。 -->
        <Style x:Key="MetricSkillStatisticText"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="MetricSkillStatisticHeaderText"
               TargetType="TextBlock"
               BasedOn="{StaticResource MetricSkillStatisticText}">
            <Setter Property="Opacity" Value="0.8" />
        </Style>

        <!--
            属性列のアイコン。大きさの違う画像を正方形の枠に中央寄せで入れる。
            被ダメログの属性アイコンと同じで、影は付けない。
            TIPS は欄そのものに1つ付けるので、アイコンには持たせない。
        -->
        <DataTemplate DataType="{x:Type viewModels:MetricElementIconSegment}">
            <Grid Width="16"
                  Height="16"
                  Margin="0,0,1,0"
                  Background="Transparent">
                <Image Source="{Binding Icon}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="0,5,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 左の余白は下の ScrollViewer(メーターと同じ 5)に合わせる。合わないと列が縦にずれる。 -->
        <Grid Grid.Row="0"
              Margin="5,0,5,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <!-- 属性は2つぶんの幅。3つ以上混ざる行は省略記号で切れる -->
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="*" MinWidth="30" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource MetricSkillStatisticHeaderText}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_No]}" />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource MetricSkillStatisticHeaderText}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_Element]}" />
            <TextBlock Grid.Column="2"
                       Style="{StaticResource MetricSkillStatisticHeaderText}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_DamageMode]}" />
            <TextBlock Grid.Column="3"
                       Style="{StaticResource MetricSkillStatisticHeaderText}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_SkillName]}" />
            <TextBlock Grid.Column="4"
                       HorizontalAlignment="Right"
                       Style="{StaticResource MetricSkillStatisticHeaderText}"
                       Text="{Binding TotalValueHeader}" />
            <TextBlock Grid.Column="5"
                       HorizontalAlignment="Right"
                       Style="{StaticResource MetricSkillStatisticHeaderText}"
                       Text="{Binding EncounterPerSecondHeader}" />
            <TextBlock Grid.Column="6"
                       HorizontalAlignment="Right"
                       Style="{StaticResource MetricSkillStatisticHeaderText}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_HitCount]}" />
            <TextBlock Grid.Column="7"
                       HorizontalAlignment="Right"
                       Style="{StaticResource MetricSkillStatisticHeaderText}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_CritRate]}" />
            <TextBlock Grid.Column="8"
                       HorizontalAlignment="Right"
                       Style="{StaticResource MetricSkillStatisticHeaderText}"
                       Text="{Binding ShareHeader}" />
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="ContributionScrollViewer"
                          Margin="5,2,0,5"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          CanContentScroll="False"
                          ScrollChanged="ContributionScrollViewer_ScrollChanged">
                <ItemsControl ItemsSource="{Binding SkillEntries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!--
                                行の高さとホバーの作りはメーターの行に合わせてある。
                                押しても何も起きないが、Button の ControlTemplate でないと
                                ホバーの背景を同じ形で出せない。
                            -->
                            <Button Height="31"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Focusable="False"
                                    IsTabStop="False"
                                    IsHitTestVisible="True"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Grid SnapsToDevicePixels="True">
                                                        <Border x:Name="InteractionBackground"
                                                                Background="{Binding DataContext.PlayerWidget.WidgetWindowPalette.WidgetWindowScrollThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                Visibility="Collapsed">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Opacity" Value="{Binding DataContext.PlayerWidget.WidgetWindowPalette.NonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                                            <Setter Property="Opacity" Value="{Binding DataContext.PlayerWidget.WidgetWindowPalette.ActiveNonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                          Content="{TemplateBinding Content}"
                                                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>

                                <Grid SnapsToDevicePixels="True"
                                      UseLayoutRounding="True">
                                <!--
                                    行の下敷きのバー。作りはメーターと同じで、色は属性の割合で混ぜたもの。
                                    属性の内訳が無い行(内訳を溜める前の履歴)は色を作れないので出さない。
                                -->
                                <Grid x:Name="BarArea"
                                      Margin="1"
                                      ClipToBounds="True">
                                    <Border Height="29"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            Background="{Binding BarBrush}"
                                            Visibility="{Binding HasBar, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            behaviors:BarWidthAnimationBehavior.AreaWidth="{Binding ActualWidth, ElementName=BarArea}"
                                            behaviors:BarWidthAnimationBehavior.Ratio="{Binding BarRatio}" />
                                </Grid>

                                <Grid ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" MinWidth="30" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="52" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Margin="10,0,4,0"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Text="{Binding NoText}" />
                                    <!-- アイコンが「/」で並ぶ。中身は ViewModel が組む。割合は欄の TIPS に出す。 -->
                                    <TextBlock Grid.Column="1"
                                               Margin="2,0,6,0"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Tag="{Binding DataContext.PlayerWidget, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               behaviors:TextSegmentsBehavior.Segments="{Binding ElementSegments}">
                                        <TextBlock.ToolTip>
                                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                     Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                                <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                                           FontSize="12"
                                                           Text="{Binding ElementToolTipText}" />
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Grid.Column="2"
                                               Margin="2,0,6,0"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Tag="{Binding DataContext.PlayerWidget, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                               Text="{Binding DamageModeText}">
                                        <TextBlock.ToolTip>
                                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                     Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                                <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                                           FontSize="12"
                                                           Text="{Binding DamageModeToolTipText}" />
                                            </ToolTip>
                                        </TextBlock.ToolTip>
                                    </TextBlock>
                                    <TextBlock Grid.Column="3"
                                               Margin="2,0,6,0"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Text="{Binding SkillName}" />
                                    <TextBlock Grid.Column="4"
                                               Margin="4,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Text="{Binding TotalValueText}" />
                                    <TextBlock Grid.Column="5"
                                               Margin="4,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Text="{Binding EncounterPerSecondText}" />
                                    <TextBlock Grid.Column="6"
                                               Margin="4,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Text="{Binding HitCountText}" />
                                    <TextBlock Grid.Column="7"
                                               Margin="4,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Text="{Binding CritRateText}" />
                                    <TextBlock Grid.Column="8"
                                               Margin="4,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource MetricSkillStatisticText}"
                                               Text="{Binding ShareText}" />
                                </Grid>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       Text="{Binding NoDataText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource Text.WidgetWindow}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasMetricData}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
