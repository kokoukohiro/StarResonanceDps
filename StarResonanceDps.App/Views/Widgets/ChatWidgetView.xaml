<UserControl x:Class="StarResonanceDps.App.Views.Widgets.ChatWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:viewModels="clr-namespace:StarResonanceDps.App.ViewModels"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="ChatWidgetView_Loaded"
             SizeChanged="ChatWidgetView_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="Chat.LineText" TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,1,0,1" />
        </Style>

        <!-- 本文の URL。下線と手の形のカーソル(土台 Hyperlink.Base)で押せることを示す。色はマウスを乗せても変えない。 -->
        <Style x:Key="Chat.Link" TargetType="Hyperlink" BasedOn="{StaticResource Hyperlink.Base}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="#DDDDDD" />
        </Style>

        <!-- 本文に混ぜる顔文字。書体の色の層で描き、大きさと色は行の文字のまま。選んだ文字とコピーでは絵文字の文字として数える。 -->
        <DataTemplate DataType="{x:Type viewModels:ChatEmojiSegment}">
            <controls:ColorEmoji Emoji="{Binding Emoji}"
                                 Margin="1,0,1,0"
                                 behaviors:TextRowsSelectionBehavior.Text="{Binding Emoji}" />
        </DataTemplate>

        <!-- スタンプ。選んだ文字とコピーでは「[スタンプ]」の文字として数える。 -->
        <DataTemplate DataType="{x:Type viewModels:ChatStickerSegment}">
            <Image Width="70"
                   Height="70"
                   Source="{Binding IconPath}"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   behaviors:TextRowsSelectionBehavior.Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Chat_Sticker]}" />
        </DataTemplate>

        <!-- 右クリックのメニュー。見た目はタイムラインのメニューと同じで、色と不透明度は窓のパレット(ビューモデルの Widget)から取る。項目は1つなので角は4つとも丸める。 -->
        <CornerRadius x:Key="Menu.WidgetWindowChatContextMenuItem.SingleCornerRadius">5</CornerRadius>

        <Style x:Key="Menu.WidgetWindowChatContextMenu"
               TargetType="{x:Type ContextMenu}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowMenuSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate.WidgetWindowMenuText">
            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="Menu.WidgetWindowChatContextMenuItem"
               TargetType="{x:Type MenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DataTemplate.WidgetWindowMenuText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowChatContextMenuItem.SingleCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Background="{Binding Widget.WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                                    CornerRadius="{TemplateBinding Tag}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!--
        行はログアウトまで増え続けるので仮想化する(作りはタイムラインと同じ)。仮想化はリスト自身のテンプレートの中に
        ScrollViewer が無いと効かない。横のスクロールは止めて、本文は窓の幅で折り返す。
        文字は行をまたいで選べる(TextRowsSelectionBehavior。部品は名前・時刻・本文、選んだ文字の地)。
        選んだ文字は右クリックの「コピー」か、窓がアクティブなら Ctrl+C で文字にする。リンクの上で押したときは選ばずにリンクを開く。
    -->
    <ItemsControl x:Name="ChatItemsControl"
                  Margin="8,4,0,4"
                  ItemsSource="{Binding Entries}"
                  Background="Transparent"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  behaviors:TextRowsSelectionBehavior.PartElementNames="SenderNameText,TimeText,BodyText"
                  behaviors:TextRowsSelectionBehavior.HighlightElementName="SelectionHighlight"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel">
        <ItemsControl.ContextMenu>
            <ContextMenu Style="{StaticResource Menu.WidgetWindowChatContextMenu}">
                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Copy]}"
                          Command="{x:Static ApplicationCommands.Copy}"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                          Style="{StaticResource Menu.WidgetWindowChatContextMenuItem}" />
            </ContextMenu>
        </ItemsControl.ContextMenu>
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer x:Name="ChatScrollViewer"
                              Background="{TemplateBinding Background}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              CanContentScroll="True"
                              Focusable="False">
                    <ItemsPresenter />
                </ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Grid Margin="0,2,0,2"
                      Background="Transparent">
                    <!--
                        選んだ文字の地。形は TextRowsSelectionBehavior が決める(画面の文字の1行ごとの四角)。地の形で行の大きさが変わらないよう Canvas に入れる。
                        色はタイムラインと同じ(窓のパレット、不透明度はメニューと同じ)。文字の後ろに置く。
                    -->
                    <Canvas IsHitTestVisible="False">
                        <Path x:Name="SelectionHighlight"
                              Fill="{Binding Widget.WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                              Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                    </Canvas>

                    <!-- 1段目に名前と時刻、2段目から本文。折り返した本文も本文の左端から続ける。 -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="SenderNameText"
                                       Style="{StaticResource Chat.LineText}"
                                       Foreground="{Binding SenderNameBrush}"
                                       Text="{Binding SenderName}" />
                            <TextBlock x:Name="TimeText"
                                       Margin="6,1,0,1"
                                       Style="{StaticResource Chat.LineText}"
                                       Foreground="{Binding TimeBrush}"
                                       Text="{Binding TimeText}" />
                        </StackPanel>

                        <TextBlock x:Name="BodyText"
                                   Style="{StaticResource Chat.LineText}"
                                   Foreground="{Binding MessageBrush}"
                                   TextWrapping="Wrap"
                                   behaviors:TextSegmentsBehavior.LinkStyle="{StaticResource Chat.Link}"
                                   behaviors:TextSegmentsBehavior.Segments="{Binding Segments}" />
                    </StackPanel>
                </Grid>
                <!-- 名前が無い行は、時刻を本文の左端にそろえる。 -->
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding SenderName}" Value="">
                        <Setter TargetName="TimeText" Property="Margin" Value="0,1,0,1" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
