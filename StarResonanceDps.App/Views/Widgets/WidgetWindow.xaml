<Window x:Class="StarResonanceDps.App.Views.Widgets.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
        Title="{Binding HeaderText, RelativeSource={RelativeSource Self}}"
        Icon="pack://application:,,,/Assets/Images/ApplicationIcon.ico"
        behaviors:WindowWorkingAreaBehavior.ConstrainMaximizeToWorkingArea="True"
        Width="340"
        Height="200"
        MinWidth="240"
        MinHeight="100"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource Font.ProjectDefault}"
        Typography.NumeralAlignment="Tabular">

    <Grid x:Name="WindowRoot">
        <Border x:Name="WidgetWindowFrame"
                Style="{StaticResource Panel.WidgetWindowFrame}">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="FrameHeaderRow" Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="WidgetFrameScrollBarColumn" Width="16" />
                </Grid.ColumnDefinitions>

                <Image Grid.RowSpan="3"
                       Grid.ColumnSpan="2"
                       Source="{Binding BackgroundImagePath}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <Grid x:Name="FrameHeaderChrome"
                      Grid.Row="0"
                      Grid.ColumnSpan="2">
                    <Border BorderBrush="{Binding WidgetWindowPalette.WidgetWindowDividerBrush}" BorderThickness="0,0,0,1" />

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <ContentControl x:Name="WidgetHeaderChromeActionsHost"
                                        Width="{Binding ActualWidth, ElementName=WidgetHeaderActionsHost}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        IsHitTestVisible="False" />

                        <ContentControl Width="{Binding ActualWidth, ElementName=CloseButton}"
                                        Style="{StaticResource ContentControl.WidgetWindowHeaderGlyph}"
                                        Content="&#xE8BB;" />
                    </StackPanel>
                </Grid>

                <ScrollBar x:Name="WidgetContentScrollBar"
                           Grid.Row="1"
                           Grid.Column="1"
                           Width="6"
                           Margin="5"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Background="{Binding WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                           Cursor="Arrow"
                           IsTabStop="False"
                           Orientation="Vertical"
                           Style="{StaticResource ScrollBar.WidgetWindow}"
                           Visibility="Collapsed" />

                <Border x:Name="WidgetFooterFrame"
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Height="30"
                        BorderBrush="{Binding WidgetWindowPalette.WidgetWindowDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ContentHeaderRow" Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="WidgetContentScrollBarColumn" Width="16" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="WidgetHeader"
                  Grid.Row="0"
                  Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Margin="10,0,8,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource Text.WidgetWindow}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                </Border>

                <ContentControl x:Name="WidgetHeaderActionsHost"
                                Grid.Column="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Style="{StaticResource Button.WidgetWindowHeaderIcon}"
                        Click="CloseButton_Click" />
            </Grid>

            <ContentControl x:Name="WidgetContentHost"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <ContentControl x:Name="WidgetFooterHost"
                            Grid.Row="2"
                            Grid.ColumnSpan="2"
                            Height="30"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
