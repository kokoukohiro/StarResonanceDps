<Window x:Class="StarResonanceDps.App.Views.Widgets.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
        Title="{Binding DisplayName}"
        Icon="/Assets/Images/ApplicationIcon.ico"
        behaviors:WindowWorkingAreaBehavior.ConstrainMaximizeToWorkingArea="True"
        Width="340"
        Height="200"
        MinWidth="240"
        MinHeight="100"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <!--
            This layer owns every non-text element. Its parent Border applies the configured
            opacity once after the opaque surface and divider have been composited together.
        -->
        <Border Style="{StaticResource Panel.WidgetWindowFrame}"
                IsHitTestVisible="False">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="35" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Border BorderBrush="{Binding WidgetWindowPalette.WidgetWindowDividerBrush}" BorderThickness="0,0,0,1" />

                    <!-- ×の表示。背景・分割線と同じOpacityレイヤー内で描画する。 -->
                    <Grid Width="35"
                          Height="35"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center">
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{Binding WidgetWindowPalette.WidgetWindowCloseBrush}"
                                   Text="&#xE8BB;" />
                    </Grid>
                </Grid>

                <!-- Future non-text widget body UI belongs in this layer. -->
                <Grid Grid.Row="1" />
            </Grid>
        </Border>

        <!-- Text and the close icon remain fully opaque. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="35" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Margin="12,0,8,0"
                               VerticalAlignment="Center"
                               Foreground="{Binding WidgetWindowPalette.WidgetWindowTextBrush}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding DisplayName}" />
                </Border>

                <Button Grid.Column="1"
                        Style="{StaticResource Button.WidgetWindowClose}"
                        Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</Window>
