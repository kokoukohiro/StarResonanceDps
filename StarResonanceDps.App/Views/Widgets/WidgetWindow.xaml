<Window x:Class="StarResonanceDps.App.Views.Widgets.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
        xmlns:models="clr-namespace:StarResonanceDps.App.Models.Widgets"
        Title="{Binding HeaderText, RelativeSource={RelativeSource Self}}"
        Icon="pack://application:,,,/Assets/Images/ApplicationIcon.ico"
        behaviors:WindowWorkingAreaBehavior.ConstrainMaximizeToWorkingArea="True"
        Width="340"
        Height="200"
        MinWidth="240"
        MinHeight="60"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{StaticResource Font.ProjectDefault}"
        Typography.NumeralAlignment="Tabular">

    <Grid x:Name="WindowRoot">
        <Border x:Name="WidgetWindowFrame"
                Style="{StaticResource Panel.WidgetWindowFrame}">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="FrameHeaderRow" Height="30" />
                    <RowDefinition Height="*" />
                    <RowDefinition x:Name="FrameHorizontalScrollBarRow" Height="0" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="WidgetFrameScrollBarColumn" Width="16" />
                </Grid.ColumnDefinitions>

                <Image Grid.RowSpan="4"
                       Grid.ColumnSpan="2"
                       Source="{Binding BackgroundImagePath}"
                       Stretch="UniformToFill"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasBackgroundImage}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <Grid x:Name="FrameHeaderChrome"
                      Grid.Row="0"
                      Grid.ColumnSpan="2">
                    <Border BorderBrush="{Binding WidgetWindowPalette.WidgetWindowDividerBrush}" BorderThickness="0,0,0,1" />

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <ContentControl x:Name="WidgetHeaderChromeActionsHost"
                                        Width="{Binding ActualWidth, ElementName=WidgetHeaderActionsHost}"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch"
                                        IsHitTestVisible="False" />

                        <ContentControl Width="{Binding ActualWidth, ElementName=CloseButton}"
                                        Style="{StaticResource ContentControl.WidgetWindowHeaderGlyph}"
                                        Content="&#xE8BB;" />
                    </StackPanel>
                </Grid>

                <!--
                    枠のレイヤーに重ねる飾りの置き場。ここに入れたものは背景・分割線・
                    閉じる印と同じ不透明度で合成される。
                -->
                <ContentControl x:Name="WidgetFrameOverlayHost"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                IsHitTestVisible="False" />

                <ScrollBar x:Name="WidgetContentScrollBar"
                           Grid.Row="1"
                           Grid.Column="1"
                           Width="6"
                           Margin="5"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Stretch"
                           Background="{Binding WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                           Cursor="Arrow"
                           IsTabStop="False"
                           Orientation="Vertical"
                           Style="{StaticResource ScrollBar.WidgetWindow}"
                           Visibility="Collapsed" />

                <!--
                    横のスクロールバー(IWidgetHorizontalScrollContent の中身のときだけ行を空ける)。
                    本体の層の同じ行は空けておき、クリックをここへ通す(縦のバーの列と同じ)。
                -->
                <ScrollBar x:Name="WidgetContentHorizontalScrollBar"
                           Grid.Row="2"
                           Grid.Column="0"
                           Height="6"
                           Margin="5"
                           HorizontalAlignment="Stretch"
                           VerticalAlignment="Bottom"
                           Background="{Binding WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                           Cursor="Arrow"
                           IsTabStop="False"
                           Orientation="Horizontal"
                           Style="{StaticResource ScrollBar.WidgetWindowHorizontal}"
                           Visibility="Collapsed" />

                <Border x:Name="WidgetFooterFrame"
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Height="30"
                        BorderBrush="{Binding WidgetWindowPalette.WidgetWindowDividerBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="ContentHeaderRow" Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition x:Name="WidgetContentHorizontalScrollBarRow" Height="0" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="WidgetContentScrollBarColumn" Width="16" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="WidgetHeader"
                  Grid.Row="0"
                  Grid.ColumnSpan="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="Transparent"
                        MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <!--
                        状態の印の円とタイトル。TIPS はこの枠に付け、円の上と文字の上で出る(枠に背景が無いので、文字の右の空いた所では出ず、ドラッグの所のまま)。
                        円と TIPS を出すかは全体設定「ウィジェット状態」と今の色で窓が決める(IsDataStatusMarkShown / IsDataStatusTipShown)。緑のときは TIPS を出さない。
                        円を出さないときはタイトルが左の余白 10 の位置へ詰まる(円を足す前と同じ位置)。
                        DataContext は窓(DataStatusLevel / DataStatusText)、Tag は TIPS の色を引くウィジェット。
                    -->
                    <Grid Margin="10,0,0,0"
                          DataContext="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                          Tag="{Binding Widget}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="ToolTipService.IsEnabled" Value="{Binding IsDataStatusTipShown}" />
                            </Style>
                        </Grid.Style>
                        <Grid.ToolTip>
                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                           FontSize="12"
                                           Text="{Binding DataStatusText}" />
                            </ToolTip>
                        </Grid.ToolTip>

                        <!-- 状態の印(メイン窓のカードの円と同じ大きさと色)。 -->
                        <Ellipse Grid.Column="0"
                                 Width="11"
                                 Height="11"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 SnapsToDevicePixels="True"
                                 Visibility="{Binding IsDataStatusMarkShown, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DataStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Partial}">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.DataStatusPartial}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding DataStatusLevel}" Value="{x:Static models:WidgetDataStatusLevel.Unavailable}">
                                            <Setter Property="Fill" Value="{DynamicResource Brush.DataStatusUnavailable}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>

                        <!-- 文字の幅だけをTIPSの範囲にするため左に寄せる(長いタイトルは列の幅で省略される)。 -->
                        <TextBlock Grid.Column="1"
                                   Margin="0,0,8,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Text.WidgetWindow}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding HeaderText, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                    </Grid>
                </Border>

                <ContentControl x:Name="WidgetHeaderActionsHost"
                                Grid.Column="1"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />

                <Button x:Name="CloseButton"
                        Grid.Column="2"
                        Style="{StaticResource Button.WidgetWindowHeaderIcon}"
                        Click="CloseButton_Click" />
            </Grid>

            <ContentControl x:Name="WidgetContentHost"
                            Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <ContentControl x:Name="WidgetFooterHost"
                            Grid.Row="3"
                            Grid.ColumnSpan="2"
                            Height="30"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch"
                            Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
