<Window x:Class="StarResonanceDps.App.Views.Widgets.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DisplayName}"
        Width="340"
        Height="200"
        MinWidth="240"
        MinHeight="100"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <ContentControl Style="{StaticResource Panel.WidgetWindowFrame}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="Transparent"
                    BorderBrush="{Binding WidgetWindowPalette.WidgetWindowBorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="Transparent"
                            MouseLeftButtonDown="Header_MouseLeftButtonDown">
                        <TextBlock Margin="12,0,8,0"
                                   VerticalAlignment="Center"
                                   Foreground="{Binding WidgetWindowPalette.WidgetWindowTextBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding DisplayName}" />
                    </Border>

                    <Button Grid.Column="1"
                            Margin="0,1,1,1"
                            Style="{StaticResource Button.WidgetWindowClose}"
                            Foreground="{Binding WidgetWindowPalette.WidgetWindowNonTextBrush}"
                            Click="CloseButton_Click">
                        <TextBlock FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons"
                                   FontSize="10"
                                   Text="&#xE8BB;"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>
            </Border>

            <!-- Intentionally empty: each widget can provide its own body later. -->
            <Grid Grid.Row="1" />
        </Grid>
    </ContentControl>
</Window>
