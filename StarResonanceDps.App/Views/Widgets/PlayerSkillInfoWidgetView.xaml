<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerSkillInfoWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="PlayerSkillInfoWidgetView_Loaded"
             SizeChanged="PlayerSkillInfoWidgetView_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="SkillInfoText"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SkillInfoHeaderText"
               TargetType="TextBlock"
               BasedOn="{StaticResource SkillInfoText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="26" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              MinWidth="420"
              Margin="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" MinWidth="180" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Style="{StaticResource SkillInfoHeaderText}"
                       Text="ID" />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource SkillInfoHeaderText}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_SkillName]}" />
            <TextBlock Grid.Column="2"
                       HorizontalAlignment="Right"
                       Style="{StaticResource SkillInfoHeaderText}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[SkillInfo_Level]}" />
            <TextBlock Grid.Column="3"
                       HorizontalAlignment="Right"
                       Style="{StaticResource SkillInfoHeaderText}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[SkillInfo_Tier]}" />
        </Grid>

        <Grid Grid.Row="1">
            <ScrollViewer x:Name="SkillInfoScrollViewer"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Hidden"
                          CanContentScroll="False"
                          ScrollChanged="SkillInfoScrollViewer_ScrollChanged">
                <ItemsControl MinWidth="420"
                              ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Height="25"
                                    BorderBrush="{Binding DataContext.PlayerWidget.WidgetWindowPalette.WidgetWindowDividerBrush, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="76" />
                                        <ColumnDefinition Width="*" MinWidth="180" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Margin="2,0,6,0"
                                               Style="{StaticResource SkillInfoText}"
                                               Text="{Binding SkillIdText}" />

                                    <Grid Grid.Column="1"
                                          Margin="2,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Width="20"
                                               Height="20"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Source="{Binding IconPath, TargetNullValue={x:Null}}"
                                               Stretch="Uniform" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="4,0,0,0"
                                                   Style="{StaticResource SkillInfoText}"
                                                   Text="{Binding Name}" />
                                    </Grid>

                                    <TextBlock Grid.Column="2"
                                               Margin="4,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource SkillInfoText}"
                                               Text="{Binding CurrentLevelText}" />
                                    <TextBlock Grid.Column="3"
                                               Margin="4,0"
                                               HorizontalAlignment="Right"
                                               Style="{StaticResource SkillInfoText}"
                                               Text="{Binding TierText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Opacity="0.7"
                       Text="{Binding NoDataText}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock"
                           BasedOn="{StaticResource Text.WidgetWindow}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasEntries}" Value="False">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </Grid>
</UserControl>
