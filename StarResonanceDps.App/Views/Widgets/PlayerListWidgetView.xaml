<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerListWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:local="clr-namespace:StarResonanceDps.App.Views.Widgets"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:HealthRatioToWidthConverter x:Key="PlayerList.HealthRatioToWidthConverter" />
        <converters:CenteredOffsetConverter x:Key="PlayerList.CenteredOffsetConverter" />

        <CornerRadius x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.FirstCornerRadius">5,5,0,0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.MiddleCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.LastCornerRadius">0,0,5,5</CornerRadius>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenu"
               TargetType="{x:Type ContextMenu}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding PlacementTarget.Tag.WidgetWindowPalette.WidgetWindowMenuSurfaceBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush" Value="{Binding PlacementTarget.Tag.WidgetWindowPalette.WidgetWindowDividerBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding PlacementTarget.Tag.WidgetWindowPalette.MenuOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding PlacementTarget.Tag.WidgetWindowPalette.MenuOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate.WidgetWindowMenuText">
            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem"
               TargetType="{x:Type MenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DataTemplate.WidgetWindowMenuText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.MiddleCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Background="{Binding WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                                    CornerRadius="{TemplateBinding Tag}"
                                    Opacity="{Binding WidgetWindowPalette.MenuOpacity}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.First"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.FirstCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.Middle"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.MiddleCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.Last"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.LastCornerRadius}" />
        </Style>

        <DataTemplate x:Key="PlayerList.SkillEffectTemplate">
            <Grid Width="18"
                  Height="18"
                  Margin="1,0,0,0"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerListWidgetView}}}">
                <Grid.ToolTip>
                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Style="{StaticResource ToolTip.WidgetWindowInfo}">
                        <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                   FontSize="12"
                                   Text="{Binding Name}" />
                    </ToolTip>
                </Grid.ToolTip>
                <Image Source="{Binding IconPath, TargetNullValue={x:Null}}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.WidgetWindow}"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="{Binding DurationText}"
                           TextAlignment="Center" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PlayerList.SkillSlotTemplate">
            <Grid Width="42"
                  ClipToBounds="False"
                  ToolTipService.IsEnabled="{Binding HasSkill}"
                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerListWidgetView}}}">
                <!-- 枠の中身が不明なら出さない。場所は残す(ロールスキルが横へ動かないように)。 -->
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSlotKnown}" Value="False">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ToolTip>
                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Style="{StaticResource ToolTip.WidgetWindowInfo}">
                        <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                   FontSize="12"
                                   Text="{Binding NameDisplayText}" />
                    </ToolTip>
                </Grid.ToolTip>

                <Grid Width="32"
                      HorizontalAlignment="Left">
                    <Image Width="31"
                           Style="{StaticResource Icon.PlayerListSkillFrame}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Image Source="{Binding IconPath, TargetNullValue={x:Null}}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Width" Value="27" />
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="-0.2" Y="1.3" />
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsesImagineAsset}" Value="True">
                                        <Setter Property="Width" Value="25" />
                                        <Setter Property="RenderTransform">
                                            <Setter.Value>
                                                <TranslateTransform X="-1.2" Y="2.1" />
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </Grid>

                <ContentPresenter Content="{Binding DebuffEntry}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="22,0,0,0"
                                  ContentTemplate="{StaticResource PlayerList.SkillEffectTemplate}" />

                <ContentPresenter Content="{Binding BuffEntry}"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom"
                                  Margin="22,0,0,0"
                                  ContentTemplate="{StaticResource PlayerList.SkillEffectTemplate}" />

                <Grid Width="32"
                      HorizontalAlignment="Left"
                      Panel.ZIndex="1">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Text="{Binding ChargeCountText}"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding HasChargeCount}" Value="True" />
                                            <Condition Binding="{Binding HasCooldown}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="-0.5" Y="1" />
                        </TextBlock.RenderTransform>
                    </TextBlock>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="{Binding CooldownText}"
                               TextAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasCooldown}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                        <TextBlock.RenderTransform>
                            <TranslateTransform X="-0.5" Y="1" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!--
            左マージンは行側(Button)へ移してある。ScrollViewer は必ず自分の枠でクリップするので、
            ここに 5px を残すとクリップ境界も 5px 内側に来る。特化テキストは列幅(33)より広く
            はみ出させるため、その 5px を左の余地として使いたい。描画位置は行の Margin で
            相殺しているので見た目は変わらない。
        -->
        <ScrollViewer x:Name="PlayerListScrollViewer"
                      Margin="0,5,0,5"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      ScrollChanged="PlayerListScrollViewer_ScrollChanged">
            <ItemsControl ItemsSource="{Binding PlayerListEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Height="44"
                                Margin="5,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False"
                                ContextMenuService.IsEnabled="False"
                                PreviewMouseRightButtonDown="PlayerListItem_PreviewMouseRightButtonDown"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerListWidgetView}}}"
                                Click="PlayerListItem_Click"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                             IsOpen="{Binding PlacementTarget.DataContext.IsPlayerSelectionMenuOpen, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                                             Placement="MousePoint"
                                             Opened="PlayerSelectionContextMenu_Opened"
                                             Closed="PlayerSelectionContextMenu_Closed">
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerInfo]}"
                                              Command="{Binding RequestPlayerInfoCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <!-- ステータス詳細は自分の行だけ。他人のステータスを取る手段が無いため。 -->
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerStatus]}"
                                              Command="{Binding RequestPlayerStatusCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                              Visibility="{Binding PlacementTarget.DataContext.IsSelf, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerEquipment]}"
                                              Command="{Binding RequestPlayerEquipmentCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_BuffList]}"
                                              Command="{Binding RequestBuffListCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_DebuffList]}"
                                              Command="{Binding RequestDebuffListCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid SnapsToDevicePixels="True">
                                                    <Border x:Name="InteractionBackground"
                                                            Background="{Binding DataContext.WidgetWindowPalette.WidgetWindowScrollThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerListWidgetView}}}"
                                                            Visibility="Collapsed">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.NonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerListWidgetView}}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                                        <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.ActiveNonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerListWidgetView}}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsPlayerSelectionMenuOpen}" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Grid VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="4" />
                                </Grid.RenderTransform>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="33" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- 型の絵のために空ける幅。設定「シーズン心相晶の表示」がオフなら消し、列の幅を0に戻す。 -->
                                <Border Grid.Column="1"
                                        Width="15"
                                        Visibility="{Binding ShowsSeasonTalent, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                <!--
                                    シーズン心相晶。枠はいつも出し、中は型の絵・不明の絵・無し(無効)のどれか。
                                    クラスアイコンに少し重ねるため、特化テキストと同じく Canvas に置く。
                                    クラスアイコンより前に置き、クラスアイコンと特化テキストが上に描かれるようにする。
                                -->
                                <Canvas Grid.Column="1"
                                        Visibility="{Binding ShowsSeasonTalent, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <!-- ツールチップはスキル枠と同じ作り。文字は書式の {Psych} と同じ(型の名前 / 無効 / 不明)。 -->
                                    <Grid Canvas.Left="-18.5"
                                          Canvas.Top="2.5"
                                          Width="35"
                                          Height="35"
                                          Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerListWidgetView}}}">
                                        <Grid.ToolTip>
                                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                     Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                                <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                                           FontSize="12"
                                                           Text="{Binding SeasonTalentDisplayText}" />
                                            </ToolTip>
                                        </Grid.ToolTip>
                                        <!-- 枠と型の絵は、アイコンカラーの設定の色で塗る。枠は影なし、型の絵はクラスアイコンと同じ影。 -->
                                        <Rectangle Fill="{Binding SeasonTalentBrush}"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                            <Rectangle.OpacityMask>
                                                <ImageBrush ImageSource="{StaticResource Icon.SeasonTalentFrame}" Stretch="Uniform" />
                                            </Rectangle.OpacityMask>
                                        </Rectangle>
                                        <Rectangle Width="23"
                                                   Height="23"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Fill="{Binding SeasonTalentBrush}"
                                                   OpacityMask="{Binding SeasonTalentIconMask}"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Effect="{StaticResource Effect.ProfessionIconShadow}">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSeasonTalentIcon}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                    </Grid>
                                </Canvas>

                                <Grid Grid.Column="0">
                                    <Rectangle Width="25"
                                               Height="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Fill="{Binding ClassBrush}"
                                               Effect="{StaticResource Effect.ProfessionIconShadow}">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                                <Setter Property="OpacityMask">
                                                    <Setter.Value>
                                                        <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="ShieldKnight">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.ShieldKnight}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="HeavyGuardian">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.HeavyGuardian}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="VerdantOracle">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.VerdantOracle}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="SoulMusician">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.SoulMusician}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="FlameBerserker">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.FlameBerserker}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="Stormblade">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.Stormblade}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="FrostMage">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.FrostMage}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="WindKnight">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.WindKnight}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="Marksman">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.Marksman}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="Transformation">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.Transformation}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                </Grid>

                                <!-- HP の数字はゲージより長いと左右にはみ出す。右のスキル枠より上に描くため前に出す。 -->
                                <Grid Grid.Column="2"
                                      Panel.ZIndex="1"
                                      Height="34"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      ClipToBounds="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="12" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ContentControl Content="{Binding PartyNumberText}"
                                                        Style="{StaticResource Icon.PartyNumber}"
                                                        Visibility="{Binding IsPartyMember, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <TextBlock Grid.Column="1"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <!-- 自分の行だけ色を変える。影は Text.WidgetWindow のまま。 -->
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelfHighlighted}" Value="True">
                                                            <Setter Property="Foreground" Value="#F9CD04" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Width="122"
                                            Height="10"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="#FF000000"
                                            CornerRadius="5"
                                            Padding="1">
                                        <Grid x:Name="HealthFillHost"
                                              Height="8"
                                              VerticalAlignment="Center">
                                            <Grid.Clip>
                                                <RectangleGeometry Rect="0,0,120,8"
                                                                   RadiusX="4"
                                                                   RadiusY="4" />
                                            </Grid.Clip>

                                            <Canvas Width="120" Height="8">
                                                <Border Panel.ZIndex="0"
                                                        Canvas.Left="0"
                                                        Height="8">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                            <Setter Property="Background" Value="#FF1CE6A7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNpc}" Value="True">
                                                                    <Setter Property="Background" Value="#FFABABAB" />
                                                                </DataTrigger>
                                                                <!--
                                                                    キャッシュしか無い行(AOIにもパーティにもいない。
                                                                    メーター残留・履歴のみ)は NPC と同じ灰色。
                                                                    供給が戻れば IsLive が true になり緑へ戻る。
                                                                -->
                                                                <DataTrigger Binding="{Binding IsLive}" Value="False">
                                                                    <Setter Property="Background" Value="#FFABABAB" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource PlayerList.HealthRatioToWidthConverter}">
                                                            <Binding Path="HealthRatio" />
                                                            <Binding ElementName="HealthFillHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>

                                                <Border Panel.ZIndex="1"
                                                        Height="8"
                                                        Background="#FFDCDCDC">
                                                    <Canvas.Left>
                                                        <MultiBinding Converter="{StaticResource PlayerList.HealthRatioToWidthConverter}">
                                                            <Binding Path="HealthRatio" />
                                                            <Binding ElementName="HealthFillHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Canvas.Left>
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource PlayerList.HealthRatioToWidthConverter}">
                                                            <Binding Path="ShieldVisibleRatio" />
                                                            <Binding ElementName="HealthFillHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>

                                                <Border Panel.ZIndex="2"
                                                        Height="8"
                                                        Background="#FFDCDCDC">
                                                    <Canvas.Left>
                                                        <MultiBinding Converter="{StaticResource PlayerList.HealthRatioToWidthConverter}">
                                                            <Binding Path="ShieldOverflowStartRatio" />
                                                            <Binding ElementName="HealthFillHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Canvas.Left>
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource PlayerList.HealthRatioToWidthConverter}">
                                                            <Binding Path="ShieldOverflowRatio" />
                                                            <Binding ElementName="HealthFillHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <Canvas Grid.Row="1"
                                            Panel.ZIndex="3"
                                            Width="122"
                                            Height="10"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ClipToBounds="False"
                                            IsHitTestVisible="False">
                                        <!-- 幅は数字の長さのまま、ゲージの中心にそろえる。ゲージより長ければ左右に同じだけはみ出す(切らない)。 -->
                                        <TextBlock Canvas.Top="-3"
                                                   Style="{StaticResource Text.WidgetWindow}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding HealthText}">
                                            <Canvas.Left>
                                                <MultiBinding Converter="{StaticResource PlayerList.CenteredOffsetConverter}">
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type Canvas}}" />
                                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                </MultiBinding>
                                            </Canvas.Left>
                                        </TextBlock>
                                    </Canvas>
                                </Grid>
                                <StackPanel Grid.Column="3"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding ImagineSkillEntries}"
                                                  ItemTemplate="{StaticResource PlayerList.SkillSlotTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <ItemsControl Margin="2,0,0,0"
                                                  ItemsSource="{Binding RoleSkillEntries}"
                                                  ItemTemplate="{StaticResource PlayerList.SkillSlotTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>

                                <!--
                                    特化テキスト。列0(幅33)より広い 52px で描くため、
                                    行グリッドの最後の子として Canvas で重ねる。

                                    ・Canvas でないと幅が通らない。 Grid は子を測定するとき
                                      セル幅で DesiredSize を頭打ちにするので、Width=52 を指定しても
                                      42.5px 程度に切られ TextTrimming が働いてしまう。
                                      Canvas は子を無限大で測るため指定幅がそのまま通り、
                                      Canvas 自身の DesiredSize は 0 なのでレイアウトへは影響しない
                                    ・最後に置いたうえで Panel.ZIndex も明示する。列0の中に入れると、
                                      後から描かれる列1(HPバー)の下に潜る
                                    ・幅52は英語の最長 "Moonstrike"(51.65px @ FontSize=10 SemiBold) に合わせてある
                                    ・Canvas.Left の -9.5 はアイコン中心(列0の中心 x=16.5)に
                                      52px の中心を合わせる値。右端がHPバーの左端に約2.5px 乗る
                                -->
                                <Canvas Grid.Column="0"
                                        Panel.ZIndex="1"
                                        IsHitTestVisible="False">
                                    <TextBlock Canvas.Left="-9.5"
                                               Canvas.Top="21"
                                               Width="52"
                                               Style="{StaticResource Text.WidgetWindow}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="{Binding ClassSpecDisplayName}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Canvas>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
