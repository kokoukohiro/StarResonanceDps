<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerListWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:local="clr-namespace:StarResonanceDps.App.Views.Widgets"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:HealthRatioToWidthConverter x:Key="PlayerList.HealthRatioToWidthConverter" />

        <CornerRadius x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.FirstCornerRadius">5,5,0,0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.MiddleCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.LastCornerRadius">0,0,5,5</CornerRadius>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenu"
               TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="{Binding WidgetWindowPalette.WidgetWindowMenuSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{Binding WidgetWindowPalette.WidgetWindowDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding WidgetWindowPalette.NonTextOpacity}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding WidgetWindowPalette.NonTextOpacity}" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate.WidgetWindowMenuText">
            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem"
               TargetType="{x:Type MenuItem}">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DataTemplate.WidgetWindowMenuText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.MiddleCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Background="{Binding WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                                    CornerRadius="{TemplateBinding Tag}"
                                    Opacity="{Binding WidgetWindowPalette.NonTextOpacity}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.First"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem}">
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.FirstCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.Middle"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem}">
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.MiddleCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.Last"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem}">
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.LastCornerRadius}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer x:Name="PlayerListScrollViewer"
                      Margin="5,5,0,5"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      ScrollChanged="PlayerListScrollViewer_ScrollChanged">
            <ItemsControl ItemsSource="{Binding PlayerListEntries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Height="44"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False"
                                ContextMenuService.IsEnabled="False"
                                PreviewMouseRightButtonDown="PlayerListItem_PreviewMouseRightButtonDown"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerListWidgetView}}}"
                                Click="PlayerListItem_Click"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                             IsOpen="{Binding PlacementTarget.DataContext.IsPlayerSelectionMenuOpen, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                                             Placement="MousePoint"
                                             Opened="PlayerSelectionContextMenu_Opened"
                                             Closed="PlayerSelectionContextMenu_Closed">
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerInfo]}"
                                              Command="{Binding RequestPlayerInfoCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerStatus]}"
                                              Command="{Binding RequestPlayerStatusCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerEquipment]}"
                                              Command="{Binding RequestPlayerEquipmentCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_ImagineRoleSkillInfo]}"
                                              Command="{Binding RequestImagineRoleSkillInfoCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_SkillInfo]}"
                                              Command="{Binding RequestSkillInfoCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_BuffList]}"
                                              Command="{Binding RequestBuffListCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_DebuffList]}"
                                              Command="{Binding RequestDebuffListCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid SnapsToDevicePixels="True">
                                                    <Border x:Name="InteractionBackground"
                                                            Background="{Binding DataContext.WidgetWindowPalette.WidgetWindowScrollThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerListWidgetView}}}"
                                                            Opacity="{Binding DataContext.WidgetWindowPalette.NonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerListWidgetView}}}"
                                                            Visibility="Collapsed" />
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsPlayerSelectionMenuOpen}" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <Grid VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="4" />
                                </Grid.RenderTransform>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="33" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Rectangle Width="25"
                                               Height="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Fill="{Binding ClassBrush}">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                                <Setter Property="OpacityMask">
                                                    <Setter.Value>
                                                        <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="ShieldKnight">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.ShieldKnight}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="HeavyGuardian">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.HeavyGuardian}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="VerdantOracle">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.VerdantOracle}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="SoulMusician">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.SoulMusician}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="FlameBerserker">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.FlameBerserker}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="Stormblade">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.Stormblade}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="FrostMage">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.FrostMage}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="WindKnight">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.WindKnight}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ProfessionKey}" Value="Marksman">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.Marksman}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>

                                    <TextBlock Margin="0,21,0,0"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Style="{StaticResource Text.WidgetWindow}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="{Binding ClassSpecDisplayName}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Grid>

                                <Grid Grid.Column="1"
                                      Height="34"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      ClipToBounds="False">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="22" />
                                        <RowDefinition Height="12" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <TextBlock HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.WidgetWindow}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DisplayName}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </Grid>

                                    <Border Grid.Row="1"
                                            Width="122"
                                            Height="10"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="#FF000000"
                                            CornerRadius="5"
                                            Padding="1">
                                        <Grid x:Name="HealthFillHost"
                                              Height="8"
                                              VerticalAlignment="Center">
                                            <Grid.Clip>
                                                <RectangleGeometry Rect="0,0,120,8"
                                                                   RadiusX="4"
                                                                   RadiusY="4" />
                                            </Grid.Clip>

                                            <Canvas Width="120" Height="8">
                                                <Border Panel.ZIndex="0"
                                                        Canvas.Left="0"
                                                        Height="8">
                                                    <Border.Style>
                                                        <Style TargetType="{x:Type Border}">
                                                            <Setter Property="Background" Value="#FF1CE6A7" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNpc}" Value="True">
                                                                    <Setter Property="Background" Value="#FFABABAB" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource PlayerList.HealthRatioToWidthConverter}">
                                                            <Binding Path="HealthRatio" />
                                                            <Binding ElementName="HealthFillHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>

                                                <Border Panel.ZIndex="1"
                                                        Height="8"
                                                        Background="#FFDCDCDC">
                                                    <Canvas.Left>
                                                        <MultiBinding Converter="{StaticResource PlayerList.HealthRatioToWidthConverter}">
                                                            <Binding Path="HealthRatio" />
                                                            <Binding ElementName="HealthFillHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Canvas.Left>
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource PlayerList.HealthRatioToWidthConverter}">
                                                            <Binding Path="ShieldVisibleRatio" />
                                                            <Binding ElementName="HealthFillHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>

                                                <Border Panel.ZIndex="2"
                                                        Height="8"
                                                        Background="#FFDCDCDC">
                                                    <Canvas.Left>
                                                        <MultiBinding Converter="{StaticResource PlayerList.HealthRatioToWidthConverter}">
                                                            <Binding Path="ShieldOverflowStartRatio" />
                                                            <Binding ElementName="HealthFillHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Canvas.Left>
                                                    <Border.Width>
                                                        <MultiBinding Converter="{StaticResource PlayerList.HealthRatioToWidthConverter}">
                                                            <Binding Path="ShieldOverflowRatio" />
                                                            <Binding ElementName="HealthFillHost" Path="ActualWidth" />
                                                        </MultiBinding>
                                                    </Border.Width>
                                                </Border>
                                            </Canvas>
                                        </Grid>
                                    </Border>

                                    <Canvas Grid.Row="1"
                                            Panel.ZIndex="3"
                                            Width="122"
                                            Height="10"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            ClipToBounds="False"
                                            IsHitTestVisible="False">
                                        <TextBlock Canvas.Top="-3"
                                                   Width="122"
                                                   Style="{StaticResource Text.WidgetWindow}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding HealthText}"
                                                   TextAlignment="Center" />
                                    </Canvas>
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
