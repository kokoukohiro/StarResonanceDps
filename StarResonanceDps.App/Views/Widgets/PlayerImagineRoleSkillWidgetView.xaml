<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerImagineRoleSkillWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <DataTemplate x:Key="SkillSlotTemplate">
            <Grid Width="98" Height="102" Margin="0,0,4,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="28" />
                    <RowDefinition Height="56" />
                    <RowDefinition Height="18" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="2,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.WidgetWindow}"
                           FontSize="9"
                           FontWeight="SemiBold"
                           Text="{Binding NameLevelText}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
                <Image Grid.Row="1"
                       Width="52"
                       Height="52"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Source="{Binding IconPath, TargetNullValue={x:Null}}"
                       Stretch="Uniform" />
                <TextBlock Grid.Row="2"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Text="{Binding CooldownText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasCooldown}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ItemsControl Grid.Column="0"
                      ItemsSource="{Binding ImagineEntries}"
                      ItemTemplate="{StaticResource SkillSlotTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl Grid.Column="2"
                      ItemsSource="{Binding RoleEntries}"
                      ItemTemplate="{StaticResource SkillSlotTemplate}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>
    </Grid>
</UserControl>
