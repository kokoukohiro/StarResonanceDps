<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerMetricTimelineWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!--
            格子と軸の線。<b>枠のレイヤー(WidgetWindow.FrameOverlayHost)へ差し込む</b>(分割線と同じく窓の不透明度で合成する)。
            色は分割線と同じ。
        -->
        <controls:MetricTimelineGridLayer x:Key="GridLayer"
                                          Brush="{Binding DataContext.WidgetWindowPalette.WidgetWindowDividerBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
    </UserControl.Resources>

    <!-- 下の隙間は窓の横のスクロールバーの行が受け持つ(バーがあれば16、無ければ5。ほかのウィジェットの右と縦のバーの列と同じ)。 -->
    <Grid Margin="5,5,5,0">
        <controls:MetricTimelineChart x:Name="TimelineChart"
                                      MinWidth="1"
                                      MinHeight="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Points="{Binding TimelinePoints}"
                                      VisibleSeconds="{Binding TimelineVisibleSeconds}"
                                      LineBrush="{Binding TimelineLineBrush}"
                                      SkillMarkers="{Binding TimelineSkillMarkers}"
                                      ShowSkillMarkers="{Binding TimelineShowsSkillLog}"
                                      SkillMarkerToolTipTag="{Binding PlayerWidget}" />
    </Grid>
</UserControl>
