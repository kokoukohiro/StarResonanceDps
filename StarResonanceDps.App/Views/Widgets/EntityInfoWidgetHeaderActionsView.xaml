<UserControl x:Class="StarResonanceDps.App.Views.Widgets.EntityInfoWidgetHeaderActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- 選んだ敵を映している間だけの「ターゲットに戻る」。文字は枠の層(EntityInfoWidgetHeaderLabelsView)が描き、ここは押す所だけ。 -->
    <StackPanel Orientation="Horizontal"
                Visibility="{Binding IsShowingChosenEntity, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Button Width="Auto"
                Height="30"
                Style="{StaticResource Button.WidgetWindowHeaderIcon}"
                Command="{Binding ReturnToTargetCommand}">
            <Border Margin="8,0">
                <TextBlock Opacity="0"
                           IsHitTestVisible="False"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[EntityInfo_ReturnToTarget]}" />
            </Border>
        </Button>
    </StackPanel>
</UserControl>
