<UserControl x:Class="StarResonanceDps.App.Views.Widgets.ReviveListWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:local="clr-namespace:StarResonanceDps.App.Views.Widgets"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!--
            行の右クリックのメニュー。作りはプレイヤーリスト・メーターのメニューと同じで、色はメーターと同じく
            中身(ReviveListWidgetViewModel)の Widget の窓の色から引く。先頭・途中・末尾の角丸は開くときに画面のコードが当てる。
        -->
        <CornerRadius x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.FirstCornerRadius">5,5,0,0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.MiddleCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.LastCornerRadius">0,0,5,5</CornerRadius>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenu"
               TargetType="{x:Type ContextMenu}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowMenuSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate.WidgetWindowMenuText">
            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem"
               TargetType="{x:Type MenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DataTemplate.WidgetWindowMenuText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.MiddleCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Background="{Binding Widget.WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                                    CornerRadius="{TemplateBinding Tag}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.First"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.FirstCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.Middle"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.MiddleCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerSelectionContextMenuItem.Last"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerSelectionContextMenuItem.LastCornerRadius}" />
        </Style>

        <!-- 行内テキスト。作りはデバフ一覧の行と同じ。 -->
        <Style x:Key="ReviveList.RowText" TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            名前。アイコンの欄から 6 空ける(デバフ一覧の名前と同じ)。自分の行だけ色を変える(プレイヤーリストと同じ色)。
        -->
        <Style x:Key="ReviveList.NameText" TargetType="TextBlock" BasedOn="{StaticResource ReviveList.RowText}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="6,0,6,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelfHighlighted}" Value="True">
                    <Setter Property="Foreground" Value="#F9CD04" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 右寄せの文字(蘇生不可の残り秒・蘇生可能)。蘇生可能のときだけテキストカラー「蘇生可能」の色。 -->
        <Style x:Key="ReviveList.StateText" TargetType="TextBlock" BasedOn="{StaticResource ReviveList.RowText}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsRevivable}" Value="True">
                    <Setter Property="Foreground" Value="{Binding RevivableBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        一覧の作りはデバフ一覧と同じで、仮想化しない。余白は左5・右0・上下5(デバフ一覧と同じ)。自動の高さ合わせはしない。
    -->
    <ScrollViewer x:Name="ReviveListScrollViewer"
                  Margin="5,5,0,5"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden"
                  CanContentScroll="False"
                  ScrollChanged="ReviveListScrollViewer_ScrollChanged">
        <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!--
                        行の高さとホバーの作りはデバフ一覧の行と同じ。
                        左クリックはその人のプレイヤー情報を開き、右クリックはメニューを開く(プレイヤーリストと同じ)。
                    -->
                    <Button Height="31"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Focusable="False"
                            IsTabStop="False"
                            ContextMenuService.IsEnabled="False"
                            PreviewMouseRightButtonDown="ReviveListItem_PreviewMouseRightButtonDown"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:ReviveListWidgetView}}}"
                            Click="ReviveListItem_Click"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch">
                        <!-- 項目と並びはプレイヤーリストの行のメニューと同じ。 -->
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                         IsOpen="{Binding PlacementTarget.DataContext.IsPlayerSelectionMenuOpen, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                                         Placement="MousePoint"
                                         Opened="PlayerSelectionContextMenu_Opened"
                                         Closed="PlayerSelectionContextMenu_Closed">
                                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerInfo]}"
                                          Command="{Binding RequestPlayerInfoCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                <!-- ステータス詳細は自分の行だけ。他人のステータスを取る手段が無いため。 -->
                                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerStatus]}"
                                          Command="{Binding RequestPlayerStatusCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                                          Visibility="{Binding PlacementTarget.DataContext.IsSelf, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerEquipment]}"
                                          Command="{Binding RequestPlayerEquipmentCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerTalent]}"
                                          Command="{Binding RequestPlayerTalentCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerSeasonTalent]}"
                                          Command="{Binding RequestPlayerSeasonTalentCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_PlayerModule]}"
                                          Command="{Binding RequestPlayerModuleCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_BuffList]}"
                                          Command="{Binding RequestBuffListCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_DebuffList]}"
                                          Command="{Binding RequestDebuffListCommand}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid SnapsToDevicePixels="True">
                                                <Border x:Name="InteractionBackground"
                                                        Background="{Binding DataContext.WidgetWindowPalette.WidgetWindowScrollThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                        Visibility="Collapsed">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                            <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.NonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                                    <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.ActiveNonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                </Border>
                                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                                <!-- メニューを開いている間は、その行の背景を残す(プレイヤーリストと同じ)。 -->
                                                <DataTrigger Binding="{Binding IsPlayerSelectionMenuOpen}" Value="True">
                                                    <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>

                        <!--
                            行の形はデバフ一覧と同じ(アイコンの枠30、名前と右の文字の下にゲージ)。右の文字の右の余白はデバフ一覧と同じ8。
                        -->
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- クラスアイコン(25)はデバフ一覧のアイコンの枠(30)の中央に置く。 -->
                            <Grid Grid.Column="0"
                                  Width="30"
                                  Height="30"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center">
                                <Rectangle Width="25"
                                           Height="25"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Fill="{Binding ClassBrush}"
                                           OpacityMask="{Binding ClassIconMask}"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Effect="{StaticResource Effect.ProfessionIconShadow}" />
                            </Grid>

                            <!--
                                ゲージはアイコンの外(右)だけに伸びる。作りはデバフ一覧と同じ2層(外は幅が動く窓、中は常に満タンの幅で塗る)で、
                                1枚で幅を動かすとグラデーションがバーと一緒に縮むため。長さを持つのは残り秒を出している行だけ(ViewModel が決める)。
                            -->
                            <Grid x:Name="GaugeArea"
                                  Grid.Column="1"
                                  Grid.ColumnSpan="2"
                                  Margin="0,0,2,0"
                                  ClipToBounds="True">
                                <Grid Height="26"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      ClipToBounds="True"
                                      behaviors:BarWidthAnimationBehavior.AreaWidth="{Binding ActualWidth, ElementName=GaugeArea}"
                                      behaviors:BarWidthAnimationBehavior.DecaySeconds="{Binding BarDecaySeconds}"
                                      behaviors:BarWidthAnimationBehavior.Ratio="{Binding BarRatio}"
                                      behaviors:BarWidthAnimationBehavior.SnapsToTarget="True">
                                    <Border Width="{Binding ActualWidth, ElementName=GaugeArea}"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            Background="{Binding DataContext.GaugeBrush, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                </Grid>
                            </Grid>

                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource ReviveList.NameText}"
                                       Text="{Binding DisplayName}" />

                            <TextBlock Grid.Column="2"
                                       Margin="0,0,8,0"
                                       Style="{StaticResource ReviveList.StateText}"
                                       Text="{Binding StateText}" />
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
