<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PluginWidgetScrollBodyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        本体のスクロールに入れるプラグインのウィジェットの本体。バーは窓の枠の層のもの(IWidgetVerticalScrollContent)で、ここのバーは隠す。
        DataContext を切り、本体の型を受け継がせない(プラグインは自分で入れる)。
    -->
    <ScrollViewer x:Name="BodyScrollViewer"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Hidden"
                  CanContentScroll="False"
                  ScrollChanged="BodyScrollViewer_ScrollChanged">
        <ContentControl x:Name="ElementHost"
                        DataContext="{x:Null}"
                        Focusable="False"
                        HorizontalContentAlignment="Stretch" />
    </ScrollViewer>
</UserControl>
