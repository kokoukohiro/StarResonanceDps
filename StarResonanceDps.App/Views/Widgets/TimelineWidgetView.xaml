<UserControl x:Class="StarResonanceDps.App.Views.Widgets.TimelineWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:viewModels="clr-namespace:StarResonanceDps.App.ViewModels"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="TimelineWidgetView_Loaded"
             SizeChanged="TimelineWidgetView_SizeChanged">
    <UserControl.Resources>
        <Style x:Key="Timeline.LineText" TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,1,0,1" />
        </Style>

        <!--
            行の中のプレイヤーのクラスアイコン。大きさの違う画像を同じ見た目にそろえるため、正方形の枠の中に中央寄せで置く。
            影はプレイヤーリストのクラスアイコンと同じ。TIPS の色は Tag(ウィジェット)の窓のパレットから取る。
        -->
        <DataTemplate DataType="{x:Type viewModels:TimelineClassIconSegment}">
            <Grid Width="16"
                  Height="16"
                  Margin="0,0,2,0"
                  Background="Transparent"
                  Tag="{Binding Widget}"
                  behaviors:ToolTipBehavior.IsEnabled="True"
                  behaviors:ToolTipBehavior.KeepsOnClick="True">
                <Grid.ToolTip>
                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Style="{StaticResource ToolTip.WidgetWindowInfo}">
                        <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                   FontSize="12"
                                   Text="{Binding SpecName}" />
                    </ToolTip>
                </Grid.ToolTip>
                <Rectangle Fill="{Binding ClassBrush}"
                           OpacityMask="{Binding IconMask}"
                           Effect="{StaticResource Effect.ProfessionIconShadow}"
                           RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
        </DataTemplate>

        <!-- 右クリックのメニュー。見た目はほかのウィジェットのメニューと同じで、色と不透明度は窓のパレット(ビューモデルの Widget)から取る。項目は1つなので角は4つとも丸める。 -->
        <CornerRadius x:Key="Menu.WidgetWindowTimelineContextMenuItem.SingleCornerRadius">5</CornerRadius>

        <Style x:Key="Menu.WidgetWindowTimelineContextMenu"
               TargetType="{x:Type ContextMenu}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowMenuSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate.WidgetWindowMenuText">
            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="Menu.WidgetWindowTimelineContextMenuItem"
               TargetType="{x:Type MenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DataTemplate.WidgetWindowMenuText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowTimelineContextMenuItem.SingleCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Background="{Binding Widget.WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                                    CornerRadius="{TemplateBinding Tag}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <!--
        1エンカウンターで数万行になるので仮想化する。仮想化はリスト自身のテンプレートの中に
        ScrollViewer が無いと効かない(外側に ScrollViewer を置くと全行が実体化する)。
        文字は行をまたいで選べる(TextRowsSelectionBehavior。部品は時刻の列と本文、選んだ文字の地)。
        選んだ文字は右クリックの「コピー」か、窓がアクティブなら Ctrl+C で文字にする。地は透明で塗って、文字の無い所でも押せるようにする。
    -->
    <ItemsControl x:Name="LogItemsControl"
                  Margin="8,4,0,4"
                  ItemsSource="{Binding Entries}"
                  Background="Transparent"
                  Focusable="True"
                  FocusVisualStyle="{x:Null}"
                  behaviors:TextRowsSelectionBehavior.PartElementNames="TimeText,BodyText"
                  behaviors:TextRowsSelectionBehavior.HighlightElementName="SelectionHighlight"
                  Grid.IsSharedSizeScope="True"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  VirtualizingPanel.ScrollUnit="Pixel">
        <ItemsControl.ContextMenu>
            <ContextMenu Style="{StaticResource Menu.WidgetWindowTimelineContextMenu}">
                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Common_Copy]}"
                          Command="{x:Static ApplicationCommands.Copy}"
                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}"
                          Style="{StaticResource Menu.WidgetWindowTimelineContextMenuItem}" />
            </ContextMenu>
        </ItemsControl.ContextMenu>
        <ItemsControl.Template>
            <ControlTemplate TargetType="ItemsControl">
                <ScrollViewer x:Name="LogScrollViewer"
                              Background="{TemplateBinding Background}"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Hidden"
                              CanContentScroll="True"
                              Focusable="False">
                    <ItemsPresenter />
                </ScrollViewer>
            </ControlTemplate>
        </ItemsControl.Template>
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <VirtualizingStackPanel />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <!--
                    時刻の列は行をまたいで幅を揃える。揃うのは画面に作られている行だけなので、時刻を見せない行(被弾行など)も
                    自分の時刻を Hidden で置いて場所を取る。本文が技の行と同じ位置から始まる。
                -->
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="TimelineTime" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        選んだ文字の地。形は TextRowsSelectionBehavior が決める(画面の文字の1行ごとの四角)。地の形で行の大きさが変わらないよう Canvas に入れる。
                        色はメニューの項目を指したときと同じ(窓のパレット、不透明度はメニューと同じ)。文字の後ろに置く。
                    -->
                    <Canvas Grid.ColumnSpan="2"
                            IsHitTestVisible="False">
                        <Path x:Name="SelectionHighlight"
                              Fill="{Binding Widget.WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                              Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                    </Canvas>

                    <TextBlock x:Name="TimeText"
                               Grid.Column="0"
                               Margin="0,1,8,1"
                               Text="{Binding TimeText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Timeline.LineText}">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTimeShown}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock x:Name="BodyText"
                               Grid.Column="1"
                               Style="{StaticResource Timeline.LineText}"
                               behaviors:TextSegmentsBehavior.Segments="{Binding Segments}" />
                </Grid>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
