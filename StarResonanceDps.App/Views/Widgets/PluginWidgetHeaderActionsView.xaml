<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PluginWidgetHeaderActionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!-- プラグインのヘッダーのボタンの押せる層。文字は幅を取るだけで見せず、見える文字は枠の層(PluginWidgetHeaderLabelsView)が描く。作りはメーターと同じ。 -->
    <ItemsControl ItemsSource="{Binding HeaderButtons}" Focusable="False">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Button Width="Auto"
                        Height="30"
                        Style="{StaticResource Button.WidgetWindowHeaderIcon}"
                        Command="{Binding ClickCommand}">
                    <Border Margin="8,0">
                        <TextBlock Opacity="0"
                                   IsHitTestVisible="False"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding Button.Text}" />
                    </Border>
                </Button>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
</UserControl>
