<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerMetricGraphWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:runtime="clr-namespace:StarResonanceDps.Core.CombatRuntime;assembly=StarResonanceDps.Core"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!--
            格子と軸の線。<b>枠のレイヤー(WidgetWindow.FrameOverlayHost)へ差し込む</b>(分割線と同じく窓の不透明度で合成する)。
            色は分割線と同じ。
        -->
        <controls:MetricGraphGridLayer x:Key="GridLayer"
                                          LineThickness="1"
                                          Brush="{Binding DataContext.WidgetWindowPalette.WidgetWindowDividerBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

        <converters:SkillIconImageConverter x:Key="MetricGraph.SkillIconImageConverter" />

        <!--
            横軸の下の技のアイコン1つ(中身は MetricGraphSkillMarker)。組み方はプレイヤーリストの技の枠と同じで、
            箱の中に下寄せで枠の箱(枠の画像の大きさ)を置き、枠の画像を箱いっぱいに描き、絵かクラス不明のアイコンと最大の段階の星を箱の中の決まった座標に置く。
            枠の箱と中の部品は丸めない(Windows の表示の拡大で、位置を画素へ丸める格子が変わっても枠と中身の関係がずれないようにする)。
            枠の画像と、絵・クラス不明のアイコンの大きさと座標は、枠の種類(01 / 02 / 03)とイマジンの絵かで変える。
            01・02 はプレイヤーリストの技の枠と同じ値。03 の枠の画像は1高く(31 × 35)、座標は 01 との中の円の位置の差だけずらした値から手で合わせたもの。
            03 にイマジンの絵の置き方は無い(来たら普通の絵の置き方で描き、グラフがログに警告する)。
            絵が無い・読めない技はクラス不明のアイコン(中の円の中心)。
            箱は背景を透明で塗って全体でマウスを受け、技の名前を TIPS で出す(色は窓のパレット。Tag にグラフの SkillMarkerToolTipTag を入れる)。
            箱の高さはグラフの SkillMarkerRowHeight。
        -->
        <DataTemplate x:Key="MetricGraph.SkillMarkerTemplate">
            <Grid Width="32"
                  Background="Transparent"
                  Tag="{Binding SkillMarkerToolTipTag, RelativeSource={RelativeSource AncestorType={x:Type controls:MetricGraphChart}}}"
                  behaviors:ToolTipBehavior.IsEnabled="True"
                  behaviors:ToolTipBehavior.KeepsOnClick="True">
                <Grid.ToolTip>
                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Style="{StaticResource ToolTip.WidgetWindowInfo}">
                        <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                   FontSize="12"
                                   Text="{Binding Name, Mode=OneTime}" />
                    </ToolTip>
                </Grid.ToolTip>

                <Grid Width="32"
                      VerticalAlignment="Bottom">
                    <Grid HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          UseLayoutRounding="False">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Width" Value="31" />
                                <Setter Property="Height" Value="34" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Frame, Mode=OneTime}" Value="{x:Static runtime:SkillIconFrame.Ultimate}">
                                        <Setter Property="Height" Value="35" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Image Stretch="Fill"
                               SnapsToDevicePixels="True"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Source" Value="{StaticResource Icon.RoleSkillFrame}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Frame, Mode=OneTime}" Value="{x:Static runtime:SkillIconFrame.Imagine}">
                                            <Setter Property="Source" Value="{StaticResource Icon.ImagineSkillFrame}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Frame, Mode=OneTime}" Value="{x:Static runtime:SkillIconFrame.Ultimate}">
                                            <Setter Property="Source" Value="{StaticResource Icon.UltimateSkillFrame}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <Image x:Name="SkillMarkerPicture"
                               Source="{Binding IconPath, Mode=OneTime, Converter={StaticResource MetricGraph.SkillIconImageConverter}}"
                               Stretch="Uniform"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Top"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <!-- 後の条件ほど強い。03 はイマジンの絵でも普通の絵の置き方。 -->
                                <Style TargetType="Image">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Width" Value="27" />
                                    <Setter Property="Height" Value="27" />
                                    <Setter Property="Margin" Value="1.8,5.3,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UsesImagineAsset, Mode=OneTime}" Value="True">
                                            <Setter Property="Width" Value="25" />
                                            <Setter Property="Height" Value="25" />
                                            <Setter Property="Margin" Value="2.8,6.1,0,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Frame, Mode=OneTime}" Value="{x:Static runtime:SkillIconFrame.Ultimate}">
                                            <Setter Property="Width" Value="27" />
                                            <Setter Property="Height" Value="27" />
                                            <Setter Property="Margin" Value="1.8,5.6,0,0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <Rectangle Width="20"
                                   Height="20"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"
                                   Fill="White"
                                   Effect="{StaticResource Effect.ProfessionIconShadow}">
                            <Rectangle.OpacityMask>
                                <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                            </Rectangle.OpacityMask>
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Setter Property="Margin" Value="5.4,8.7,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Frame, Mode=OneTime}" Value="{x:Static runtime:SkillIconFrame.Ultimate}">
                                            <Setter Property="Margin" Value="5.4,9.8,0,0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Source, ElementName=SkillMarkerPicture}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>

                        <!--
                            技が最大の段階なら、枠の左下に星(最大の段階になるのは 01・02 の枠の技だけ)。
                            設定「最大強化のイマジン・ロールスキルを強調表示」はグラフの DataContext(ウィジェットの VM)から読む。
                        -->
                        <Path>
                            <Path.Style>
                                <Style TargetType="{x:Type Path}" BasedOn="{StaticResource Icon.SkillMaxGradeStar}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMaxGrade, Mode=OneTime}" Value="True" />
                                                <Condition Binding="{Binding DataContext.GraphHighlightsMaxGradeSkills, RelativeSource={RelativeSource AncestorType={x:Type controls:MetricGraphChart}}}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 下の隙間は窓の横のスクロールバーの行が受け持つ(バーがあれば16、無ければ5。ほかのウィジェットの右と縦のバーの列と同じ)。 -->
    <Grid Margin="5,5,5,0">
        <controls:MetricGraphChart x:Name="GraphChart"
                                      MinWidth="1"
                                      MinHeight="1"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Points="{Binding GraphPoints}"
                                      VisibleSeconds="{Binding GraphVisibleSeconds}"
                                      LineBrush="{Binding GraphLineBrush}"
                                      NumberDisplayFormatIndex="{Binding GraphNumberDisplayFormatIndex}"
                                      SkillMarkers="{Binding GraphSkillMarkers}"
                                      ShowSkillMarkers="{Binding GraphShowsSkillLog}"
                                      SkillMarkerToolTipTag="{Binding PlayerWidget}"
                                      SkillMarkerTemplate="{StaticResource MetricGraph.SkillMarkerTemplate}"
                                      SkillMarkerRowHeight="35"
                                      SkillMarkerGap="2"
                                      ValueLabelGap="4"
                                      SecondLabelGap="2"
                                      AxisFontSize="10"
                                      LineThickness="1.5" />
    </Grid>
</UserControl>
