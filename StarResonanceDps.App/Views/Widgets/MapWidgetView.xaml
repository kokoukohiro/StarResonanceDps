<!-- This file is part of StarResonanceDps. See LICENSING.md for the license, additional permissions and additional terms. -->
<UserControl x:Class="StarResonanceDps.App.Views.Widgets.MapWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:local="clr-namespace:StarResonanceDps.App.Views.Widgets"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="MapWidgetView_Loaded"
             Unloaded="MapWidgetView_Unloaded"
             DataContextChanged="MapWidgetView_DataContextChanged">
    <UserControl.Resources>
        <converters:MapImageOpacityConverter x:Key="Map.ImageOpacityConverter" />

        <!--
            印の名前の欄の幅。名前は欄の中央に置き、欄は印の中心に合わせて左へ幅の半分ずらす(下の Canvas.Left。円と矢先は中心が 0 なので -80、
            アイコンは中心が 0.5 右なので -79。円の上の得点の欄も同じ)。
            画面のコードがこの幅の半分を、窓の端からはみ出して見える印を作る幅として中身へ渡す。
        -->
        <sys:Double x:Key="Map.MarkerNameWidth">160</sys:Double>

        <!-- 印1つ。左クリックで、プレイヤーの印はプレイヤー情報、敵の印はターゲット情報を開くので、指の形のカーソル。 -->
        <Style x:Key="Map.Marker" TargetType="Canvas">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!--
            右クリックのメニュー。作りはタイムラインのメニューと同じで、色と不透明度は窓のパレット(ビューモデルの Widget)から取る。
            項目は出せるものだけを出すので、1つのときは角を4つとも丸め、2つ並ぶときだけ上下に分ける。
        -->
        <CornerRadius x:Key="Menu.WidgetWindowMapContextMenuItem.SingleCornerRadius">5</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowMapContextMenuItem.FirstCornerRadius">5,5,0,0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowMapContextMenuItem.LastCornerRadius">0,0,5,5</CornerRadius>

        <Style x:Key="Menu.WidgetWindowMapContextMenu"
               TargetType="{x:Type ContextMenu}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowMenuSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate.WidgetWindowMapMenuText">
            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="Menu.WidgetWindowMapContextMenuItem"
               TargetType="{x:Type MenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DataTemplate.WidgetWindowMapMenuText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowMapContextMenuItem.SingleCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Background="{Binding Widget.WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                                    CornerRadius="{TemplateBinding Tag}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 「自分のいるマップに戻る」。「位置のマークを消す」も出るときは上の項目になる。 -->
        <Style x:Key="Menu.WidgetWindowMapContextMenuItem.ReturnToCurrentMap"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowMapContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSharedPosition}" Value="True">
                    <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowMapContextMenuItem.FirstCornerRadius}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 「位置のマークを消す」。「自分のいるマップに戻る」も出るときは下の項目になる。 -->
        <Style x:Key="Menu.WidgetWindowMapContextMenuItem.ClearSharedPosition"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowMapContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanReturnToCurrentMap}" Value="True">
                    <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowMapContextMenuItem.LastCornerRadius}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 印の名前。文字の作りはプレイヤーリストの特化の文字・エンティティリストのヘイトの枠の名前と同じ。 -->
        <Style x:Key="Map.MarkerNameText" TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            枠の層の地図の画像に掛ける不透明度。地図の濃さ(設定「マップの不透明度」)を枠の今の不透明度で割る(Map.ImageOpacityConverter)。
            枠のほうが薄い間は 1 で、背景を覆う。
            枠の不透明度の読み方は ScrollBar.WidgetWindowInactiveAware と同じ(通常は設定の値、アクティブの間は確保した値)。
        -->
        <Style x:Key="Map.FrameImage" TargetType="Image">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Opacity">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource Map.ImageOpacityConverter}">
                        <Binding Path="MapImageOpacity" />
                        <Binding Path="DataContext.WidgetWindowPalette.NonTextOpacity"
                                 RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                    <Setter Property="Opacity">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource Map.ImageOpacityConverter}">
                                <Binding Path="MapImageOpacity" />
                                <Binding Path="DataContext.WidgetWindowPalette.ActiveNonTextOpacity"
                                         RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            印の層の地図の画像に掛ける不透明度。枠の層の画像だけでは地図の濃さに足りない分(枠のほうが薄い間だけ)。
            足りている間は 0 なので隠す。
        -->
        <Style x:Key="Map.OverlayImage" TargetType="Image">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Opacity">
                <Setter.Value>
                    <MultiBinding Converter="{StaticResource Map.ImageOpacityConverter}" ConverterParameter="Overlay">
                        <Binding Path="MapImageOpacity" />
                        <Binding Path="DataContext.WidgetWindowPalette.NonTextOpacity"
                                 RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                    </MultiBinding>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                    <Setter Property="Opacity">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource Map.ImageOpacityConverter}" ConverterParameter="Overlay">
                                <Binding Path="MapImageOpacity" />
                                <Binding Path="DataContext.WidgetWindowPalette.ActiveNonTextOpacity"
                                         RelativeSource="{RelativeSource AncestorType={x:Type Window}}" />
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <Trigger Property="Opacity" Value="0">
                    <Setter Property="Visibility" Value="Hidden" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--
            地図の画像の層。枠のレイヤー(WidgetWindow.FrameOverlayHost)へ差し込む(推移グラフの格子と同じ)。
            窓の背景と1枚の絵として枠の不透明度で合成される。画像には Map.FrameImage の値を掛けるので、枠の不透明度がどの値でも
            地図は設定「マップの不透明度」の濃さで見え、残りが窓の背景の色になる。枠のほうが薄い間は、足りない分を下の印の層の画像が足す。
            置き方は下の印の層と同じで、層ごと領域の中へ同じ量だけずらす(ずらす量は中身が決める)。
            画像は画素の大きさのまま置き、層の大きさへは変形で伸ばす(層の原点は地図の左上)。領域の外へ出た分は切る。
            DataContext は画面のコードが中身を入れる。
        -->
        <Grid x:Key="Map.ImageLayer"
              ClipToBounds="True">
            <Canvas>
                <Canvas.RenderTransform>
                    <TranslateTransform X="{Binding LayerOffsetX}" Y="{Binding LayerOffsetY}" />
                </Canvas.RenderTransform>

                <Image Source="{Binding MapImage}"
                       Width="{Binding MapImagePixelWidth}"
                       Height="{Binding MapImagePixelHeight}"
                       Stretch="Fill"
                       RenderOptions.BitmapScalingMode="Linear"
                       Style="{StaticResource Map.FrameImage}">
                    <Image.RenderTransform>
                        <MatrixTransform Matrix="{Binding MapImageMatrix}" />
                    </Image.RenderTransform>
                </Image>
            </Canvas>
        </Grid>
    </UserControl.Resources>

    <!--
        地図を出す領域。印と、枠の層の画像だけでは足りない分の地図の画像を1つの層(Canvas)に置き、
        層ごと領域の中へずらす(枠の層の地図の画像の層と同じ量)。
        領域の外へ出た分は切る。背景は透明で塗って、何も無い所でもホイールと、地図を掴む左ボタンを受ける。
        右クリックのメニューは、出せる項目があるときだけ開く(「自分のいるマップに戻る」は別のマップを見ている間と
        チャットのリンクで選んだ場所を見ている間、「位置のマークを消す」は共有された位置を持っている間)。
    -->
    <Grid x:Name="MapArea"
          Background="Transparent"
          ClipToBounds="True"
          ContextMenuService.IsEnabled="{Binding IsContextMenuEnabled}"
          SizeChanged="MapArea_SizeChanged"
          MouseLeftButtonDown="MapArea_MouseLeftButtonDown"
          MouseMove="MapArea_MouseMove"
          MouseLeftButtonUp="MapArea_MouseLeftButtonUp"
          LostMouseCapture="MapArea_LostMouseCapture">
        <Grid.ContextMenu>
            <ContextMenu Style="{StaticResource Menu.WidgetWindowMapContextMenu}">
                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Map_ReturnToCurrentMap]}"
                          Command="{Binding ReturnToCurrentMapCommand}"
                          Visibility="{Binding CanReturnToCurrentMap, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Style="{StaticResource Menu.WidgetWindowMapContextMenuItem.ReturnToCurrentMap}" />
                <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Map_ClearSharedPosition]}"
                          Command="{Binding ClearSharedPositionCommand}"
                          Visibility="{Binding HasSharedPosition, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Style="{StaticResource Menu.WidgetWindowMapContextMenuItem.ClearSharedPosition}" />
            </ContextMenu>
        </Grid.ContextMenu>
        <Canvas>
            <Canvas.RenderTransform>
                <TranslateTransform X="{Binding LayerOffsetX}" Y="{Binding LayerOffsetY}" />
            </Canvas.RenderTransform>

            <!-- 足りない分の地図の画像。置き方は枠の層の画像と同じで、印の後ろ。 -->
            <Image Source="{Binding MapImage}"
                   Width="{Binding MapImagePixelWidth}"
                   Height="{Binding MapImagePixelHeight}"
                   Stretch="Fill"
                   RenderOptions.BitmapScalingMode="Linear"
                   Style="{StaticResource Map.OverlayImage}">
                <Image.RenderTransform>
                    <MatrixTransform Matrix="{Binding MapImageMatrix}" />
                </Image.RenderTransform>
            </Image>

            <ItemsControl ItemsSource="{Binding Markers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Panel.ZIndex" Value="{Binding ZIndex}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                            印。層の中の位置(整数)へずらし、その点をアイコン(25)の中心にする。名前の有無でアイコンは動かない。
                            名前はアイコンの上端から 21 でアイコンに 4 重ねる(プレイヤーリストの特化の文字と同じ置き方)。
                            円の名前は円の下端に寄せる(日本語の文字の上端と円の間が 2〜3)。矢先は回ると先端が中心から約 9 まで来るのでアイコンと同じ位置。
                            名前の欄を出さない印も、アイコンの TIPS に名前を出す(作りはエンティティリストのヘイトの枠の TIPS と同じ。
                            左クリックで窓を開くので、押したら閉じる)。
                        -->
                        <Canvas Style="{StaticResource Map.Marker}">
                            <Canvas.RenderTransform>
                                <TranslateTransform X="{Binding X}" Y="{Binding Y}" />
                            </Canvas.RenderTransform>

                            <Rectangle Canvas.Left="-12"
                                       Canvas.Top="-12"
                                       Width="25"
                                       Height="25"
                                       Fill="{Binding IconBrush}"
                                       OpacityMask="{Binding IconMask}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Effect="{StaticResource Effect.ProfessionIconShadow}"
                                       Tag="{Binding DataContext.Widget, RelativeSource={RelativeSource AncestorType={x:Type local:MapWidgetView}}}"
                                       behaviors:ToolTipBehavior.IsEnabled="True">
                                <Rectangle.Style>
                                    <Style TargetType="Rectangle">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shape}" Value="Icon">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Rectangle.Style>
                                <Rectangle.ToolTip>
                                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                        <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                                   FontSize="12"
                                                   Text="{Binding Name}" />
                                    </ToolTip>
                                </Rectangle.ToolTip>
                            </Rectangle>

                            <!--
                                簡略化した印(ボス以外のエンティティと、簡略化するプレイヤー)。アイコンの代わりの小さい円で、中心は同じ座標。影と TIPS はアイコンと同じ。
                                プレイヤーの円は白い縁を付けて少し大きくし、縁の無い敵の円と形で見分ける(縁は円の大きさの内側に描かれる)。
                            -->
                            <Ellipse Fill="{Binding IconBrush}"
                                     Effect="{StaticResource Effect.ProfessionIconShadow}"
                                     Tag="{Binding DataContext.Widget, RelativeSource={RelativeSource AncestorType={x:Type local:MapWidgetView}}}"
                                     behaviors:ToolTipBehavior.IsEnabled="True">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Setter Property="Canvas.Left" Value="-4" />
                                        <Setter Property="Canvas.Top" Value="-4" />
                                        <Setter Property="Width" Value="8" />
                                        <Setter Property="Height" Value="8" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shape}" Value="Circle">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsPlayer}" Value="True">
                                                <Setter Property="Canvas.Left" Value="-5" />
                                                <Setter Property="Canvas.Top" Value="-5" />
                                                <Setter Property="Width" Value="10" />
                                                <Setter Property="Height" Value="10" />
                                                <Setter Property="Stroke" Value="White" />
                                                <Setter Property="StrokeThickness" Value="1.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.ToolTip>
                                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                        <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                                   FontSize="12"
                                                   Text="{Binding Name}" />
                                    </ToolTip>
                                </Ellipse.ToolTip>
                            </Ellipse>

                            <!--
                                簡略化した自分の印。円の代わりに向きを指す矢先で、中心は同じ座標。影と TIPS はアイコンと同じ。縁はプレイヤーの円と同じ白。
                                形は角を丸めた三角(Icons.xaml の Icon.MapSelfArrow、縁の外側の角の半径は 1.5)。
                                大きさを変えるときは、形と Canvas.Left / Canvas.Top(半分のマイナス)と RotateTransform の中心(半分)を一緒に直す。
                            -->
                            <Path Canvas.Left="-7"
                                  Canvas.Top="-7"
                                  Data="{StaticResource Icon.MapSelfArrow}"
                                  Fill="{Binding IconBrush}"
                                  Stroke="White"
                                  StrokeThickness="1.5"
                                  Effect="{StaticResource Effect.ProfessionIconShadow}"
                                  Tag="{Binding DataContext.Widget, RelativeSource={RelativeSource AncestorType={x:Type local:MapWidgetView}}}"
                                  behaviors:ToolTipBehavior.IsEnabled="True">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="{Binding FacingDegrees}"
                                                     CenterX="7"
                                                     CenterY="7" />
                                </Path.RenderTransform>
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shape}" Value="Arrow">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                                <Path.ToolTip>
                                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                        <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                                   FontSize="12"
                                                   Text="{Binding Name}" />
                                    </ToolTip>
                                </Path.ToolTip>
                            </Path>

                            <!--
                                チャットで共有された位置の印。ゲームと同じ絵をそのまま出し(色は変えない)、中心は同じ座標。
                                押しても何もしないのでマウスを受けず、下の地図をそのまま掴める。
                            -->
                            <Image Canvas.Left="-16"
                                   Canvas.Top="-16"
                                   Width="32"
                                   Height="32"
                                   Source="{Binding IconImage}"
                                   IsHitTestVisible="False"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Effect="{StaticResource Effect.ProfessionIconShadow}">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shape}" Value="Image">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>

                            <!--
                                ダンジョンで隊長が置いたフィールドマーク。ゲームが場に出すマークと同じく、枠の絵と番号の絵を同じ大きさで重ねる(色は変えない)。
                                中心は同じ座標。大きさは外側の枠で決まり、枠と番号が一緒に変わる。
                                押しても何もしないのでマウスを受けず、下の地図をそのまま掴める。
                            -->
                            <Grid Canvas.Left="-15"
                                  Canvas.Top="-15"
                                  Width="30"
                                  Height="30"
                                  IsHitTestVisible="False"
                                  Effect="{StaticResource Effect.ProfessionIconShadow}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shape}" Value="FieldMark">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Image Source="{StaticResource Icon.FieldMarkFrame}"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <Image Width="28"
                                       Height="28"
                                       Source="{Binding IconImage}"
                                       RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.RenderTransform>
                                        <TranslateTransform X="0" Y="-0.5" />
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>

                            <!--
                                得点を求めている間の敵の得点(「○○pt」)。円は名前と同じ文字で円の上に出す(p の下端が円の上端から 1 上)。
                                ボスのアイコンはエンティティリストのアイコンと同じ文字で、アイコンの中央に重ねる。
                            -->
                            <Grid IsHitTestVisible="False">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Canvas.Left" Value="-80" />
                                        <Setter Property="Canvas.Top" Value="-17" />
                                        <Setter Property="Width" Value="{StaticResource Map.MarkerNameWidth}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shape}" Value="Icon">
                                                <Setter Property="Canvas.Left" Value="-21.5" />
                                                <Setter Property="Canvas.Top" Value="-12" />
                                                <Setter Property="Width" Value="44" />
                                                <Setter Property="Height" Value="25" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Text="{Binding ScoreText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Map.MarkerNameText}">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Shape}" Value="Icon">
                                                    <Setter Property="FontSize" Value="14" />
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                    <Setter Property="TextAlignment" Value="Center" />
                                                    <Setter Property="TextTrimming" Value="None" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Grid Width="{StaticResource Map.MarkerNameWidth}"
                                  Visibility="{Binding ShowsName, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Canvas.Left" Value="-80" />
                                        <Setter Property="Canvas.Top" Value="9" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Shape}" Value="Icon">
                                                <Setter Property="Canvas.Left" Value="-79" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Shape}" Value="Circle" />
                                                    <Condition Binding="{Binding IsPlayer}" Value="False" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Canvas.Top" Value="4" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding Shape}" Value="Circle" />
                                                    <Condition Binding="{Binding IsPlayer}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Canvas.Top" Value="5" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <TextBlock Style="{StaticResource Map.MarkerNameText}"
                                           Text="{Binding Name}" />
                            </Grid>
                        </Canvas>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Canvas>
    </Grid>
</UserControl>
