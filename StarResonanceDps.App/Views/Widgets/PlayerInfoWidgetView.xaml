<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerInfoWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StarResonanceDps.App.Views.Widgets"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <CornerRadius x:Key="Menu.WidgetWindowPlayerInfoImageContextMenuItem.FirstCornerRadius">5,5,0,0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowPlayerInfoImageContextMenuItem.MiddleCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowPlayerInfoImageContextMenuItem.LastCornerRadius">0,0,5,5</CornerRadius>

        <Style x:Key="Menu.WidgetWindowPlayerInfoImageContextMenu"
               TargetType="{x:Type ContextMenu}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding PlacementTarget.Tag.WidgetWindowPalette.WidgetWindowMenuSurfaceBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderBrush" Value="{Binding PlacementTarget.Tag.WidgetWindowPalette.WidgetWindowDividerBrush, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding PlacementTarget.Tag.WidgetWindowPalette.MenuOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding PlacementTarget.Tag.WidgetWindowPalette.MenuOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate.WidgetWindowMenuText">
            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="Menu.WidgetWindowPlayerInfoImageContextMenuItem"
               TargetType="{x:Type MenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DataTemplate.WidgetWindowMenuText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerInfoImageContextMenuItem.MiddleCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Background="{Binding WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                                    CornerRadius="{TemplateBinding Tag}"
                                    Opacity="{Binding WidgetWindowPalette.MenuOpacity}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerInfoImageContextMenuItem.First"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerInfoImageContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerInfoImageContextMenuItem.FirstCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerInfoImageContextMenuItem.Middle"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerInfoImageContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerInfoImageContextMenuItem.MiddleCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowPlayerInfoImageContextMenuItem.Last"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowPlayerInfoImageContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowPlayerInfoImageContextMenuItem.LastCornerRadius}" />
        </Style>

        <!-- バッジ1つの幅と、絵の大きさ。 -->
        <Style x:Key="PlayerInfo.Badge" TargetType="StackPanel">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="80" />
        </Style>
        <Style x:Key="PlayerInfo.BadgeIcon" TargetType="Grid">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- 名前の下の文字の行(UID〜現在地)。 -->
        <Style x:Key="PlayerInfo.RowText"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 顔の下の文字の行の枠。行の高さはステータス詳細の行と同じ。文字は枠の中で上下の真ん中に置く。 -->
        <Style x:Key="PlayerInfo.Line" TargetType="Grid">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="19" />
        </Style>
        <!-- バッジの下の名前。幅に収まらない名前は折り返す。 -->
        <Style x:Key="PlayerInfo.BadgeText"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <!--
        左に顔・名前・文字の行・バッジ、右に名刺。顔と名刺は窓の VM の写真、それ以外は PlayerInfo。
        相手も覚えている素性も無い間(PlayerInfo が null)は、ほかのウィンドウと同じく何も出さない。
    -->
    <Grid Margin="12,8,12,12"
          HorizontalAlignment="Left"
          Visibility="{Binding HasPlayerInfo, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        
        <StackPanel Grid.Column="0">
            <!--
                顔。写真を取れたら写真、それ以外は既定の絵。自分の写真のときだけ右クリックで保存・コピーのメニューを出す。
                Tag はメニューの色(ウィジェットのパレット)の取り先。
            -->
            <StackPanel Orientation="Horizontal">
                <Image Width="50"
                       Height="50"
                       Source="{Binding AvatarImage}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Tag="{Binding InfoWidget}"
                       ContextMenuService.IsEnabled="False"
                       PreviewMouseRightButtonDown="AvatarImage_PreviewMouseRightButtonDown">
                    <Image.ContextMenu>
                        <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                     Placement="MousePoint">
                            <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerInfo_SaveImageAs]}"
                                      Click="SaveImageMenuItem_Click" />
                            <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerInfo_CopyImage]}"
                                      Click="CopyImageMenuItem_Click" />
                        </ContextMenu>
                    </Image.ContextMenu>
                </Image>
                <!-- 顔の右に名前と、その下に UID。 -->
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Text.WidgetWindow}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding PlayerInfo.NameText}" />
                    <TextBlock Style="{StaticResource PlayerInfo.RowText}" Text="{Binding PlayerInfo.UidText}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0,5,0,0" DataContext="{Binding PlayerInfo}">
                <Grid Style="{StaticResource PlayerInfo.Line}">
                    <TextBlock Style="{StaticResource PlayerInfo.RowText}" VerticalAlignment="Center" Text="{Binding LevelText}" />
                </Grid>
                <Grid Style="{StaticResource PlayerInfo.Line}">
                    <TextBlock Style="{StaticResource PlayerInfo.RowText}" VerticalAlignment="Center" Text="{Binding SeasonRankText}" />
                </Grid>
                <Grid Style="{StaticResource PlayerInfo.Line}">
                    <TextBlock Style="{StaticResource PlayerInfo.RowText}" VerticalAlignment="Center" Text="{Binding LocationText}" />
                </Grid>
                <Grid Style="{StaticResource PlayerInfo.Line}">
                    <TextBlock Style="{StaticResource PlayerInfo.RowText}" VerticalAlignment="Center" Text="{Binding AbilityScoreText}" />
                </Grid>
                <Grid Style="{StaticResource PlayerInfo.Line}">
                    <TextBlock Style="{StaticResource PlayerInfo.RowText}" VerticalAlignment="Center" Text="{Binding SeasonStrengthText}" />
                </Grid>

                <!--
                    バッジ: シーズン / クラスと特化 / シーズン心相晶。絵の色はプレイヤー情報の設定のアイコンカラー。
                    絵には、ほかのウィジェットのアイコンと同じ影(Effect.ProfessionIconShadow)を付ける。
                -->
                <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                    <!-- シーズン。絵は形を抜いてシーズンの色で塗る。今のシーズンがまだ届いていなければはてな(不明の色)。 -->
                    <StackPanel Style="{StaticResource PlayerInfo.Badge}">
                        <Grid Style="{StaticResource PlayerInfo.BadgeIcon}">
                            <Rectangle Fill="{Binding SeasonIconBrush}"
                                       OpacityMask="{Binding SeasonIconMask}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Effect="{StaticResource Effect.ProfessionIconShadow}"
                                       Visibility="{Binding HasSeasonIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Rectangle Fill="{Binding UnknownIconBrush}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Effect="{StaticResource Effect.ProfessionIconShadow}"
                                       Visibility="{Binding IsSeasonUnknown, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Rectangle.OpacityMask>
                                    <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                                </Rectangle.OpacityMask>
                            </Rectangle>
                        </Grid>
                        <TextBlock Style="{StaticResource PlayerInfo.BadgeText}" Text="{Binding SeasonText}" />
                    </StackPanel>

                    <!-- クラスアイコンはプレイヤーリストと同じ絵。形が無ければ何も描かない(形の無い塗りは四角になる)。 -->
                    <StackPanel Style="{StaticResource PlayerInfo.Badge}">
                        <Grid Style="{StaticResource PlayerInfo.BadgeIcon}">
                            <Rectangle Fill="{Binding ClassIconBrush}"
                                       OpacityMask="{Binding ClassIconMask}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Effect="{StaticResource Effect.ProfessionIconShadow}"
                                       Visibility="{Binding HasClassIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource PlayerInfo.BadgeText}" Text="{Binding ClassSpecText}" />
                    </StackPanel>

                    <!-- シーズン心相晶。型の絵・無効の絵・不明のはてなのどれか。 -->
                    <StackPanel Style="{StaticResource PlayerInfo.Badge}">
                        <Grid Style="{StaticResource PlayerInfo.BadgeIcon}">
                            <Rectangle Fill="{Binding SeasonTalentIconBrush}"
                                       OpacityMask="{Binding SeasonTalentIconMask}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Effect="{StaticResource Effect.ProfessionIconShadow}"
                                       Visibility="{Binding HasSeasonTalentIcon, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                        <TextBlock Style="{StaticResource PlayerInfo.BadgeText}" Text="{Binding SeasonTalentText}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--
            名刺の半身。写真を取れたら写真、それ以外は既定の絵。大きさは既定の絵(260×430)と同じ縦横比。
            右クリックのメニューは顔と同じ。
        -->
        <Image Grid.Column="1"
               Width="130"
               Height="215"
               Margin="12,0,0,0"
               VerticalAlignment="Top"
               Source="{Binding CardImage}"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"
               Tag="{Binding InfoWidget}"
               ContextMenuService.IsEnabled="False"
               PreviewMouseRightButtonDown="CardImage_PreviewMouseRightButtonDown">
            <Image.ContextMenu>
                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                             Placement="MousePoint">
                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerInfo_SaveImageAs]}"
                              Click="SaveImageMenuItem_Click" />
                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PlayerInfo_CopyImage]}"
                              Click="CopyImageMenuItem_Click" />
                </ContextMenu>
            </Image.ContextMenu>
        </Image>
    </Grid>
</UserControl>
