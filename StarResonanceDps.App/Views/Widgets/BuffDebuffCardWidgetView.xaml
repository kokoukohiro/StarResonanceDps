<UserControl x:Class="StarResonanceDps.App.Views.Widgets.BuffDebuffCardWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:ScaleConverter x:Key="BuffDebuffCard.ScaleConverter" />
    </UserControl.Resources>

    <!--
        倍率は、字の大きさ・枠・余白・影のぼかしに掛けて組む(ConverterParameter が倍率 1 のときの値)。
        拡大の変形(RenderTransform)は使わない。変形で拡大すると行の位置が画素の途中に来る倍率があり、
        影の効果を持つ文字がにじむ。大きさで組めば、行の位置はレイアウトの丸めで画素にそろう。
        ウィンドウの大きさは倍率を変えても動かない(はみ出したぶんは隠れる)。

        バフを見失っても名前の行だけは残す。アイコン・重ね数・残り時間は HasBuff で消す。
        名前も一度も分かっていなければ全部消えて空ウィンドウになる。

        消すのは Hidden で、Collapsed にはしない。畳むと StackPanel が縮み、
        中央揃えのぶんだけ残った名前が動いてしまう。アイコン枠に高さを固定してあるのも同じ理由で、
        どの状態でも組み全体の大きさが変わらないようにしてある。

        文字の影は Effect.WidgetWindowTextShadow と同じ色と濃さで、ぼかしだけ倍率を掛けるので、文字ごとに直に置く。
    -->
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Margin="0,0,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Text.WidgetWindow}"
                       FontSize="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=8}"
                       FontWeight="SemiBold"
                       Text="{Binding DisplayText}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasDisplayText, Converter={StaticResource BooleanToVisibilityHiddenConverter}}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black"
                                      Opacity="1"
                                      ShadowDepth="0"
                                      BlurRadius="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=5}" />
                </TextBlock.Effect>
            </TextBlock>

            <Grid Width="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=32}"
                  Height="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=32}"
                  HorizontalAlignment="Center"
                  Visibility="{Binding HasBuff, Converter={StaticResource BooleanToVisibilityHiddenConverter}}">
                <!--
                    モジュール効果の絵は丸く画像いっぱいに描かれているので、バフの絵の中身の高さにそろえて小さく出す。
                    左へのずらしは余白で行う(変形だと絵の位置が画素の途中に来る)。左 -1・右 +1 で左へ 1 ずれる。
                -->
                <Image Source="{Binding IconPath, TargetNullValue={x:Null}}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModuleEffectIcon}" Value="True">
                                    <Setter Property="Width" Value="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=28}" />
                                    <Setter Property="Height" Value="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=28}" />
                                    <Setter Property="Margin" Value="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter='-1,0,1,0'}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!--
                    絵のパスはあるのにファイルが無いバフははてな(プレイヤーリストの技の枠と同じ作り)。大きさは絵の枠いっぱい。
                    影は Effect.ProfessionIconShadow と同じ値で、ずれとぼかしに倍率を掛ける(文字の影と同じく、変形で拡大しない)。
                -->
                <Rectangle Fill="White">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#000000"
                                          Opacity="0.5"
                                          ShadowDepth="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=2}"
                                          BlurRadius="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=5}" />
                    </Rectangle.Effect>
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsUnknownIcon}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.WidgetWindow}"
                           FontSize="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=20}"
                           FontWeight="SemiBold"
                           Text="{Binding LayerText}"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black"
                                          Opacity="1"
                                          ShadowDepth="0"
                                          BlurRadius="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=5}" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <TextBlock Margin="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter='0,-4,0,0'}"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Text.WidgetWindow}"
                       FontSize="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=12}"
                       FontWeight="SemiBold"
                       Text="{Binding DurationText}"
                       TextAlignment="Center"
                       Visibility="{Binding HasBuff, Converter={StaticResource BooleanToVisibilityHiddenConverter}}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black"
                                      Opacity="1"
                                      ShadowDepth="0"
                                      BlurRadius="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=5}" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
