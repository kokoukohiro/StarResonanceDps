<UserControl x:Class="StarResonanceDps.App.Views.Widgets.BuffDebuffCardWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Unloaded="BuffDebuffCardWidgetView_Unloaded">
    <UserControl.Resources>
        <converters:ScaleConverter x:Key="BuffDebuffCard.ScaleConverter" />

        <!--
            右クリックのメニュー。作りはバフ・デバフ一覧の行のメニューと同じで、項目は「グループに追加」「バフ・デバフカードのショートカットに追加」「このバフを通知対象にする」「〜しない」。
            足せる項目だけを出し、角丸は出している項目の並びで決める(1つなら四隅、2つなら上の項目の上と下の項目の下。画面のコードが Tag に入れる)。
            メニューの DataContext はカードの ViewModel(開くときに画面のコードが入れる)で、色はその Widget から引く。
        -->
        <CornerRadius x:Key="Menu.WidgetWindowBuffCardContextMenuItem.SingleCornerRadius">5</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowBuffCardContextMenuItem.FirstCornerRadius">5,5,0,0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowBuffCardContextMenuItem.LastCornerRadius">0,0,5,5</CornerRadius>

        <Style x:Key="Menu.WidgetWindowBuffCardContextMenu"
               TargetType="{x:Type ContextMenu}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowMenuSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate.WidgetWindowBuffCardMenuText">
            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="Menu.WidgetWindowBuffCardContextMenuItem"
               TargetType="{x:Type MenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DataTemplate.WidgetWindowBuffCardMenuText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowBuffCardContextMenuItem.SingleCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Background="{Binding Widget.WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                                    CornerRadius="{TemplateBinding Tag}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ContextMenu x:Key="BuffDebuffCard.ContextMenu"
                     Style="{StaticResource Menu.WidgetWindowBuffCardContextMenu}"
                     Placement="MousePoint">
            <!-- 並びは画面のコードが項目を見分けるのに使う(1つ目がグループ、2つ目がショートカット、3つ目が通知対象)。 -->
            <MenuItem Style="{StaticResource Menu.WidgetWindowBuffCardContextMenuItem}"
                      Header="{Binding AddToGroupMenuText}"
                      Command="{Binding AddToGroupCommand}" />
            <MenuItem Style="{StaticResource Menu.WidgetWindowBuffCardContextMenuItem}"
                      Header="{Binding AddToShortcutsMenuText}"
                      Command="{Binding AddToShortcutsCommand}" />
            <MenuItem Style="{StaticResource Menu.WidgetWindowBuffCardContextMenuItem}"
                      Header="{Binding NotificationTargetMenuText}"
                      Command="{Binding ToggleNotificationTargetCommand}" />
        </ContextMenu>
    </UserControl.Resources>

    <!--
        倍率は、字の大きさ・枠・余白・影のぼかしに掛けて組む(ConverterParameter が倍率 1 のときの値)。
        拡大の変形(RenderTransform)は使わない。変形で拡大すると行の位置が画素の途中に来る倍率があり、
        影の効果を持つ文字がにじむ。大きさで組めば、行の位置はレイアウトの丸めで画素にそろう。
        ウィンドウの大きさは倍率を変えても動かない(はみ出したぶんは隠れる)。

        バフを見失っても名前の行だけは残す。アイコン・重ね数・残り時間は HasBuff で消す。
        名前も一度も分かっていなければ全部消えて空ウィンドウになる。

        消すのは Hidden で、Collapsed にはしない。畳むと StackPanel が縮み、
        中央揃えのぶんだけ残った名前が動いてしまう。アイコン枠に高さを固定してあるのも同じ理由で、
        どの状態でも組み全体の大きさが変わらないようにしてある。

        文字の影は Effect.WidgetWindowTextShadow と同じ色と濃さで、ぼかしだけ倍率を掛けるので、文字ごとに直に置く。

        右クリックはカードのどこでも受ける(透明の地で当たりを取る)。メニューを開くかは画面のコードが決める。
    -->
    <Grid Background="Transparent"
          PreviewMouseRightButtonDown="Card_PreviewMouseRightButtonDown">
        <StackPanel HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <TextBlock Margin="0,0,0,0"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Text.WidgetWindow}"
                       FontSize="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=8}"
                       FontWeight="SemiBold"
                       Text="{Binding DisplayText}"
                       TextAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasDisplayText, Converter={StaticResource BooleanToVisibilityHiddenConverter}}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black"
                                      Opacity="1"
                                      ShadowDepth="0"
                                      BlurRadius="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=5}" />
                </TextBlock.Effect>
            </TextBlock>

            <Grid Width="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=32}"
                  Height="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=32}"
                  HorizontalAlignment="Center"
                  Visibility="{Binding HasBuff, Converter={StaticResource BooleanToVisibilityHiddenConverter}}">
                <!--
                    モジュール効果の絵は丸く画像いっぱいに描かれているので、バフの絵の中身の高さにそろえて小さく出す。
                    因子の絵は大きさはそのままで、左へずらす(モジュール効果とは別の値)。
                    左へのずらしは余白で行う(変形だと絵の位置が画素の途中に来る)。左 -1・右 +1 で左へ 1 ずれる。
                -->
                <Image Source="{Binding IconPath, TargetNullValue={x:Null}}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModuleEffectIcon}" Value="True">
                                    <Setter Property="Width" Value="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=28}" />
                                    <Setter Property="Height" Value="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=28}" />
                                    <Setter Property="Margin" Value="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter='-1,0,1,0'}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsFactorIcon}" Value="True">
                                    <Setter Property="Margin" Value="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter='-1,0,1,0'}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>

                <!--
                    絵のパスはあるのにファイルが無いバフははてな(プレイヤーリストの技の枠と同じ作り)。大きさは絵の枠いっぱい。
                    影は Effect.ProfessionIconShadow と同じ値で、ずれとぼかしに倍率を掛ける(文字の影と同じく、変形で拡大しない)。
                -->
                <Rectangle Fill="White">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#000000"
                                          Opacity="0.5"
                                          ShadowDepth="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=2}"
                                          BlurRadius="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=5}" />
                    </Rectangle.Effect>
                    <Rectangle.OpacityMask>
                        <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                    </Rectangle.OpacityMask>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowsUnknownIcon}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <!--
                    絵が Icons.xaml の絵(装備効果)なら、白く塗った面をその絵で型抜きする(はてなと同じ作り、影の値も同じ)。
                    位置はモジュール効果の絵と同じく余白で左へ 1 ずらす(左 -1・右 +1、要素ごとの値)。
                -->
                <Rectangle Fill="White"
                           OpacityMask="{Binding IconMask}"
                           Margin="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter='-0.5,0,0.5,0'}">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="#000000"
                                          Opacity="0.5"
                                          ShadowDepth="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=2}"
                                          BlurRadius="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=5}" />
                    </Rectangle.Effect>
                    <Rectangle.Style>
                        <Style TargetType="Rectangle">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IconMask}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Rectangle.Style>
                </Rectangle>

                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource Text.WidgetWindow}"
                           FontSize="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=20}"
                           FontWeight="SemiBold"
                           Text="{Binding LayerText}"
                           TextAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black"
                                          Opacity="1"
                                          ShadowDepth="0"
                                          BlurRadius="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=5}" />
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>

            <TextBlock Margin="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter='0,-4,0,0'}"
                       HorizontalAlignment="Center"
                       Style="{StaticResource Text.WidgetWindow}"
                       FontSize="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=12}"
                       FontWeight="SemiBold"
                       Text="{Binding DurationText}"
                       TextAlignment="Center"
                       Visibility="{Binding HasBuff, Converter={StaticResource BooleanToVisibilityHiddenConverter}}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black"
                                      Opacity="1"
                                      ShadowDepth="0"
                                      BlurRadius="{Binding Scale, Converter={StaticResource BuffDebuffCard.ScaleConverter}, ConverterParameter=5}" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
