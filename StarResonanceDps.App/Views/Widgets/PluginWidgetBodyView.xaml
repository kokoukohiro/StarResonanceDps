<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PluginWidgetBodyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             behaviors:ThemePaletteScope.Palette="{Binding WidgetPalette}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        プラグインが作った本体かフッター。DataContext を切り、本体の型を受け継がせない(プラグインは自分で入れる)。
        定義の UsesWidgetColors なら、窓の値の WidgetPalette でウィジェットの色を Brush.* に書く(背景画像のときは書かない)。
    -->
    <ContentControl x:Name="ElementHost"
                    DataContext="{x:Null}"
                    Focusable="False"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
</UserControl>
