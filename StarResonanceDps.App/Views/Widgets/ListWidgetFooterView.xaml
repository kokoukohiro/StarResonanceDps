<UserControl x:Class="StarResonanceDps.App.Views.Widgets.ListWidgetFooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Margin="10,0,8,0"
                   VerticalAlignment="Center"
                   Style="{StaticResource Text.WidgetWindow}"
                   FontSize="13"
                   FontWeight="SemiBold"
                   Text="{Binding MapName}"
                   TextAlignment="Left"
                   TextTrimming="CharacterEllipsis" />

        <!--
            右の2組(プレイヤーリスト・エンティティリスト・マップ)。見出しのコロンから数字の右端までの間隔は数字の欄の幅で、
            日本語の個数の表示(「12体」を幅53の欄に右寄せしていたとき)と同じ40。4桁の得点「0000」は29で、11の空きが残る。
        -->
        <StackPanel Grid.Column="1"
                    Margin="8,0,10,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <controls:FooterValuePair Label="{Binding FooterCombatLabel}"
                                      Value="{Binding FooterCombatValue}"
                                      NumberWidth="40" />
            <controls:FooterValuePair Margin="16,0,0,0"
                                      Label="{Binding FooterOverallLabel}"
                                      Value="{Binding FooterOverallValue}"
                                      NumberWidth="40" />
        </StackPanel>
    </Grid>
</UserControl>
