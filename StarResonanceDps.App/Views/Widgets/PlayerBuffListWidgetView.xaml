<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerBuffListWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:local="clr-namespace:StarResonanceDps.App.Views.Widgets"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="PlayerBuffListWidgetView_Loaded"
             Unloaded="PlayerBuffListWidgetView_Unloaded"
             SizeChanged="PlayerBuffListWidgetView_SizeChanged"
             DataContextChanged="PlayerBuffListWidgetView_DataContextChanged">
    <UserControl.Resources>
        <!--
            行内テキストの共通スタイル。全部左寄せで、収まらないぶんは省略記号で切る。
        -->
        <Style x:Key="BuffList.RowText" TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--
            残り時間。行の右端の列に右寄せで置く。
            単位は DurationWithUnitText に含まれているので、ここでは並べない
            (単位なしの DurationText はプレイヤーリストのバッジ用)。
        -->
        <Style x:Key="BuffList.Duration" TargetType="TextBlock" BasedOn="{StaticResource BuffList.RowText}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!--
            行の右クリックのメニュー。作りはエンティティリストと同じ。
            メニューの DataContext は一覧の ViewModel(IBuffListWindowViewModel)で、色はその Widget から引く。
        -->
        <CornerRadius x:Key="Menu.WidgetWindowBuffListContextMenuItem.FirstCornerRadius">5,5,0,0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowBuffListContextMenuItem.MiddleCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowBuffListContextMenuItem.LastCornerRadius">0,0,5,5</CornerRadius>

        <Style x:Key="Menu.WidgetWindowBuffListContextMenu"
               TargetType="{x:Type ContextMenu}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowMenuSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{Binding Widget.WidgetWindowPalette.WidgetWindowDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate.WidgetWindowMenuText">
            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="Menu.WidgetWindowBuffListContextMenuItem"
               TargetType="{x:Type MenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DataTemplate.WidgetWindowMenuText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowBuffListContextMenuItem.MiddleCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Background="{Binding Widget.WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                                    CornerRadius="{TemplateBinding Tag}"
                                    Opacity="{Binding Widget.WidgetWindowPalette.MenuOpacity}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Menu.WidgetWindowBuffListContextMenuItem.First"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowBuffListContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowBuffListContextMenuItem.FirstCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowBuffListContextMenuItem.Middle"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowBuffListContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowBuffListContextMenuItem.MiddleCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowBuffListContextMenuItem.Last"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowBuffListContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowBuffListContextMenuItem.LastCornerRadius}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 余白はメーター・プレイヤーリストと同じ(左5・右0)。ホバーの枠が同じ位置で始まる。 -->
        <ScrollViewer x:Name="BuffListScrollViewer"
                      Margin="5,5,0,5"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      CanContentScroll="False"
                      ScrollChanged="BuffListScrollViewer_ScrollChanged">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Height="31"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                ContextMenuService.IsEnabled="False"
                                PreviewMouseRightButtonDown="BuffListItem_PreviewMouseRightButtonDown"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:PlayerBuffListWidgetView}}}"
                                Command="{Binding DataContext.OpenCardCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                CommandParameter="{Binding}">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                             IsOpen="{Binding PlacementTarget.DataContext.IsMenuOpen, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                                             Placement="MousePoint"
                                             Opened="BuffContextMenu_Opened"
                                             Closed="BuffContextMenu_Closed">
                                    <MenuItem Header="{Binding CardMenuText}"
                                              Command="{Binding OpenCardCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="{Binding HideMenuText}"
                                              Command="{Binding HideBuffCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid SnapsToDevicePixels="True">
                                                    <Border x:Name="InteractionBackground"
                                                            Background="{Binding DataContext.WidgetWindowPalette.WidgetWindowScrollThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            Visibility="Collapsed">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.NonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                                        <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.ActiveNonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsMenuOpen}" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>

                            <Grid VerticalAlignment="Center">
                                <!--
                                    メーターの行と同じ組み方。名前は残りの幅いっぱい、残り時間は右端。
                                -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0"
                                      Width="30"
                                      Height="30"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center">
                                    <Image Source="{Binding IconPath, TargetNullValue={x:Null}}"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality" />

                                    <!-- スタック数はアイコンに重ねたまま。 -->
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource Text.WidgetWindow}"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Text="{Binding LayerText}"
                                               TextAlignment="Center" />
                                </Grid>

                                <!--
                                    ゲージはアイコンの外(右)だけに伸びる。色は設定の固定グラデーション。
                                -->
                                <Grid x:Name="GaugeArea"
                                      Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Margin="0,0,2,0"
                                      ClipToBounds="True">
                                    <!--
                                        2層にする。外は幅が動く窓で、中は常に満タンの幅で塗る
                                        (エンティティリストの HP バーと同じ作り)。
                                        1枚で幅を動かすと、グラデーションがバーと一緒に縮んでしまう。

                                        幅はアニメーションで動かす(behaviors:BarWidthAnimationBehavior)。
                                        1秒ごとに値を差し替えるだけだと、その間隔ぶん跳んで見える。
                                    -->
                                    <Grid Height="26"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"
                                          ClipToBounds="True"
                                          behaviors:BarWidthAnimationBehavior.AreaWidth="{Binding ActualWidth, ElementName=GaugeArea}"
                                          behaviors:BarWidthAnimationBehavior.DecaySeconds="{Binding BarDecaySeconds}"
                                          behaviors:BarWidthAnimationBehavior.Ratio="{Binding BarRatio}"
                                          behaviors:BarWidthAnimationBehavior.SnapsToTarget="True">
                                        <!--
                                            右端の角丸は窓に切られるので、短いうちは直角、満タンでだけ丸く見える。
                                        -->
                                        <Border Width="{Binding ActualWidth, ElementName=GaugeArea}"
                                                HorizontalAlignment="Left"
                                                CornerRadius="4"
                                                Background="{Binding DataContext.GaugeBrush, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
                                    </Grid>
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Margin="6,0,6,0"
                                           Style="{StaticResource BuffList.RowText}"
                                           Text="{Binding Name}" />

                                <TextBlock Grid.Column="2"
                                           Margin="0,0,8,0"
                                           Style="{StaticResource BuffList.Duration}"
                                           Text="{Binding DurationWithUnitText}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
