<UserControl x:Class="StarResonanceDps.App.Views.Widgets.EntityListWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StarResonanceDps.App.Views.Widgets"
             xmlns:converters="clr-namespace:StarResonanceDps.App.Converters"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:services="clr-namespace:StarResonanceDps.App.Services"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <converters:HealthRatioToWidthConverter x:Key="EntityList.RatioToWidthConverter" />
        <converters:HateGaugeFillHeightConverter x:Key="EntityList.HateGaugeFillHeightConverter" />
        <converters:CenteredOffsetConverter x:Key="EntityList.CenteredOffsetConverter" />

        <CornerRadius x:Key="Menu.WidgetWindowEntitySelectionContextMenuItem.FirstCornerRadius">5,5,0,0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowEntitySelectionContextMenuItem.MiddleCornerRadius">0</CornerRadius>
        <CornerRadius x:Key="Menu.WidgetWindowEntitySelectionContextMenuItem.LastCornerRadius">0,0,5,5</CornerRadius>

        <Style x:Key="Menu.WidgetWindowEntitySelectionContextMenu"
               TargetType="{x:Type ContextMenu}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Background" Value="{Binding WidgetWindowPalette.WidgetWindowMenuSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{Binding WidgetWindowPalette.WidgetWindowDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding WidgetWindowPalette.MenuOpacity}" />
                            <Border BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource Radius.Default}"
                                    Opacity="{Binding WidgetWindowPalette.MenuOpacity}" />
                            <StackPanel Margin="{TemplateBinding Padding}"
                                        IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DataTemplate.WidgetWindowMenuText">
            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                       Text="{Binding}" />
        </DataTemplate>

        <Style x:Key="Menu.WidgetWindowEntitySelectionContextMenuItem"
               TargetType="{x:Type MenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="HeaderTemplate" Value="{StaticResource DataTemplate.WidgetWindowMenuText}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowEntitySelectionContextMenuItem.MiddleCornerRadius}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="InteractionBackground"
                                    Background="{Binding WidgetWindowPalette.WidgetWindowScrollThumbBrush}"
                                    CornerRadius="{TemplateBinding Tag}"
                                    Opacity="{Binding WidgetWindowPalette.MenuOpacity}"
                                    Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              Content="{TemplateBinding Header}"
                                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                                              ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="InteractionBackground"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Menu.WidgetWindowEntitySelectionContextMenuItem.First"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowEntitySelectionContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowEntitySelectionContextMenuItem.FirstCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowEntitySelectionContextMenuItem.Middle"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowEntitySelectionContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowEntitySelectionContextMenuItem.MiddleCornerRadius}" />
        </Style>

        <Style x:Key="Menu.WidgetWindowEntitySelectionContextMenuItem.Last"
               TargetType="{x:Type MenuItem}"
               BasedOn="{StaticResource Menu.WidgetWindowEntitySelectionContextMenuItem}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Tag" Value="{StaticResource Menu.WidgetWindowEntitySelectionContextMenuItem.LastCornerRadius}" />
        </Style>

        <!--
            ヘイトの枠(EntityHateSlot)。HP バーの右に、狙っている相手がいて表示設定「狙われるプレイヤー」が表示なら左端がその相手で続けてヘイト1位から、
            そうでなければ左端からヘイト1位を詰めて並べる。ヘイトは表示設定「ヘイト値」の人数(1〜5人)まで(並べ方は EntityListEntry)。
            出すものが無い枠は場所を残して隠す。
            中身はクラスアイコン(25、プレイヤーリストと同じ大きさ)・プレイヤー名・バッジ。
            バッジは枠の中に寄せ方と Margin で置く(プレイヤーリストのデバフバッジと同じ作り)。枠を越えた分は切れる。バッジはクラスアイコンの背面。
            大きさはこの XAML の数字。ゲージの塗る高さは、ゲージの実際の大きさと割合から決める(HateGaugeFillHeightConverter)。
            狙っている相手の印は、色を絵の形で抜いて描く(絵は焼き込みの影を抜いた白い形)。影は付けない。ヘイトのゲージは形を下から充填の色で塗り、塗っていない上の部分を黒で塗る
            (同じ形を2枚重ねると、縁の半透明の画素で下の黒が透けて枠に見える)。
            TIPS はクラスアイコン・プレイヤー名・狙っている相手の印・ゲージにそれぞれ置き(文はどれも「特化名(…)」)、枠には置かない。
            WPF は TIPS を持つ要素の四角と開いた TIPS の四角を囲む範囲の中では TIPS を替えないので、枠に置くとその範囲が枠の四角になる。
            当たり判定は型抜きを見ずに四角で当たり、文字は欄の四角全体で当たる。プレイヤー名は欄を文字の幅にし、
            ゲージの絵は箱(45)の上下に空きが大きいので、絵はマウスを受けず、見える形を囲む四角(35×17、絵の不透明度10%以上の画素の範囲)で受ける。
            ツールチップの色は窓のパレット(TIPS を持つ要素の Tag にウィジェットを入れる。戦闘状態の印と同じ)。
        -->
        <DataTemplate x:Key="EntityList.HateSlotTemplate">
            <Grid Width="42"
                  Height="34">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsShown}" Value="False">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- 今狙っている相手の印。色を絵の形で抜いて描く(ゲージの充填と同じ作り)。 -->
                <Rectangle Width="30"
                           Height="30"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="5,-11,0,0"
                           Fill="{x:Static services:HateBadgeImages.AccentBrush}"
                           OpacityMask="{x:Static services:HateBadgeImages.TargetMask}"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding IsTarget, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:EntityListWidgetView}}}">
                    <Rectangle.ToolTip>
                        <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                 Style="{StaticResource ToolTip.WidgetWindowInfo}">
                            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                       FontSize="12"
                                       Text="{Binding ToolTipText}" />
                        </ToolTip>
                    </Rectangle.ToolTip>
                </Rectangle>

                <!--
                    ヘイトのゲージ。充填(下から)と黒の地(上から)は Canvas の高さで切る(端数の高さを丸めないように、ここだけ画素へ丸めない)。
                    マウスは見える形を囲む透明な四角だけが受ける。
                -->
                <Grid x:Name="HateGaugeHost"
                      Width="45"
                      Height="45"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Margin="5,-11,0,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Canvas VerticalAlignment="Top"
                            ClipToBounds="True"
                            UseLayoutRounding="False"
                            IsHitTestVisible="False">
                        <Canvas.Height>
                            <MultiBinding Converter="{StaticResource EntityList.HateGaugeFillHeightConverter}"
                                          ConverterParameter="Empty">
                                <Binding Path="GaugeRatio" />
                                <Binding ElementName="HateGaugeHost"
                                         Path="ActualWidth" />
                                <Binding ElementName="HateGaugeHost"
                                         Path="ActualHeight" />
                            </MultiBinding>
                        </Canvas.Height>
                        <Rectangle Canvas.Top="0"
                                   Width="{Binding ActualWidth, ElementName=HateGaugeHost}"
                                   Height="{Binding ActualHeight, ElementName=HateGaugeHost}"
                                   Fill="#FF000000"
                                   OpacityMask="{x:Static services:HateBadgeImages.GaugeMask}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                    </Canvas>
                    <Canvas VerticalAlignment="Bottom"
                            ClipToBounds="True"
                            UseLayoutRounding="False"
                            IsHitTestVisible="False">
                        <Canvas.Height>
                            <MultiBinding Converter="{StaticResource EntityList.HateGaugeFillHeightConverter}">
                                <Binding Path="GaugeRatio" />
                                <Binding ElementName="HateGaugeHost"
                                         Path="ActualWidth" />
                                <Binding ElementName="HateGaugeHost"
                                         Path="ActualHeight" />
                            </MultiBinding>
                        </Canvas.Height>
                        <Rectangle Canvas.Bottom="0"
                                   Width="{Binding ActualWidth, ElementName=HateGaugeHost}"
                                   Height="{Binding ActualHeight, ElementName=HateGaugeHost}"
                                   Fill="{x:Static services:HateBadgeImages.AccentBrush}"
                                   OpacityMask="{x:Static services:HateBadgeImages.GaugeMask}"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                    </Canvas>
                    <Rectangle Width="35"
                               Height="17"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Fill="Transparent"
                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:EntityListWidgetView}}}">
                        <Rectangle.ToolTip>
                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                           FontSize="12"
                                           Text="{Binding ToolTipText}" />
                            </ToolTip>
                        </Rectangle.ToolTip>
                    </Rectangle>
                </Grid>

                <!--
                    クラスアイコンとプレイヤー名。バッジより後に置いて前面に描く。
                    組み方はプレイヤーリストのクラスアイコンと特化の文字と同じ: 箱(幅はアイコンの幅)の上にアイコン、
                    名前は Canvas に置いてアイコンの中心に合わせる(幅は枠の幅、上から 21 でアイコンに 4 重ねる)。
                    Canvas の中なので、名前が箱からはみ出しても切れない。入らなければ「…」。
                    名前の欄は枠の幅の中で中央に寄せて文字の幅にする(TIPS を受けるのは文字の上だけ)。
                -->
                <Grid Width="25"
                      HorizontalAlignment="Left">
                    <Rectangle Width="25"
                               Height="25"
                               VerticalAlignment="Top"
                               Fill="{Binding ClassBrush}"
                               OpacityMask="{Binding ClassIconMask}"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Effect="{StaticResource Effect.ProfessionIconShadow}"
                               Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:EntityListWidgetView}}}">
                        <Rectangle.ToolTip>
                            <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                     Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                           FontSize="12"
                                           Text="{Binding ToolTipText}" />
                            </ToolTip>
                        </Rectangle.ToolTip>
                    </Rectangle>
                    <Canvas>
                        <Grid Canvas.Left="-8.5"
                              Canvas.Top="21"
                              Width="42">
                            <TextBlock HorizontalAlignment="Center"
                                       Style="{StaticResource Text.WidgetWindow}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Text="{Binding PlayerName}"
                                       TextTrimming="CharacterEllipsis"
                                       Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:EntityListWidgetView}}}">
                                <TextBlock.ToolTip>
                                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                             Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                        <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                                   FontSize="12"
                                                   Text="{Binding ToolTipText}" />
                                    </ToolTip>
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                    </Canvas>
                </Grid>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!--
            左マージンは行側(Button)へ移してある。ScrollViewer は必ず自分の枠でクリップするので、
            ここに 5px を残すとクリップ境界も 5px 内側に来る。分類名テキストは列幅(33)より広く
            はみ出させるため、その 5px を左の余地として使いたい。描画位置は行の Margin で
            相殺しているので見た目は変わらない。

            行は見えている分だけ作る(仮想化)。仮想化はリスト自身のテンプレートの中に ScrollViewer が無いと効かない
            (外側に ScrollViewer を置くと全行が実体化する)。行の部品は別の敵の行に使い回される。
        -->
            <ItemsControl x:Name="EntityListItemsControl"
                          ItemsSource="{Binding EntityListEntries}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VirtualizingStackPanel.CleanUpVirtualizedItem="EntityListItemsControl_CleanUpVirtualizedItem">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer x:Name="EntityListScrollViewer"
                                      Margin="0,5,0,5"
                                      VerticalScrollBarVisibility="Hidden"
                                      HorizontalScrollBarVisibility="Disabled"
                                      CanContentScroll="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Height="44"
                                Margin="5,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False"
                                ContextMenuService.IsEnabled="False"
                                PreviewMouseRightButtonDown="EntityListItem_PreviewMouseRightButtonDown"
                                Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:EntityListWidgetView}}}"
                                Click="EntityListItem_Click"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <Button.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                             IsOpen="{Binding PlacementTarget.DataContext.IsEntitySelectionMenuOpen, RelativeSource={RelativeSource Self}, Mode=TwoWay}"
                                             Placement="MousePoint"
                                             Opened="EntitySelectionContextMenu_Opened"
                                             Closed="EntitySelectionContextMenu_Closed">
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_BuffList]}"
                                              Command="{Binding RequestEntityBuffListCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                    <MenuItem Header="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Widget_DebuffList]}"
                                              Command="{Binding RequestEntityDebuffListCommand}"
                                              CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid SnapsToDevicePixels="True">
                                                    <Border x:Name="InteractionBackground"
                                                            Background="{Binding DataContext.WidgetWindowPalette.WidgetWindowScrollThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type local:EntityListWidgetView}}}"
                                                            Visibility="Collapsed">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.NonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:EntityListWidgetView}}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                                        <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.ActiveNonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type local:EntityListWidgetView}}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsEntitySelectionMenuOpen}" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>

                            <Grid VerticalAlignment="Center">
                                <Grid.RenderTransform>
                                    <TranslateTransform X="4" />
                                </Grid.RenderTransform>
                                <!-- 幅はプレイヤーリストと同じ。名前は 128 の列で「…」に切れる。残りの列にヘイトの枠。 -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="33" />
                                    <ColumnDefinition Width="128" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Rectangle Width="25"
                                               Height="25"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Fill="{Binding ClassBrush}"
                                               Effect="{StaticResource Effect.ProfessionIconShadow}">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
                                                <Setter Property="OpacityMask">
                                                    <Setter.Value>
                                                        <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClassificationKey}" Value="Monster">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.Monster}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ClassificationKey}" Value="Elite">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.Elite}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding ClassificationKey}" Value="Boss">
                                                        <Setter Property="OpacityMask">
                                                            <Setter.Value>
                                                                <ImageBrush ImageSource="{StaticResource Icon.Profession.Boss}" Stretch="Uniform" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                </Grid>
                                
                                <!-- HP の数字はゲージより長いと左右にはみ出す。右のヘイトの枠より上に描くため前に出す(プレイヤーリストと同じ)。 -->
                                <Grid Grid.Column="1"
                                      Panel.ZIndex="1"
                                      Height="34"
                                      Margin="6,0,0,0"
                                      VerticalAlignment="Center"
                                      ClipToBounds="False">
                                    <Grid.Resources>
                                        <!--
                                            名前の行(ブレイクゲージの有無で2か所から使う)。
                                            戦闘状態の印(設定「戦闘状態」)は名前の左。出さない行は幅も空けない。
                                            色・型抜き・影は Icon.CombatStateMask、大きさと余白はプレイヤーリストと同じ値。
                                            ツールチップはプレイヤーリストと同じ作り(Tag にウィジェットを入れて色を窓のパレットから引く)。
                                        -->
                                        <DataTemplate x:Key="EntityNameRowTemplate">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Rectangle Width="24"
                                                           Height="24"
                                                           Margin="-4,2,-3,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource Icon.CombatStateMask}"
                                                           Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type local:EntityListWidgetView}}}"
                                                           Visibility="{Binding ShowsCombatState, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Rectangle.ToolTip>
                                                        <ToolTip Style="{StaticResource ToolTip.WidgetWindowInfo}">
                                                            <TextBlock Style="{StaticResource Text.WidgetWindow}"
                                                                       FontSize="12"
                                                                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[CombatState_Tip]}" />
                                                        </ToolTip>
                                                    </Rectangle.ToolTip>
                                                </Rectangle>

                                                <TextBlock Grid.Column="1"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource Text.WidgetWindow}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DisplayName}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>

                                        <DataTemplate x:Key="EntityHealthRowTemplate">
                                            <Grid Height="10"
                                                  ClipToBounds="False">
                                                <Border Width="122"
                                                        Height="10"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        Background="#FF000000"
                                                        CornerRadius="5"
                                                        Padding="1">
                                                    <Grid x:Name="EntityHealthFillHost"
                                                          Height="8"
                                                          VerticalAlignment="Center">
                                                        <Grid.Clip>
                                                            <RectangleGeometry Rect="0,0,120,8"
                                                                               RadiusX="4"
                                                                               RadiusY="4" />
                                                        </Grid.Clip>

                                                        <Canvas Width="120"
                                                                Height="8">
                                                            <Grid Panel.ZIndex="0"
                                                                  Canvas.Left="0"
                                                                  Height="8"
                                                                  ClipToBounds="True">
                                                                <Grid.Width>
                                                                    <MultiBinding Converter="{StaticResource EntityList.RatioToWidthConverter}">
                                                                        <Binding Path="HealthRatio" />
                                                                        <Binding ElementName="EntityHealthFillHost"
                                                                                 Path="ActualWidth" />
                                                                    </MultiBinding>
                                                                </Grid.Width>

                                                                <Border Width="120"
                                                                        Height="8"
                                                                        HorizontalAlignment="Left">
                                                                    <Border.Style>
                                                                        <Style TargetType="{x:Type Border}">
                                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                            <Setter Property="Background">
                                                                                <Setter.Value>
                                                                                    <LinearGradientBrush StartPoint="0,0.5"
                                                                                                         EndPoint="1,0.5">
                                                                                        <GradientStop Color="#FFFF0900"
                                                                                                      Offset="0" />
                                                                                        <GradientStop Color="#FFFF0900"
                                                                                                      Offset="0.05" />
                                                                                        <GradientStop Color="#FFFF8604"
                                                                                                      Offset="0.95" />
                                                                                        <GradientStop Color="#FFFF8604"
                                                                                                      Offset="1" />
                                                                                    </LinearGradientBrush>
                                                                                </Setter.Value>
                                                                            </Setter>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding UsesFriendlyHealthBar}"
                                                                                             Value="True">
                                                                                    <Setter Property="Background"
                                                                                            Value="#FF1CE6A7" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding IsInvulnerable}"
                                                                                             Value="True">
                                                                                    <Setter Property="Background"
                                                                                            Value="#FFA8A8A8" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                </Border>
                                                            </Grid>

                                                            <Border Panel.ZIndex="1"
                                                                    Height="8"
                                                                    Background="#FFFEFEFE">
                                                                <Canvas.Left>
                                                                    <MultiBinding Converter="{StaticResource EntityList.RatioToWidthConverter}">
                                                                        <Binding Path="HealthRatio" />
                                                                        <Binding ElementName="EntityHealthFillHost"
                                                                                 Path="ActualWidth" />
                                                                    </MultiBinding>
                                                                </Canvas.Left>
                                                                <Border.Width>
                                                                    <MultiBinding Converter="{StaticResource EntityList.RatioToWidthConverter}">
                                                                        <Binding Path="ShieldVisibleRatio" />
                                                                        <Binding ElementName="EntityHealthFillHost"
                                                                                 Path="ActualWidth" />
                                                                    </MultiBinding>
                                                                </Border.Width>
                                                            </Border>

                                                            <Border Panel.ZIndex="2"
                                                                    Height="8"
                                                                    Background="#FFFEFEFE">
                                                                <Canvas.Left>
                                                                    <MultiBinding Converter="{StaticResource EntityList.RatioToWidthConverter}">
                                                                        <Binding Path="ShieldOverflowStartRatio" />
                                                                        <Binding ElementName="EntityHealthFillHost"
                                                                                 Path="ActualWidth" />
                                                                    </MultiBinding>
                                                                </Canvas.Left>
                                                                <Border.Width>
                                                                    <MultiBinding Converter="{StaticResource EntityList.RatioToWidthConverter}">
                                                                        <Binding Path="ShieldOverflowRatio" />
                                                                        <Binding ElementName="EntityHealthFillHost"
                                                                                 Path="ActualWidth" />
                                                                    </MultiBinding>
                                                                </Border.Width>
                                                            </Border>
                                                        </Canvas>
                                                    </Grid>
                                                </Border>

                                                <Canvas Panel.ZIndex="3"
                                                        Width="122"
                                                        Height="10"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Center"
                                                        ClipToBounds="False"
                                                        IsHitTestVisible="False">
                                                    <!-- 幅は数字の長さのまま、ゲージの中心にそろえる。ゲージより長ければ左右に同じだけはみ出す(切らない)。 -->
                                                    <TextBlock Canvas.Top="-3"
                                                               Style="{StaticResource Text.WidgetWindow}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding HealthText}">
                                                        <Canvas.Left>
                                                            <MultiBinding Converter="{StaticResource EntityList.CenteredOffsetConverter}">
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType={x:Type Canvas}}" />
                                                                <Binding Path="ActualWidth" RelativeSource="{RelativeSource Self}" />
                                                            </MultiBinding>
                                                        </Canvas.Left>
                                                    </TextBlock>
                                                </Canvas>
                                            </Grid>
                                        </DataTemplate>
                                    </Grid.Resources>

                                    <!-- ブレイクゲージも詠唱ゲージもなし：実際の23 + 11構造 -->
                                    <Grid>
                                        <Grid.Style>
                                            <Style TargetType="{x:Type Grid}">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Visibility"
                                                        Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowsSecondGauge}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="23" />
                                            <RowDefinition Height="11" />
                                        </Grid.RowDefinitions>

                                        <ContentPresenter Grid.Row="0"
                                                          Content="{Binding}"
                                                          ContentTemplate="{StaticResource EntityNameRowTemplate}" />

                                        <ContentPresenter Grid.Row="1"
                                                          Content="{Binding}"
                                                          ContentTemplate="{StaticResource EntityHealthRowTemplate}" />
                                    </Grid>

                                    <!-- ブレイクゲージか詠唱ゲージあり：実際の12 + 11 + 11構造。詠唱中は3段目をブレイクゲージから詠唱ゲージに替える -->
                                    <Grid Margin="0,-4,0,0">
                                        <Grid.Style>
                                            <Style TargetType="{x:Type Grid}">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Visibility"
                                                        Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowsSecondGauge}"
                                                                 Value="True">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="15" />
                                            <RowDefinition Height="10" />
                                            <RowDefinition Height="10" />
                                        </Grid.RowDefinitions>

                                        <ContentPresenter Grid.Row="0"
                                                          Content="{Binding}"
                                                          ContentTemplate="{StaticResource EntityNameRowTemplate}" />

                                        <ContentPresenter Grid.Row="1"
                                                          Content="{Binding}"
                                                          ContentTemplate="{StaticResource EntityHealthRowTemplate}" />

                                        <!-- ブレイクゲージ。詠唱中は出さない -->
                                        <Grid Grid.Row="2">
                                            <Grid.Style>
                                                <Style TargetType="{x:Type Grid}">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCasting}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Border Width="122"
                                                    Height="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="#FF000000"
                                                    CornerRadius="5"
                                                    Padding="1">
                                                <Grid x:Name="BreakFillHost"
                                                      Height="8"
                                                      VerticalAlignment="Center">
                                                    <Grid.Clip>
                                                        <RectangleGeometry Rect="0,0,120,8"
                                                                           RadiusX="4"
                                                                           RadiusY="4" />
                                                    </Grid.Clip>

                                                    <Border Height="8"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="{x:Type Border}">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Background"
                                                                        Value="#FFF7E8D3" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsBreakLocked}"
                                                                                 Value="True">
                                                                        <Setter Property="Background"
                                                                                Value="#FFA8A8A8" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Border.Width>
                                                            <MultiBinding Converter="{StaticResource EntityList.RatioToWidthConverter}">
                                                                <Binding Path="BreakRatio" />
                                                                <Binding ElementName="BreakFillHost"
                                                                         Path="ActualWidth" />
                                                            </MultiBinding>
                                                        </Border.Width>
                                                    </Border>
                                                </Grid>
                                            </Border>

                                            <Canvas Panel.ZIndex="1"
                                                    Width="122"
                                                    Height="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    ClipToBounds="False"
                                                    IsHitTestVisible="False">
                                                <TextBlock Canvas.Top="-3"
                                                           Width="122"
                                                           Style="{StaticResource Text.WidgetWindow}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding BreakText}"
                                                           TextAlignment="Center" />
                                            </Canvas>
                                        </Grid>

                                        <!-- 詠唱ゲージ。形と文字はブレイクゲージと同じで、0 から満タンへ満ちていく -->
                                        <Grid Grid.Row="2">
                                            <Grid.Style>
                                                <Style TargetType="{x:Type Grid}">
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Setter Property="Visibility"
                                                            Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsCasting}"
                                                                     Value="True">
                                                            <Setter Property="Visibility"
                                                                    Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <Border Width="122"
                                                    Height="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    Background="#FF000000"
                                                    CornerRadius="5"
                                                    Padding="1">
                                                <Grid x:Name="CastFillHost"
                                                      Height="8"
                                                      VerticalAlignment="Center">
                                                    <Grid.Clip>
                                                        <RectangleGeometry Rect="0,0,120,8"
                                                                           RadiusX="4"
                                                                           RadiusY="4" />
                                                    </Grid.Clip>

                                                    <Border Height="8"
                                                            HorizontalAlignment="Left"
                                                            VerticalAlignment="Center"
                                                            Background="#FFE5BE3B"
                                                            behaviors:BarWidthAnimationBehavior.AreaWidth="{Binding ActualWidth, ElementName=CastFillHost}"
                                                            behaviors:BarWidthAnimationBehavior.FillSeconds="{Binding CastFillSeconds}"
                                                            behaviors:BarWidthAnimationBehavior.Ratio="{Binding CastRatio}"
                                                            behaviors:BarWidthAnimationBehavior.SnapsToTarget="True" />
                                                </Grid>
                                            </Border>

                                            <Canvas Panel.ZIndex="1"
                                                    Width="122"
                                                    Height="10"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Top"
                                                    ClipToBounds="False"
                                                    IsHitTestVisible="False">
                                                <TextBlock Canvas.Top="-3"
                                                           Width="122"
                                                           Style="{StaticResource Text.WidgetWindow}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding CastText}"
                                                           TextAlignment="Center" />
                                            </Canvas>
                                        </Grid>
                                    </Grid>
                                </Grid>

                                <!-- ヘイトの枠。枠は行の部品を使い回しても作り直さないよう、並べる数を決めて1つずつ置く。 -->
                                <StackPanel Grid.Column="2"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <ContentPresenter Content="{Binding HateSlots[0]}"
                                                      ContentTemplate="{StaticResource EntityList.HateSlotTemplate}" />
                                    <ContentPresenter Content="{Binding HateSlots[1]}"
                                                      ContentTemplate="{StaticResource EntityList.HateSlotTemplate}" />
                                    <ContentPresenter Content="{Binding HateSlots[2]}"
                                                      ContentTemplate="{StaticResource EntityList.HateSlotTemplate}" />
                                    <ContentPresenter Content="{Binding HateSlots[3]}"
                                                      ContentTemplate="{StaticResource EntityList.HateSlotTemplate}" />
                                    <ContentPresenter Content="{Binding HateSlots[4]}"
                                                      ContentTemplate="{StaticResource EntityList.HateSlotTemplate}" />
                                    <ContentPresenter Content="{Binding HateSlots[5]}"
                                                      ContentTemplate="{StaticResource EntityList.HateSlotTemplate}" />
                                </StackPanel>

                                <!--
                                    倒すと入る得点。アイコンの中央に重ねる(イマジンの回数と同じ置き方)。
                                    アイコンより広いので、下の分類名と同じく Canvas の幅44の枠に置く。
                                -->
                                <Canvas Grid.Column="0"
                                        Panel.ZIndex="1"
                                        IsHitTestVisible="False">
                                    <Grid Canvas.Left="-5.5"
                                          Width="44"
                                          Height="25">
                                        <TextBlock HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource Text.WidgetWindow}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding ScoreText}"
                                                   TextAlignment="Center" />
                                    </Grid>
                                </Canvas>

                                <!--
                                    分類名テキスト。列0(幅33)より広い 44px で描くため、
                                    行グリッドの最後の子として Canvas で重ねる。

                                    ・Canvas でないと幅が通らない。 Grid は子を測定するとき
                                      セル幅で DesiredSize を頭打ちにするので、Width=44 を指定しても
                                      42.5px 程度に切られ TextTrimming が働いてしまう。
                                      Canvas は子を無限大で測るため指定幅がそのまま通り、
                                      Canvas 自身の DesiredSize は 0 なのでレイアウトへは影響しない
                                    ・最後に置いたうえで Panel.ZIndex も明示する。列0の中に入れると、
                                      後から描かれる列1(HPバー)の下に潜る
                                    ・幅44は英語の最長 "Unknown"(43.32px @ FontSize=10 SemiBold) に合わせてある
                                    ・Canvas.Left の -5.5 はアイコン中心(列0の中心 x=16.5)に
                                      44px の中心を合わせる値。ScrollViewer から移した 5px の余地に収まるので、HPバーには重ならない
                                -->
                                <Canvas Grid.Column="0"
                                        Panel.ZIndex="1"
                                        IsHitTestVisible="False">
                                    <TextBlock Canvas.Left="-5.5"
                                               Canvas.Top="21"
                                               Width="44"
                                               Style="{StaticResource Text.WidgetWindow}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               Text="{Binding ClassificationDisplayName}"
                                               TextAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </Canvas>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
    </Grid>
</UserControl>
