<UserControl x:Class="StarResonanceDps.App.Views.Widgets.MeterWidgetFooterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="10,0,8,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource Text.WidgetWindow}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular"
                       Text="{Binding ElapsedText}" />

            <TextBlock Margin="8,0,0,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.WidgetWindow}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Text="{Binding BenchmarkStatusText}"
                       Visibility="{Binding IsBenchmarkActive, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <Grid Grid.Column="2"
              Margin="8,0,10,0"
              VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="72" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="42" />
                <ColumnDefinition Width="72" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.WidgetWindow}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Text="{Binding PartyMetricLabel}" />

            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.WidgetWindow}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Text="{Binding PartyMetricValueText}"
                       TextAlignment="Right"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Column="3"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.WidgetWindow}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Text="{Binding TotalLabel}" />

            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Style="{StaticResource Text.WidgetWindow}"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Text="{Binding TotalValueText}"
                       TextAlignment="Right"
                       TextTrimming="CharacterEllipsis" />
        </Grid>
    </Grid>
</UserControl>
