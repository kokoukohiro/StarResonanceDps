<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerMetricSummaryWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="PlayerMetricSummaryWidgetView_Loaded"
             SizeChanged="PlayerMetricSummaryWidgetView_SizeChanged"
             DataContextChanged="PlayerMetricSummaryWidgetView_DataContextChanged">
    <UserControl.Resources>
        <!-- 文字は全部同じ大きさと太さ(スキル詳細の行と同じ FontSize 12 / SemiBold)。 -->
        <Style x:Key="MetricSummaryText"
               TargetType="TextBlock"
               BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="MetricSummaryNumber"
               TargetType="TextBlock"
               BasedOn="{StaticResource MetricSummaryText}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!--
            割合の1行。作りはスキル詳細の行と同じ(高さ 31、下敷きのバー、列 5 / 25 / * / Auto、名前と値の余白)。
            バーの長さはまとまりの一番大きい値に対する比。アイコンは白。
            物理・魔法の絵はステータス詳細と同じ 30×30 で、欄(25)の中央に置く(名前の位置は属性の行とそろう)。
            絵の無い無分類は、メーターのクラスアイコンのはてなと同じ絵・大きさ(25×25)。
            名前・値・割合が行に全部出るので、TIPS は付けない。
            押しても何も起きないが、ホバーの背景はほかの行と同じ形で出す(Button の ControlTemplate、アビリティ情報・ステータス詳細の行と同じ)。
        -->
        <Style x:Key="MetricSummaryShareBars" TargetType="ItemsControl">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <Button Height="31"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid SnapsToDevicePixels="True">
                                                    <Border x:Name="InteractionBackground"
                                                            Background="{Binding DataContext.WidgetWindowPalette.WidgetWindowScrollThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            Visibility="Collapsed">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.NonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                                        <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.ActiveNonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>

                            <Grid SnapsToDevicePixels="True"
                                  UseLayoutRounding="True">
                                <Grid x:Name="BarArea"
                                      Margin="1"
                                      ClipToBounds="True">
                                    <Border Height="29"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            Background="{Binding BarBrush}"
                                            behaviors:BarWidthAnimationBehavior.AreaWidth="{Binding ActualWidth, ElementName=BarArea}"
                                            behaviors:BarWidthAnimationBehavior.Ratio="{Binding BarRatio}" />
                                </Grid>

                                <Grid ClipToBounds="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="5" />
                                        <ColumnDefinition Width="25" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Rectangle Grid.Column="1"
                                               Fill="White"
                                               OpacityMask="{Binding IconMask}"
                                               Effect="{StaticResource Effect.ProfessionIconShadow}"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Width" Value="25" />
                                                <Setter Property="Height" Value="25" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UsesPlayerStatusAsset}" Value="True">
                                                        <Setter Property="Width" Value="30" />
                                                        <Setter Property="Height" Value="30" />
                                                        <Setter Property="Margin" Value="-2.5,0" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IconMask}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <Rectangle Grid.Column="1"
                                               Width="25"
                                               Height="25"
                                               Fill="White"
                                               Effect="{StaticResource Effect.ProfessionIconShadow}"
                                               RenderOptions.BitmapScalingMode="HighQuality">
                                        <Rectangle.OpacityMask>
                                            <ImageBrush ImageSource="{StaticResource Icon.Profession.Unknown}" Stretch="Uniform" />
                                        </Rectangle.OpacityMask>
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IconMask}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                    </Rectangle>
                                    <TextBlock Grid.Column="2"
                                               Margin="5,0,6,0"
                                               Style="{StaticResource MetricSummaryText}"
                                               Text="{Binding Name}" />
                                    <TextBlock Grid.Column="3"
                                               Margin="4,0,5,0"
                                               Style="{StaticResource MetricSummaryNumber}"
                                               Text="{Binding ValueText}" />
                                </Grid>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 窓の高さを中身が全部入る高さに合わせる(AutoFitHeightBehavior)。 -->
        <ScrollViewer x:Name="SummaryScrollViewer"
                      Margin="5,5,0,5"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      CanContentScroll="False"
                      behaviors:AutoFitHeightBehavior.IsEnabled="True"
                      ScrollChanged="SummaryScrollViewer_ScrollChanged">
            <!-- 総量が 0 の間は何も出さない(ほかのウィジェットと同じく空。窓は高さ合わせで縮まない)。 -->
            <StackPanel DataContext="{Binding Summary}"
                        Visibility="{Binding HasData, Converter={StaticResource BooleanToVisibilityConverter}}">
                <!--
                    合計・通常・会心・幸運 × 値・率・ヒット数。列の見出しは置かず、値の形(数値・%・ヒット)で列を読ませる。
                    率とヒット数の欄は普段の幅を下限にして、桁が増えたときだけ広がる。
                -->
                <Grid Margin="5,0,5,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="64" />
                        <ColumnDefinition Width="Auto" MinWidth="72" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="22" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="22" />
                        <RowDefinition Height="22" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Grid.Column="0"
                               Style="{StaticResource MetricSummaryText}"
                               Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_SummaryTotal]}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="1"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding TotalRow.ValueText}" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="2"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="100.00%" />
                    <TextBlock Grid.Row="0"
                               Grid.Column="3"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding TotalRow.HitsText}" />

                    <TextBlock Grid.Row="1"
                               Grid.Column="0"
                               Style="{StaticResource MetricSummaryText}"
                               Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_SummaryNormal]}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="1"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding NormalRow.ValueText}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="2"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding NormalRow.RateText}" />
                    <TextBlock Grid.Row="1"
                               Grid.Column="3"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding NormalRow.HitsText}" />

                    <TextBlock Grid.Row="2"
                               Grid.Column="0"
                               Style="{StaticResource MetricSummaryText}"
                               Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_SummaryCrit]}" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="1"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding CritRow.ValueText}" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="2"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding CritRow.RateText}" />
                    <TextBlock Grid.Row="2"
                               Grid.Column="3"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding CritRow.HitsText}" />

                    <TextBlock Grid.Row="3"
                               Grid.Column="0"
                               Style="{StaticResource MetricSummaryText}"
                               Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_SummaryLucky]}" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="1"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding LuckyRow.ValueText}" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="2"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding LuckyRow.RateText}" />
                    <TextBlock Grid.Row="3"
                               Grid.Column="3"
                               Style="{StaticResource MetricSummaryNumber}"
                               Text="{Binding LuckyRow.HitsText}" />
                </Grid>

                <!--
                    割合のバー。見出し(行の高さは表と同じ 22)の下に、値のある種類を総量の大きい順に1行ずつ。
                    バーの色は設定のアイコンカラー。アイコンは、属性は属性アイコン、物理・魔法・無分類は物理攻撃力・魔法攻撃力の絵。
                    左右の余白は無く、見出しの左端はバーの行の左端にそろう。
                -->
                <StackPanel>
                    <Grid Height="22">
                        <TextBlock Style="{StaticResource MetricSummaryText}"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_SummaryElementShare]}" />
                    </Grid>
                    <ItemsControl Style="{StaticResource MetricSummaryShareBars}"
                                  ItemsSource="{Binding ElementShares}" />

                    <Grid Height="22">
                        <TextBlock Style="{StaticResource MetricSummaryText}"
                                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Metric_SummaryModeShare]}" />
                    </Grid>
                    <ItemsControl Style="{StaticResource MetricSummaryShareBars}"
                                  ItemsSource="{Binding ModeShares}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
