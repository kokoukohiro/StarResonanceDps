<UserControl x:Class="StarResonanceDps.App.Views.Widgets.PlayerStatusWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="PlayerStatusWidgetView_Loaded"
             SizeChanged="PlayerStatusWidgetView_SizeChanged"
             DataContextChanged="PlayerStatusWidgetView_DataContextChanged">
    <UserControl.Resources>
        <!-- 行内テキスト。作りはバフ一覧の行と同じ。 -->
        <Style x:Key="StatusList.RowText" TargetType="TextBlock" BasedOn="{StaticResource Text.WidgetWindow}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 値の増減の三角の形。大きさは StatusList.ValueChangeMark の Width / Height。色は行の ValueChangeBrush(テキストカラーの「数値の増加」「数値の減少」)。 -->
        <Geometry x:Key="StatusList.IncreaseMarkGeometry">M 0,1 L 0.5,0 L 1,1 Z</Geometry>
        <Geometry x:Key="StatusList.DecreaseMarkGeometry">M 0,0 L 1,0 L 0.5,1 Z</Geometry>

        <!--
            値。行の右端に右寄せ。色は行のテキストカラーを使わずウィジェットの既定の白で、
            差分で変わってからしばらくだけ増減の色にする(PlayerStatusEntry.ValueChangeHighlightDuration)。
        -->
        <Style x:Key="StatusList.Value" TargetType="TextBlock" BasedOn="{StaticResource StatusList.RowText}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="TextAlignment" Value="Right" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ValueChange}" Value="Increase">
                    <Setter Property="Foreground" Value="{Binding ValueChangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ValueChange}" Value="Decrease">
                    <Setter Property="Foreground" Value="{Binding ValueChangeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 値の左の増減の三角。変化が無いときは畳む(右寄せなので数字の位置は動かない)。影は文字と同じ。 -->
        <Style x:Key="StatusList.ValueChangeMark" TargetType="Path">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stretch" Value="Fill" />
            <Setter Property="Effect" Value="{StaticResource Effect.WidgetWindowTextShadow}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ValueChange}" Value="Increase">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Data" Value="{StaticResource StatusList.IncreaseMarkGeometry}" />
                    <Setter Property="Fill" Value="{Binding ValueChangeBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ValueChange}" Value="Decrease">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Data" Value="{StaticResource StatusList.DecreaseMarkGeometry}" />
                    <Setter Property="Fill" Value="{Binding ValueChangeBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- 余白はバフ一覧・メーターと同じ(左5・右0)。 -->
        <ScrollViewer x:Name="StatusListScrollViewer"
                      Margin="5,5,0,5"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Hidden"
                      CanContentScroll="False"
                      ScrollChanged="StatusListScrollViewer_ScrollChanged">
            <!-- 行を掴んで並べ替える(RowReorderBehavior)。写して薄くするのは行の中身 RowContent だけで、ホバーの背景は写さない。 -->
            <ItemsControl ItemsSource="{Binding PlayerStatus}"
                          behaviors:RowReorderBehavior.ContentElementName="RowContent">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!--
                            行の高さとホバーの作りはバフ一覧の行と同じ。押しても何も起きないが、
                            Button の ControlTemplate でないとホバーの背景を同じ形で出せない。
                            掴んで動かすと並べ替えになる(閾値を超えるまでは何も起きない)。
                        -->
                        <Button Height="25"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Focusable="False"
                                IsTabStop="False"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Grid SnapsToDevicePixels="True">
                                                    <Border x:Name="InteractionBackground"
                                                            Background="{Binding DataContext.WidgetWindowPalette.WidgetWindowScrollThumbBrush, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                                            Visibility="Collapsed">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                                <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.NonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True">
                                                                        <Setter Property="Opacity" Value="{Binding DataContext.WidgetWindowPalette.ActiveNonTextOpacity, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                    </Border>
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                                      Content="{TemplateBinding Content}"
                                                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="InteractionBackground" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>

                            <Grid x:Name="RowContent" VerticalAlignment="Center">
                                <!-- 列の幅はバフ一覧の行と同じ。名前が残りの幅、値は右端。 -->
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- アイコンを持たない行はマスクが null で、欄は空のまま。 -->
                                <Rectangle Grid.Column="0"
                                           Width="30"
                                           Height="30"
                                           HorizontalAlignment="Left"
                                           VerticalAlignment="Center"
                                           Fill="{Binding TextBrush}"
                                           OpacityMask="{Binding IconMask}"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Effect="{StaticResource Effect.ProfessionIconShadow}" />

                                <TextBlock Grid.Column="1"
                                           Margin="6,0,6,0"
                                           Style="{StaticResource StatusList.RowText}"
                                           Foreground="{Binding TextBrush}"
                                           Text="{Binding Name}" />

                                <StackPanel Grid.Column="2"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                    <Path Style="{StaticResource StatusList.ValueChangeMark}" />
                                    <TextBlock Style="{StaticResource StatusList.Value}"
                                               Text="{Binding ValueText}" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
