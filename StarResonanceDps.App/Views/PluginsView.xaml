<UserControl x:Class="StarResonanceDps.App.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:StarResonanceDps.App.Behaviors"
             xmlns:controls="clr-namespace:StarResonanceDps.App.Controls"
             xmlns:localization="clr-namespace:StarResonanceDps.App.Localization"
             xmlns:services="clr-namespace:StarResonanceDps.App.Services"
             xmlns:viewModels="clr-namespace:StarResonanceDps.App.ViewModels"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!-- 行のカード。枠の作りは Panel.ManagerItemCard。下の余白(行の間隔)は集計タブの履歴の行と同じ。押せるのは窓を開く行だけで、その行だけ手の形のカーソルと乗せたときの地の色を出す。窓の無いプラグインは状態に関係なく、いつも乗せたときの地の色にする(情報を読めなかったプラグインは窓があるか分からないので除く)。 -->
        <Style x:Key="Panel.PluginItemCard"
               TargetType="{x:Type ContentControl}"
               BasedOn="{StaticResource Panel.ManagerItemCard}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowState}" Value="{x:Static services:PluginRowState.Openable}">
                    <Setter Property="Cursor" Value="Hand" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding Info.HasWindow}" Value="False" />
                        <Condition Binding="{Binding HasDetails}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.InputHoverBackground}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding RowState}" Value="{x:Static services:PluginRowState.Openable}" />
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource Brush.InputHoverBackground}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- エラーと削除待ちの行は、ゴミ箱以外(アイコン・文字・ピル)を押せないボタンと同じ不透明度にする。窓なしの正常な行は押せないが灰色にしない。 -->
        <Style x:Key="PluginItem.Content" TargetType="{x:Type Grid}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Opacity" Value="0.45" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowState}" Value="{x:Static services:PluginRowState.Openable}">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding RowState}" Value="{x:Static services:PluginRowState.NoWindow}">
                    <Setter Property="Opacity" Value="1" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PluginItem.Subtitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PluginItem.PillText" TargetType="{x:Type TextBlock}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>

        <!-- 「エラー」。理由は TIPS。押しても何も起きない行なので、押しても TIPS を閉じない。更新を待っている行は更新で直るので出さない。 -->
        <Style x:Key="PluginItem.ErrorPill" TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.StatusPill}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="behaviors:ToolTipBehavior.IsEnabled" Value="True" />
            <Setter Property="behaviors:ToolTipBehavior.KeepsOnClick" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowState}" Value="{x:Static services:PluginRowState.Error}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUpdatePending}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PluginItem.PendingUpdatePill" TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.StatusPill}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsUpdatePending}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PluginItem.PendingDeletionPill" TargetType="{x:Type Border}" BasedOn="{StaticResource Panel.StatusPill}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RowState}" Value="{x:Static services:PluginRowState.PendingDeletion}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 見出しと「＋ プラグインを追加」。形は集計タブの見出しの段と同じ。 -->
        <Grid Grid.Row="0" Margin="8,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Plugins_Title]}" />

            <Button Grid.Column="1"
                    Style="{StaticResource Button.AggregationAction}"
                    Command="{Binding AddPluginCommand}">
                <StackPanel Orientation="Horizontal">
                    <Path Width="14"
                          Height="14"
                          Margin="0,0,8,0"
                          Style="{StaticResource Icon.Stroke}"
                          Data="{DynamicResource Icon.Add}" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Plugins_Add]}" />
                </StackPanel>
            </Button>
        </Grid>

        <TextBlock Grid.Row="1"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="16"
                   Foreground="{DynamicResource Brush.TextMuted}"
                   Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[Plugins_Empty]}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PluginItems.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <ScrollViewer x:Name="PluginScrollViewer"
                      Grid.Row="1"
                      Style="{StaticResource ScrollViewer.WidgetList}"
                      VerticalScrollBarVisibility="Hidden">
            <ItemsControl ItemsSource="{Binding PluginItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewModels:PluginListItemViewModel}">
                        <!-- 行の高さ 68 は WidgetListItem と同じ。 -->
                        <Grid Height="68">
                            <ContentControl Style="{StaticResource Panel.PluginItemCard}">
                                <ContentControl.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding OpenCommand}" />
                                </ContentControl.InputBindings>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Style="{StaticResource PluginItem.Content}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Image Grid.Column="0"
                                               Width="44"
                                               Height="44"
                                               Margin="0,0,12,0"
                                               VerticalAlignment="Center"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               Source="{Binding Icon, TargetNullValue={StaticResource Icon.Application}}" />

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <!-- 版は名前のすぐ右で、文字の下端を名前にそろえる。名前が長いときは名前を切り、版を残す。 -->
                                            <controls:PairShrinkPanel HorizontalAlignment="Left">
                                                <TextBlock Style="{StaticResource Text.WidgetName}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding DisplayName}" />
                                                <TextBlock Margin="8,3,0,0"
                                                           VerticalAlignment="Top"
                                                           Style="{StaticResource PluginItem.Subtitle}"
                                                           Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Text="{Binding Info.Version, StringFormat='v{0}'}" />
                                            </controls:PairShrinkPanel>

                                            <!-- 区切りは文字の空白ではなく余白。 -->
                                            <StackPanel Margin="0,2,0,0"
                                                        Orientation="Horizontal"
                                                        Visibility="{Binding HasDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock Margin="0,0,12,0"
                                                           Style="{StaticResource PluginItem.Subtitle}"
                                                           Visibility="{Binding HasCategory, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Text="{Binding CategoryText}" />
                                                <TextBlock Margin="0,0,12,0"
                                                           Style="{StaticResource PluginItem.Subtitle}"
                                                           Visibility="{Binding Info.HasWidgets, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Text="{Binding WidgetExtensionText}" />
                                                <TextBlock Margin="0,0,12,0"
                                                           Style="{StaticResource PluginItem.Subtitle}"
                                                           Visibility="{Binding Info.HasNotifications, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                           Text="{Binding NotificationExtensionText}" />
                                                <TextBlock Style="{StaticResource PluginItem.Subtitle}"
                                                           Text="{Binding AuthorText}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <Border Grid.Column="2" Style="{StaticResource PluginItem.ErrorPill}">
                                            <Border.ToolTip>
                                                <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                                         Style="{StaticResource ToolTip.Info}"
                                                         Content="{Binding StatusToolTip}" />
                                            </Border.ToolTip>
                                            <TextBlock Style="{StaticResource PluginItem.PillText}"
                                                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PluginStatus_Error]}" />
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource PluginItem.PendingDeletionPill}">
                                            <TextBlock Style="{StaticResource PluginItem.PillText}"
                                                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PluginStatus_PendingDeletion]}" />
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource PluginItem.PendingUpdatePill}">
                                            <TextBlock Style="{StaticResource PluginItem.PillText}"
                                                       Text="{Binding Source={x:Static localization:LocalizationManager.Instance}, Path=[PluginStatus_PendingUpdate]}" />
                                        </Border>
                                    </Grid>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource Button.Icon}"
                                            Command="{Binding UninstallCommand}">
                                        <Path Style="{StaticResource Icon.Stroke}"
                                              Data="{DynamicResource Icon.Delete}" />
                                    </Button>
                                </Grid>
                            </ContentControl>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
