<UserControl x:Class="StarResonanceDps.App.Views.PluginsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:viewModels="clr-namespace:StarResonanceDps.App.ViewModels"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <!-- Plugin-only interaction state. The base card structure remains Panel.ManagerItemCard. -->
        <Style x:Key="Panel.PluginItemCard"
               TargetType="{x:Type ContentControl}"
               BasedOn="{StaticResource Panel.ManagerItemCard}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background"
                            Value="{DynamicResource Brush.InputHoverBackground}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsAddItem}" Value="True">
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Margin="24,20,24,20"
          VerticalAlignment="Top">
        <ItemsControl ItemsSource="{Binding PluginItems}"
                      Margin="-6,0,-6,0"
                      VerticalAlignment="Top">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <primitives:UniformGrid Columns="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type viewModels:PluginListItemViewModel}">
                    <!-- Height 68 and the card's 10px bottom margin match WidgetListItem. -->
                    <Grid Height="68"
                          Margin="6,0,6,0">
                        <ContentControl Style="{StaticResource Panel.PluginItemCard}">
                            <ContentControl.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding OpenCommand}" />
                            </ContentControl.InputBindings>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock"
                                               BasedOn="{StaticResource Text.WidgetName}">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddItem}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Path Grid.Column="2"
                                      Margin="12,0,4,0"
                                      Width="14"
                                      Height="14"
                                      Data="{DynamicResource Icon.ChevronRight}">
                                    <Path.Style>
                                        <Style TargetType="Path"
                                               BasedOn="{StaticResource Icon.Stroke}">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddItem}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>

                                <!-- The add item uses the existing vector icon, not a text '+'. -->
                                <Path Grid.ColumnSpan="2"
                                      Width="16"
                                      Height="16"
                                      Data="{DynamicResource Icon.Add}">
                                    <Path.Style>
                                        <Style TargetType="Path"
                                               BasedOn="{StaticResource Icon.Stroke}">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAddItem}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </ContentControl>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
