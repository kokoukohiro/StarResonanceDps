  <Target Name="RemoveObsoleteLocalizationSatelliteOutputs" AfterTargets="Build">
    <ItemGroup>
      <_LegacyLocalizationSatelliteAssemblies Include="$(OutDir)ja-JP\$(AssemblyName).resources.dll;$(OutDir)ko-KR\$(AssemblyName).resources.dll;$(OutDir)zh-CN\$(AssemblyName).resources.dll" />
      <_OtherJapaneseCultureFiles Include="$(OutDir)ja-JP\*.*" Exclude="$(OutDir)ja-JP\$(AssemblyName).resources.dll" />
      <_OtherKoreanCultureFiles Include="$(OutDir)ko-KR\*.*" Exclude="$(OutDir)ko-KR\$(AssemblyName).resources.dll" />
      <_OtherChineseCultureFiles Include="$(OutDir)zh-CN\*.*" Exclude="$(OutDir)zh-CN\$(AssemblyName).resources.dll" />
    </ItemGroup>

    <Delete Files="@(_LegacyLocalizationSatelliteAssemblies)" />
    <RemoveDir Directories="$(OutDir)ja-JP" Condition="'@(_OtherJapaneseCultureFiles)' == ''" />
    <RemoveDir Directories="$(OutDir)ko-KR" Condition="'@(_OtherKoreanCultureFiles)' == ''" />
    <RemoveDir Directories="$(OutDir)zh-CN" Condition="'@(_OtherChineseCultureFiles)' == ''" />
  </Target>

  <PropertyGroup>
    <BundledPluginOutputSubdirectory>$(TargetFramework)</BundledPluginOutputSubdirectory>
    <BundledPluginOutputSubdirectory Condition="'$(RuntimeIdentifier)' != ''">$(TargetFramework)\$(RuntimeIdentifier)</BundledPluginOutputSubdirectory>
    <KeybindPluginAssembly>$(MSBuildProjectDirectory)\..\StarResonanceDps.Plugins.KeybindTool\bin\$(Configuration)\$(BundledPluginOutputSubdirectory)\KeybindTool.dll</KeybindPluginAssembly>
    <ModulePluginAssembly>$(MSBuildProjectDirectory)\..\StarResonanceDps.Plugins.ModuleTool\bin\$(Configuration)\$(BundledPluginOutputSubdirectory)\ModuleTool.dll</ModulePluginAssembly>
  </PropertyGroup>

  <Target Name="CopyBundledPluginAssemblies" AfterTargets="Build">
    <RemoveDir Directories="$(OutDir)Plugins\KeybindTool;$(OutDir)Plugins\ModuleTool" />
    <Delete Files="$(OutDir)Plugins\plugin.json;$(OutDir)Plugins\KeybindTool.deps.json;$(OutDir)Plugins\ModuleTool.deps.json;$(OutDir)Plugins\KeybindTool.runtimeconfig.json;$(OutDir)Plugins\ModuleTool.runtimeconfig.json" />

    <MakeDir Directories="$(OutDir)Plugins" />
    <Copy SourceFiles="$(KeybindPluginAssembly)" DestinationFiles="$(OutDir)Plugins\KeybindTool.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ModulePluginAssembly)" DestinationFiles="$(OutDir)Plugins\ModuleTool.dll" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyBundledPluginAssembliesToPublish" AfterTargets="Publish">
    <RemoveDir Directories="$(PublishDir)Plugins\KeybindTool;$(PublishDir)Plugins\ModuleTool" />
    <Delete Files="$(PublishDir)Plugins\plugin.json;$(PublishDir)Plugins\KeybindTool.deps.json;$(PublishDir)Plugins\ModuleTool.deps.json;$(PublishDir)Plugins\KeybindTool.runtimeconfig.json;$(PublishDir)Plugins\ModuleTool.runtimeconfig.json" />

    <MakeDir Directories="$(PublishDir)Plugins" />
    <Copy SourceFiles="$(KeybindPluginAssembly)" DestinationFiles="$(PublishDir)Plugins\KeybindTool.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ModulePluginAssembly)" DestinationFiles="$(PublishDir)Plugins\ModuleTool.dll" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <None Include="..\StarResonanceDps.Core\Data\**\*.json">
      <Link>Data\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

