  <!-- Remove stale satellite outputs from builds made before localized ResX resources were embedded. -->
  <Target Name="RemoveObsoleteLocalizationSatelliteOutputs" AfterTargets="Build">
    <ItemGroup>
      <_LegacyLocalizationSatelliteAssemblies Include="$(OutDir)ja-JP\$(AssemblyName).resources.dll;$(OutDir)ko-KR\$(AssemblyName).resources.dll;$(OutDir)zh-CN\$(AssemblyName).resources.dll" />
      <_OtherJapaneseCultureFiles Include="$(OutDir)ja-JP\*.*" Exclude="$(OutDir)ja-JP\$(AssemblyName).resources.dll" />
      <_OtherKoreanCultureFiles Include="$(OutDir)ko-KR\*.*" Exclude="$(OutDir)ko-KR\$(AssemblyName).resources.dll" />
      <_OtherChineseCultureFiles Include="$(OutDir)zh-CN\*.*" Exclude="$(OutDir)zh-CN\$(AssemblyName).resources.dll" />
    </ItemGroup>

    <Delete Files="@(_LegacyLocalizationSatelliteAssemblies)" />
    <RemoveDir Directories="$(OutDir)ja-JP" Condition="'@(_OtherJapaneseCultureFiles)' == ''" />
    <RemoveDir Directories="$(OutDir)ko-KR" Condition="'@(_OtherKoreanCultureFiles)' == ''" />
    <RemoveDir Directories="$(OutDir)zh-CN" Condition="'@(_OtherChineseCultureFiles)' == ''" />
  </Target>
  <!--
    Bundled plugins follow the same direct-DLL layout as external plugins.
    Plugin metadata is embedded in each DLL, so plugin.json and per-plugin
    package directories are not part of the runtime format.
  -->
  <Target Name="CopyBundledPluginAssemblies" AfterTargets="Build">
    <PropertyGroup>
      <KeybindPluginAssembly>$(MSBuildProjectDirectory)\..\StarResonanceDps.Plugins.KeybindTool\bin\$(Configuration)\$(TargetFramework)\KeybindTool.dll</KeybindPluginAssembly>
      <ModulePluginAssembly>$(MSBuildProjectDirectory)\..\StarResonanceDps.Plugins.ModuleTool\bin\$(Configuration)\$(TargetFramework)\ModuleTool.dll</ModulePluginAssembly>
    </PropertyGroup>

    <!-- Remove output from the previous package/manifest-based layout. -->
    <RemoveDir Directories="$(OutDir)Plugins\KeybindTool;$(OutDir)Plugins\ModuleTool" />
    <Delete Files="$(OutDir)Plugins\plugin.json;$(OutDir)Plugins\KeybindTool.deps.json;$(OutDir)Plugins\ModuleTool.deps.json;$(OutDir)Plugins\KeybindTool.runtimeconfig.json;$(OutDir)Plugins\ModuleTool.runtimeconfig.json" />

    <MakeDir Directories="$(OutDir)Plugins" />
    <Copy SourceFiles="$(KeybindPluginAssembly)" DestinationFiles="$(OutDir)Plugins\KeybindTool.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(ModulePluginAssembly)" DestinationFiles="$(OutDir)Plugins\ModuleTool.dll" SkipUnchangedFiles="true" />
  </Target>


