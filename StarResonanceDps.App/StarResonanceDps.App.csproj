    <EmbeddedResource Update="Properties\Resources.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>StarResonanceDps.App.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.ja-JP.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>StarResonanceDps.App.Properties.Resources.ja-JP.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.ko-KR.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>StarResonanceDps.App.Properties.Resources.ko-KR.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-CN.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>StarResonanceDps.App.Properties.Resources.zh-CN.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

