<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 公開の型とメンバーの説明(英語)を XML にしてパッケージに入れる。説明の無い公開の宣言はビルドの警告になる。 -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- パッケージの版は、大きな番号が PluginSdkVersion.Current、足すだけの変更は中の番号。 -->
  <PropertyGroup>
    <PackageId>StarResonanceDps.PluginSdk</PackageId>
    <Version>0.1.0</Version>
    <Authors>kokoukohiro</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>SDK for StarResonanceDps plugins: the plugin interfaces and attributes, and an analyzer that checks the plugin attributes and definitions at build time.</Description>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddPluginSdkAnalyzerToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="StarResonanceDps" />
  </ItemGroup>

  <!-- 解析器はパッケージに入れるだけで、SDK 自身のビルドには使わない。 -->
  <ItemGroup>
    <ProjectReference Include="..\StarResonanceDps.PluginSdk.Analyzers\StarResonanceDps.PluginSdk.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\StarResonanceDps.PluginSdk.props" Pack="true" PackagePath="build" />
  </ItemGroup>

  <Target Name="AddPluginSdkAnalyzerToPackage">
    <!-- SDK のターゲットフレームワークを解析器(netstandard2.0)へ渡さない。 -->
    <MSBuild Projects="..\StarResonanceDps.PluginSdk.Analyzers\StarResonanceDps.PluginSdk.Analyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework">
      <Output TaskParameter="TargetOutputs" ItemName="PluginSdkAnalyzerAssembly" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(PluginSdkAnalyzerAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>
</Project>
