<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarResonanceDps.App\StarResonanceDps.App.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <!--
    デバッグ用の道具。App はこのプロジェクトを参照せず(参照が輪になる)、Debug ビルドのときだけ実行フォルダの dll を読み込む。
    そのため Debug の構成のときだけ、App の実行フォルダへ自分の dll を写す。
  -->
  <PropertyGroup>
    <AppOutputDirectory>$(MSBuildProjectDirectory)\..\StarResonanceDps.App\bin\$(Configuration)\$(TargetFramework)\</AppOutputDirectory>
  </PropertyGroup>

  <Target Name="CopyToAppOutput" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(AppOutputDirectory)" SkipUnchangedFiles="true" />
  </Target>

</Project>
