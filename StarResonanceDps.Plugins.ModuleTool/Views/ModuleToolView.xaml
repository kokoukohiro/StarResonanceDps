<UserControl x:Class="StarResonanceDps.Plugins.ModuleTool.Views.ModuleToolView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <SolidColorBrush x:Key="Module.IncreaseBrush" Color="#43D978" />
        <SolidColorBrush x:Key="Module.DecreaseBrush" Color="#FF5A5A" />
        <SolidColorBrush x:Key="Module.Level5Brush" Color="#8FB8FF" />
        <SolidColorBrush x:Key="Module.Level6Brush" Color="#FFCC4D" />
        <SolidColorBrush x:Key="Module.EquippedBadgeBrush" Color="#B3000000" />
        <SolidColorBrush x:Key="Module.EquippedBadgeTextBrush" Color="#FFFFFF" />

        <Style x:Key="Module.SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Module.Text" TargetType="{x:Type TextBlock}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Module.QualityToggle" TargetType="{x:Type ToggleButton}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Background" Value="{DynamicResource Brush.InputBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.BorderSoft}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <ContentControl x:Name="Root"
                                        Style="{StaticResource Surface.RoundedButtonOutline}"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </ContentControl>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputHoverBackground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.InputHoverBackground}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Module.RemoveButton" TargetType="{x:Type Button}">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border Background="{TemplateBinding Background}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       Text="✕" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 効果の選択リストの1行(絵と名前)。 -->
        <DataTemplate x:Key="Module.EffectOption">
            <StackPanel Orientation="Horizontal">
                <Image Width="20"
                       Height="20"
                       Margin="0,0,6,0"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding Icon}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>

        <!-- 結果のカードの効果1つ。段階5・6 は色を変える。 -->
        <DataTemplate x:Key="Module.EffectChip">
            <Border x:Name="ChipRoot"
                    Height="22"
                    Margin="0,0,6,4"
                    Padding="2,0,7,0"
                    CornerRadius="11"
                    Background="{DynamicResource Brush.PanelBackground}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Image Width="18"
                           Height="18"
                           Margin="0,0,4,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Icon}" />
                    <TextBlock Margin="0,0,4,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               FontSize="12"
                               Text="{Binding Name}" />
                    <TextBlock Margin="0,0,4,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextPrimary}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding Links}" />
                    <TextBlock x:Name="LevelText"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextMuted}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Text="{Binding LevelText}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="5">
                    <Setter TargetName="LevelText" Property="Foreground" Value="{StaticResource Module.Level5Brush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="6">
                    <Setter TargetName="LevelText" Property="Foreground" Value="{StaticResource Module.Level6Brush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- 結果のカードのモジュール1つ。品質の背景にモジュールの絵、右に効果ごとの絵とリンク数。装着中は印を付ける。TIPS はモジュール名と効果ごとのリンク数。 -->
        <DataTemplate x:Key="Module.Tile">
            <Border Width="105"
                    Margin="3,0,3,0"
                    Padding="6,4,4,4"
                    Style="{StaticResource ToolTipOwner.KeepsOnClick}"
                    CornerRadius="5"
                    Background="{DynamicResource Brush.InputBackground}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}"
                    BorderThickness="1">
                <Border.ToolTip>
                    <ToolTip DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                             Style="{StaticResource ToolTip.Info}">
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" />
                            <ItemsControl ItemsSource="{Binding Parts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding TipText}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ToolTip>
                </Border.ToolTip>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="50"
                          Height="50"
                          VerticalAlignment="Center">
                        <Image RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding QualityImage}"
                               Stretch="UniformToFill" />
                        <Image RenderOptions.BitmapScalingMode="HighQuality"
                               Source="{Binding ModuleImage}" />
                        <Border VerticalAlignment="Bottom"
                                Padding="0,0,0,1"
                                Background="{StaticResource Module.EquippedBadgeBrush}"
                                Visibility="{Binding IsEquipped, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{StaticResource Module.EquippedBadgeTextBrush}"
                                       FontSize="9"
                                       Text="{Binding DataContext.Texts[Module.Tile.Equipped], RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
                        </Border>
                    </Grid>

                    <ItemsControl Grid.Column="1"
                                  Margin="5,0,0,0"
                                  VerticalAlignment="Center"
                                  ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,1">
                                    <Image Width="16"
                                           Height="16"
                                           Margin="0,0,2,0"
                                           VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Source="{Binding Icon}" />
                                    <TextBlock VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding LinksText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 結果のカード1枚。装着中の組は地と枠を変える。 -->
        <DataTemplate x:Key="Module.ResultCard">
            <Border x:Name="CardRoot"
                    Margin="0,0,0,8"
                    Padding="10,8,10,10"
                    CornerRadius="6"
                    Background="{DynamicResource Brush.WindowSurface}"
                    BorderBrush="{DynamicResource Brush.BorderSoft}"
                    BorderThickness="1">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TitleText"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Text="{Binding Title}" />
                        <TextBlock Grid.Column="1"
                                   Margin="17,0,6,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="12"
                                   Text="{Binding FightValueLabel}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextPrimary}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="{Binding FightValueText}" />
                        <TextBlock x:Name="DeltaText"
                                   Grid.Column="3"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="{Binding DeltaText}"
                                   Visibility="{Binding HasDelta, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Grid.Column="4"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="12"
                                   Text="{Binding LinkTotalText}" />
                    </Grid>

                    <ItemsControl Margin="0,0,0,4"
                                  ItemsSource="{Binding Chips}"
                                  ItemTemplate="{StaticResource Module.EffectChip}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <ItemsControl Margin="-3,0,-3,0"
                                  ItemsSource="{Binding Tiles}"
                                  ItemTemplate="{StaticResource Module.Tile}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEquippedCard}" Value="True">
                    <Setter TargetName="CardRoot" Property="Background" Value="{DynamicResource Brush.InputHoverBackground}" />
                    <Setter TargetName="CardRoot" Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIncrease}" Value="True">
                    <Setter TargetName="DeltaText" Property="Foreground" Value="{StaticResource Module.IncreaseBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDecrease}" Value="True">
                    <Setter TargetName="DeltaText" Property="Foreground" Value="{StaticResource Module.DecreaseBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <!-- スクロールバーは左右 5 の間。出ていないときは、バーの列の最小の幅(左右のあいだ 12、窓の端 8)が間隔になる。 -->
    <Grid Margin="8,1,0,8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左: 所持モジュール・条件・品質と、検索とリセットのボタン -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="12" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="ConditionsScrollViewer"
                              Style="{StaticResource ScrollViewer.WidgetList}"
                              VerticalScrollBarVisibility="Hidden">
                    <StackPanel>
                        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,10">
                            <StackPanel Margin="14,10,14,10">
                                <TextBlock Style="{StaticResource Module.SectionTitle}"
                                           Margin="0,0,0,6"
                                           Text="{Binding Texts[Module.Section.Inventory]}" />
                                <StackPanel Visibility="{Binding IsInventoryLoaded, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Style="{StaticResource Module.Text}" Text="{Binding InventorySummaryText}" />
                                    <TextBlock Style="{StaticResource Module.Text}"
                                               Text="{Binding EquippedFightText}"
                                               Visibility="{Binding HasEquippedFight, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Style="{StaticResource Module.Text}"
                                               Foreground="{DynamicResource Brush.TextMuted}"
                                               Text="{Binding ReceivedAtText}"
                                               Visibility="{Binding HasReceivedAt, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Style="{StaticResource Module.Text}"
                                               Margin="0,4,0,0"
                                               Text="{Binding MissingLinksText}"
                                               Visibility="{Binding HasMissingLinks, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    <TextBlock Style="{StaticResource Module.Text}"
                                               Margin="0,4,0,0"
                                               Text="{Binding UnknownModulesText}"
                                               Visibility="{Binding HasUnknownModules, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                                <StackPanel>
                                    <StackPanel.Style>
                                        <Style TargetType="{x:Type StackPanel}">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInventoryLoaded}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <TextBlock Style="{StaticResource Module.Text}"
                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                               FontWeight="SemiBold"
                                               Text="{Binding Texts[Module.Inventory.NotLoaded]}" />
                                    <TextBlock Style="{StaticResource Module.Text}"
                                               Margin="0,2,0,0"
                                               Text="{Binding Texts[Module.Inventory.NotLoadedDetail]}" />
                                </StackPanel>
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource Panel.SettingSection}" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Module.SectionTitle}"
                                           Margin="14,10,14,8"
                                           Text="{Binding Texts[Module.Section.Conditions]}" />

                                <ItemsControl ItemsSource="{Binding PriorityEffects}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="40" Padding="10,0,6,0">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Image Width="22"
                                                           Height="22"
                                                           Margin="0,0,6,0"
                                                           VerticalAlignment="Center"
                                                           RenderOptions.BitmapScalingMode="HighQuality"
                                                           Source="{Binding Icon}" />
                                                    <TextBlock Grid.Column="1"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Brush.TextPrimary}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <ComboBox Grid.Column="2"
                                                              Width="104"
                                                              Margin="6,0,2,0"
                                                              Style="{StaticResource Input.SettingsComboBox}"
                                                              ItemsSource="{Binding LevelOptions}"
                                                              SelectedItem="{Binding SelectedLevel, Mode=TwoWay}" />
                                                    <Button Grid.Column="3"
                                                            Style="{StaticResource Module.RemoveButton}"
                                                            Command="{Binding RemoveCommand}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Padding="10,6,10,10"
                                        Visibility="{Binding CanAddEffect, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <ComboBox x:Name="AddEffectComboBox"
                                                  Width="Auto"
                                                  HorizontalAlignment="Stretch"
                                                  Style="{StaticResource Input.SettingsComboBox}"
                                                  ItemsSource="{Binding AddEffectOptions}"
                                                  ItemTemplate="{StaticResource Module.EffectOption}"
                                                  SelectionChanged="AddEffectComboBox_SelectionChanged" />
                                        <TextBlock Margin="13,0,0,0"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Texts[Module.Button.AddEffect]}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ContentControl>

                        <ContentControl Style="{StaticResource Panel.SettingSection}">
                            <StackPanel Margin="14,10,14,12">
                                <TextBlock Style="{StaticResource Module.SectionTitle}"
                                           Margin="0,0,0,8"
                                           Text="{Binding Texts[Module.Section.Quality]}" />
                                <ItemsControl Margin="-3,0,-3,0"
                                              ItemsSource="{Binding QualityToggles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Margin="3,0,3,0"
                                                          Style="{StaticResource Module.QualityToggle}"
                                                          Content="{Binding Label}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ContentControl>
                    </StackPanel>
                </ScrollViewer>

                <ScrollBar x:Name="ConditionsScrollBar"
                           Grid.Column="1"
                           Margin="5,0,5,0"
                           Orientation="Vertical"
                           Style="{StaticResource ScrollBar.WidgetList}"
                           Visibility="Collapsed" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 検索中は「キャンセル」の文字だけにして、検索のアイコンを消す。 -->
                <Button Grid.Column="0"
                        Width="Auto"
                        Height="36"
                        Margin="0,0,4,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource Button.Text}"
                        Command="{Binding SearchCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Border Margin="0,0,12,0">
                            <Border.Style>
                                <Style TargetType="{x:Type Border}">
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSearching}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Path Style="{DynamicResource Icon.Stroke}"
                                  Data="{DynamicResource Icon.Search}" />
                        </Border>
                        <TextBlock VerticalAlignment="Center" Text="{Binding SearchButtonText}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="1"
                        Width="Auto"
                        Height="36"
                        Margin="4,0,0,0"
                        HorizontalAlignment="Stretch"
                        Style="{StaticResource Button.Text}"
                        Command="{Binding ResetCommand}"
                        Content="{Binding Texts[Module.Button.Reset]}" />
            </Grid>
        </Grid>

        <!-- 右: 結果 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Module.SectionTitle}"
                           VerticalAlignment="Center"
                           Text="{Binding ResultsTitleText}" />
                <TextBlock Grid.Column="1"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           FontSize="12"
                           Text="{Binding ResultsSummaryText}"
                           TextTrimming="CharacterEllipsis" />
            </Grid>

            <TextBlock Grid.Row="1"
                       Margin="0,0,0,8"
                       Foreground="{DynamicResource Brush.TextPrimary}"
                       FontSize="12"
                       Text="{Binding SearchConditionsText}"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasSearchConditionsText, Converter={StaticResource BooleanToVisibilityConverter}}" />

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="8" />
                </Grid.ColumnDefinitions>

                <ScrollViewer x:Name="ResultsScrollViewer"
                              Style="{StaticResource ScrollViewer.WidgetList}"
                              VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource Module.ResultCard}" />
                </ScrollViewer>

                <ScrollBar x:Name="ResultsScrollBar"
                           Grid.Column="1"
                           Margin="5,0,5,0"
                           Orientation="Vertical"
                           Style="{StaticResource ScrollBar.WidgetList}"
                           Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
