<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ModuleTool</AssemblyName>
    <RootNamespace>StarResonanceDps.Plugins.ModuleTool</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- Keep every locale, table and image inside the plugin DLL so plugins remain self-contained under runtime\Plugins. -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>StarResonanceDps.Plugins.ModuleTool.Properties.Resources.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.ja-JP.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>StarResonanceDps.Plugins.ModuleTool.Properties.Resources.ja-JP.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.ko-KR.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>StarResonanceDps.Plugins.ModuleTool.Properties.Resources.ko-KR.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.zh-CN.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>StarResonanceDps.Plugins.ModuleTool.Properties.Resources.zh-CN.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Generated by DataTools/ModuleTool/gen_modules.py. -->
  <ItemGroup>
    <EmbeddedResource Include="Data\ModuleTables.json">
      <LogicalName>StarResonanceDps.Plugins.ModuleTool.Data.ModuleTables.json</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Data\ModuleNames.json">
      <LogicalName>StarResonanceDps.Plugins.ModuleTool.Data.ModuleNames.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StarResonanceDps.PluginSdk\StarResonanceDps.PluginSdk.csproj">
      <Private>false</Private>
    </ProjectReference>
    <!-- SDK のパッケージと同じ、プラグインの属性の検査。 -->
    <ProjectReference Include="..\StarResonanceDps.PluginSdk.Analyzers\StarResonanceDps.PluginSdk.Analyzers.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\*.png" Exclude="Assets\icon.png" />
    <Resource Include="Assets\icon.ico" />
  </ItemGroup>
</Project>
